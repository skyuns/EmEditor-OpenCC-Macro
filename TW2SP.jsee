            // 第 1.5 階段：HMM 處理連續單字
            let ptr = 0;
            while (ptr < textLen) {
                let nextPtr = routeNext[ptr];
                let wLen = nextPtr - ptr;
                let code = srcText.charCodeAt(ptr);

                if (wLen === 1 && code >= 0x4E00 && code <= 0x9FFF) {
                    let startPtr = ptr;
                    let endPtr = nextPtr;
                    while (endPtr < textLen) {
                        let nxt = routeNext[endPtr];
                        let c = srcText.charCodeAt(endPtr);
                        if (nxt - endPtr === 1 && c >= 0x4E00 && c <= 0x9FFF) {
