                            // 再次向後掃描
                            let sk = stabIdx + 1;
                            while (sk < textLen && (sk - stabIdx) <= 8) {
                                let stabSub = srcText.substring(stabIdx, sk + 1);
                                if (VisionVocabs.has(stabSub)) {
