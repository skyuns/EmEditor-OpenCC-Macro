        const viterbi = (obs) => {
            if (!isHmmLoaded || !obs || obs.length === 0) return [obs.length];
            let obsLen = obs.length;

            let firstCode = obs.charCodeAt(0);
            for (let y = 0; y < 4; y++) {
                vitVBuf[y] = hmmStart[y] + hmmEmit[y][firstCode];
            }

            for (let t = 1; t < obsLen; t++) {
                let charCode = obs.charCodeAt(t);
                for (let y = 0; y < 4; y++) {
                    let max_prob = -Infinity;
                    let best_prev_state = 0;
                    let emitP = hmmEmit[y][charCode];
                    for (let y0 = 0; y0 < 4; y0++) {
                        // 轉移矩陣查表
                        let prob = vitVBuf[(t - 1) * 4 + y0] + hmmTrans[y0 * 4 + y] + emitP;
                        if (prob > max_prob) {
                            max_prob = prob;
                            best_prev_state = y0;
                        }
                    }
                    vitVBuf[t * 4 + y] = max_prob;
                    vitBpBuf[t * 4 + y] = best_prev_state;
                }
            }

            let lastState = 3; // 預設為 'S' (內部 3)
            if (vitVBuf[(obsLen - 1) * 4 + 2] >= vitVBuf[(obsLen - 1) * 4 + 3]) {
                lastState = 2; // 改為 'E' (內部 2)
            }
            vitSpBuf[obsLen - 1] = lastState;

            for (let t = obsLen - 2; t >= 0; t--) {
                vitSpBuf[t] = vitBpBuf[(t + 1) * 4 + vitSpBuf[t + 1]];
            }

            let result = [];
            let begin = 0;
            for (let k = 0; k < obsLen; k++) {
                let s = vitSpBuf[k];
                if (s === 2 || s === 3) {
                    result.push(k - begin + 1);
                    begin = k + 1;
                }
            }
            if (begin < obsLen) result.push(obsLen - begin);
            return result;
        };

        if (isJiebaActive) {
            // 第 1 階段：Jieba DAG + DP 路由計算
            const routeScore = new Float64Array(textLen + 1);
            const routeNext = new Int32Array(textLen + 1);
            
            routeScore[textLen] = 0;
            routeNext[textLen] = textLen;

            for (let idx = textLen - 1; idx >= 0; idx--) {
                let firstCode = srcText.charCodeAt(idx);
                if (firstCode < fastSkipLimit) {
                    let nxt = idx + 1;
                    let nxtScore = routeScore[nxt];
                    routeScore[idx] = nxtScore;
                    routeNext[idx] = nxt;
