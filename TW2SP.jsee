黃宏	黃宏
點選	點擊
點陣圖	位圖
`;

// --- [區塊 B：自訂擴充覆寫詞庫] ---
const rawPhraseExpandedData = `
`;

// --- ## Google 翻譯與巨集比對引擎 ---
async function compareWithGoogle(origText, macroText, modeNames) {
    shell.KeepRunning = true;

    const langId = editor.LangID;
    const _L = (en, tc, sc) => {
        if (langId === 1028) return tc;
        if (langId === 2052) return sc;
        return en;
    };

    let lblSimMode = _L("✨ Simulation Comparison Mode ✨", "✨ 模擬比對模式 ✨", "✨ 模拟比对模式 ✨");
    let apiErrorMsg = _L("❌ Temporarily unable to connect", "❌ 暫時無法連線", "❌ 暂时无法连线");

    // 第一次按 Ctrl 且網頁未開啟時：初始化 WebBar
    if (!WebBar.Visible) {
        let waitDesc = _L("Please run the macro again to display the results.", "請再次執行巨集以顯示比對結果。", "请再次执行宏以显示对比结果。");

        var waitHtml = `<!DOCTYPE html><html><body style='font-family:Segoe UI, sans-serif; display:flex; justify-content:center; align-items:center; height:100vh; background:#f4f4f4; margin:0;'><div style='text-align:center; padding:30px; background:#fff; border-radius:10px; box-shadow:0 4px 15px rgba(0,0,0,0.1);'><h2 style='color:#0275d8; margin-top:0;'>${lblSimMode}</h2><p style='color:#555; font-size:16px; margin-bottom:0;'>${waitDesc}</p></div></body></html>`;
        var dataUrl = "data:text/html;charset=utf-8," + encodeURIComponent(waitHtml);

        WebBar.Open(dataUrl);
        shell.KeepRunning = false;
        return;
    }

    try {
        if (origText.length > 200) {
            let limitMsg = _L(
                "⚠️ Selection exceeds 200 characters limit (" + origText.length + " chars). Google translation comparison skipped.\n",
                "⚠️ 選取字數為 " + origText.length + " 字，超過 200 字上限，已跳過 Google 翻譯比對。\n",
                "⚠️ 选取字数为 " + origText.length + " 字，超过 200 字上限，已跳过 Google 翻译对比。\n"
            );
            openInWebBar(limitMsg);
            return;
        }

        let targetLang = (CURRENT_MODE === "T2S" || CURRENT_MODE === "TW2SP") ? "zh-CN" : "zh-TW";
        let sourceLang = (CURRENT_MODE === "T2S" || CURRENT_MODE === "TW2SP") ? "zh-TW" : "zh-CN";

        function computeDiff(oldStr, newStr) {
            var oldChars = Array.from(oldStr), newChars = Array.from(newStr);
            var m = oldChars.length, n = newChars.length;
            var dp = Array(m + 1).fill(null).map(function() { return Array(n + 1).fill(0); });

            for (var i = 1; i <= m; i++) {
                for (var j = 1; j <= n; j++) {
                    if (oldChars[i - 1] === newChars[j - 1]) dp[i][j] = dp[i - 1][j - 1] + 1;
                    else dp[i][j] = Math.max(dp[i - 1][j], dp[i][j - 1]);
                }
            }

            var ops = [], x = m, y = n;
            while (x > 0 || y > 0) {
                if (x > 0 && y > 0 && oldChars[x - 1] === newChars[y - 1]) {
                    ops.push({ type: 'equal', text: oldChars[x - 1] }); x--; y--;
                } else if (y > 0 && (x === 0 || dp[x][y - 1] >= dp[x - 1][y])) {
                    ops.push({ type: 'insert', text: newChars[y - 1] }); y--;
                } else {
                    ops.push({ type: 'delete', text: oldChars[x - 1] }); x--;
                }
            }
            return ops.reverse();
        }

        function trimEveryLine(text) {
            var lines = text.split('\n');
            for (var i = 0; i < lines.length; i++) {
                lines[i] = lines[i].replace(/^[ \t\u3000]+|[ \t\u3000]+$/g, '');
            }
            return lines.join('\n');
        }

        function escapeHTML(str) {
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        let googleText = "";
        let isGoogleAvailable = false;

        const _f = "f" + "e" + "t" + "c" + "h"; 

        try {
            if (typeof eval(`typeof ${_f}`) !== "undefined") {
                const url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=${sourceLang}&tl=${targetLang}&dt=t&q=${encodeURIComponent(origText)}`;
                const response = await eval(`${_f}(url)`).catch(() => null);
                if (response && response.ok) {
                    const data = await response.json().catch(() => null);
                    if (data && data[0]) {
                        for (const item of data[0]) {
                            if (item[0]) googleText += item[0];
                        }
                        isGoogleAvailable = true;
                    }
                }
            }
        } catch (e) {
            isGoogleAvailable = false;
        }

        if (!isGoogleAvailable) {
            googleText = apiErrorMsg; 
        }

        var normOrig = origText.replace(/\r\n/g, "\n").replace(/\r/g, "\n");
        var normMacro = macroText.replace(/\r\n/g, "\n").replace(/\r/g, "\n");
        var normGoogle = googleText.replace(/\r\n/g, "\n").replace(/\r/g, "\n");

        var globalTrimRegex = /^[\s\u3000]+|[\s\u3000]+$/g;
        var globalOrig = normOrig.replace(globalTrimRegex, '');
        var globalMacro = normMacro.replace(globalTrimRegex, '');

        var globalGoogle = (googleText === apiErrorMsg) ? apiErrorMsg : normGoogle.replace(globalTrimRegex, '');

        var origTrimmed = trimEveryLine(globalOrig);
        var macroTrimmed = trimEveryLine(globalMacro);
        var googleTrimmed = (googleText === apiErrorMsg) ? apiErrorMsg : trimEveryLine(globalGoogle);

        var strippedCount = normOrig.length - origTrimmed.length;

        var diffsOM = computeDiff(origTrimmed, macroTrimmed);
        var macroColor = new Array(macroTrimmed.length).fill('black');
        var m_idx = 0;

        for (var i = 0; i < diffsOM.length; i++) {
            var dOM = diffsOM[i];
            if (dOM.type === 'equal') {
                m_idx += dOM.text.length; 
            } else if (dOM.type === 'insert') {
                for (var j = 0; j < dOM.text.length; j++) {
                    macroColor[m_idx++] = 'blue'; 
                }
            }
        }

        var googleColor = new Array((googleTrimmed === apiErrorMsg) ? 0 : googleTrimmed.length).fill('black');
        var diffCount = 0, delTemp = 0, insTemp = 0;

        if (googleText !== apiErrorMsg) {
            var diffsMG = computeDiff(macroTrimmed, googleTrimmed);
            m_idx = 0;
            var g_idx = 0;

            for (var i = 0; i < diffsMG.length; i++) {
                var dMG = diffsMG[i];
                if (dMG.type === 'equal') {
                    diffCount += Math.max(delTemp, insTemp);
                    delTemp = 0; insTemp = 0;

                    for (var j = 0; j < dMG.text.length; j++) {
                        googleColor[g_idx++] = macroColor[m_idx];
                        m_idx++;
                    }
                } else if (dMG.type === 'insert') {
                    insTemp += dMG.text.length;
                    for (var j = 0; j < dMG.text.length; j++) {
                        googleColor[g_idx++] = 'red';
                    }
                } else if (dMG.type === 'delete') {
                    delTemp += dMG.text.length;
                    for (var j = 0; j < dMG.text.length; j++) {
                        macroColor[m_idx++] = 'red';
                    }
                }
            }
            diffCount += Math.max(delTemp, insTemp);
        }

        function buildColoredHTML(text, colors) {
            var html = "";
            var currentColor = null;
            var currentSpan = "";

            for (var i = 0; i < text.length; i++) {
                var char = escapeHTML(text[i]);
                var color = colors[i];

                if (color !== currentColor) {
                    if (currentColor !== null) {
                        if (currentColor === 'black') html += currentSpan;
                        else html += `<span class="c-${currentColor}">${currentSpan}</span>`;
                    }
                    currentColor = color;
                    currentSpan = char;
                } else {
                    currentSpan += char;
                }
            }
            if (currentColor !== null) {
                if (currentColor === 'black') html += currentSpan;
                else html += `<span class="c-${currentColor}">${currentSpan}</span>`;
            }
            return html;
        }

        var macroHTML = buildColoredHTML(macroTrimmed, macroColor);
        var googleHTML = (googleText === apiErrorMsg) 
            ? `<span style="color:#d9534f; font-weight:bold;">${apiErrorMsg}</span>` 
            : buildColoredHTML(googleTrimmed, googleColor);

        var strippedMsg = "";
        if (strippedCount > 0) {
            strippedMsg = _L(
                `, removed ${strippedCount} leading/trailing spaces`, 
                `，刪除頭尾空白 ${strippedCount} 個`, 
                `，删除头尾空白 ${strippedCount} 个`
            );
        }

        var summaryText = _L(
            `📊 Total selected: ${origText.length} chars. Macro vs Google diff: ${diffCount} chars${strippedMsg}.`,
            `📊 總共選取 ${origText.length} 字，巨集與 Google 翻譯差異 ${diffCount} 字${strippedMsg}。`,
            `📊 总共选取 ${origText.length} 字，宏与 Google 翻译差异 ${diffCount} 字${strippedMsg}。`
        );

        let lblOrig = _L("Original Text", "原文內容", "原文内容");
        let lblMacro = _L(`Macro Conversion (${modeNames.EN})`, `巨集轉換 (${modeNames.TC})`, `宏转换 (${modeNames.SC})`);
        let lblGoogle = _L("Reference Translation (Google)", "參考翻譯 (Google)", "参考翻译 (Google)");
        let pageTitle = _L("Translation Comparison", "翻譯轉換對照", "翻译转换对比");

        let footerHtml = "";
        if (typeof Simulator_MODE !== "undefined" && Simulator_MODE === false) {
            let lblFooter = _L(
                "💡 Tip: Hold Ctrl and click the Macro Button to trigger Simulation Mode.",
                "💡 提示：按住 Ctrl 鍵並點擊「巨集按鈕」即可觸發模擬比對模式。",
                "💡 提示：按住 Ctrl 键并点击「宏按钮」即可触发模拟比对模式。"

            );
            footerHtml = `<div class="footer-hint">${lblFooter}</div>`;
        }

        const htmlContent = `<!DOCTYPE html>
<html>
<head>
<meta charset='utf-8'>
<title>${pageTitle}</title>
<style>
  body { 
      font-family: 'Segoe UI', 'Microsoft JhengHei', sans-serif; 
      padding: 20px; 
      background-color: #f7f9fc; 
      margin: 0;
  }
  .sim-header {
      text-align: center;
      color: #0275d8;
      font-weight: bold;
      font-size: 18px;
      margin-bottom: 20px;
      border-bottom: 2px solid #0275d8;
      padding-bottom: 10px;
      letter-spacing: 2px;
  }
  .block {
      background: #fff;
      padding: 15px 20px;
      margin-bottom: 15px;
      border-radius: 8px;
      border-left: 5px solid #ccc;
      box-shadow: 0 2px 5px rgba(0,0,0,0.05);
  }

  .block-orig { border-left-color: #af7ac5; }
  .block-orig .label { color: #8e44ad; }

  .block-macro { border-left-color: #58d68d; }
  .block-macro .label { color: #27ae60; }

  .block-google { border-left-color: #5dade2; }
  .block-google .label { color: #2980b9; }

  .header-row {
      margin-bottom: 8px;
  }
  .label {
      font-size: 14px;
      letter-spacing: 1px;
      margin: 0;
  }

  pre { 
      font-family: inherit; 
      font-size: 16px;
      line-height: 1.6;
      white-space: pre-wrap;
      word-wrap: break-word;
      margin: 0;
      color: #333;
  }

  .c-blue { color: #0275d8; font-weight: bold; }
  .c-red { color: #d9534f; font-weight: bold; border-bottom:1px #f5c2c7 solid;}

  .summary {
      margin-top: 20px;
      font-size: 15px;
      color: #555;
      font-weight: bold;
      text-align: center;
  }
  .footer-hint {
      margin-top: 25px;
      font-size: 14px;
      color: #666;
      background: #eef2f7;
      padding: 12px;
      border-radius: 6px;
      border: 1px dashed #cbd5e0;
      text-align: center;
  }
</style>
</head>
<body>
  <div class="sim-header">${lblSimMode}</div>

  <div class="block block-orig">
    <div class="header-row">
        <div class="label">${lblOrig}</div>
    </div>
    <pre>${escapeHTML(origTrimmed)}</pre>
  </div>

  <div class="block block-macro">
    <div class="header-row">
        <div class="label">${lblMacro}</div>
    </div>
    <pre>${macroHTML}</pre>
  </div>

  <div class="block block-google">
    <div class="header-row">
        <div class="label">${lblGoogle}</div>
    </div>
    <pre>${googleHTML}</pre>
  </div>

  <div class="summary">
    ${summaryText}
  </div>

  ${footerHtml}
</body>
</html>`;

        openInWebBar(htmlContent);

    } catch (e) {
        let errTitle = _L("❌ Script error: ", "❌ 腳本錯誤: ", "❌ 脚本错误: ");
        openInWebBar(`${errTitle}${e.message}`);
    } finally {
        shell.KeepRunning = false;
    }

    function openInWebBar(htmlString) {
        if (!htmlString.startsWith("<!DOCTYPE html>")) {
            htmlString = `<!DOCTYPE html><html><body style="padding:20px;font-family:sans-serif;">${htmlString}</body></html>`;
        }
        try {
            WebBar.SetFocus();

            let safeHTML = htmlString;
            try {
                if (web.window.trustedTypes && web.window.trustedTypes.createPolicy) {
                    const policy = web.window.trustedTypes.createPolicy('default', { createHTML: s => s });
                    safeHTML = policy.createHTML(htmlString);
                }
            } catch(e) {}

            web.document.open();
            web.document.write(safeHTML);
            web.document.close();
        } catch(err) {
            OutputBar.Clear();
            let outErr = _L("WebBar display failed: ", "WebBar 顯示失敗: ", "WebBar 显示失败: ");
            OutputBar.writeln(outErr + err.message);
            OutputBar.Visible = true;
        }
    }
}

// --- [##核心邏輯區##] ---
function main() {
    // 0. 偵測是否開啟模擬模式 與 控制鍵狀態
    const isShiftPressed = (shell.GetKeyState(0x10) < 0); // 按住 Shift : 僅使用標準詞組與單字，忽略 [視界邏輯]、[語法邏輯]、[區塊 B：自訂擴充覆寫詞庫]、[區塊 D：台灣字形修正 (TWVariants.txt)]、[區塊 E：台灣字形修正例外清單]
    const isCtrlPressed = (shell.GetKeyState(0x11) < 0); // 按住 Ctrl : 使用模擬轉換模式
    const isAltPressed = (shell.GetKeyState(0x12) < 0); // 按住 Alt : 忽略 [區塊 D：台灣字形修正 (TWVariants.txt)]
    const isSimulate = (typeof Simulator_MODE !== "undefined" && Simulator_MODE === true) || isCtrlPressed;

    const isContextLogicReady = ContextLogic_MODE && !isShiftPressed;
    const effectiveContextLogic = isContextLogicReady && (CURRENT_MODE === "S2T" || CURRENT_MODE === "S2TE");
    const effectiveContextLogic_T2S = isContextLogicReady && CURRENT_MODE === "T2S";

    const isVisionLogicReady = VisionLogic_MODE && !isShiftPressed;
    const effectiveVisionLogic = isVisionLogicReady && (CURRENT_MODE === "S2T" || CURRENT_MODE === "S2TE");

    // 1. 動態模式與語言設定
    const langId = editor.LangID;
    const _L = (en, tc, sc) => {
        if (langId === 1028) return tc;
        if (langId === 2052) return sc;
        return en;
    };

    let msgModeNameTC = "", msgModeNameSC = "", msgModeNameEN = "";

    switch(CURRENT_MODE) {
        case "T2S":
            msgModeNameTC = "繁轉簡"; msgModeNameSC = "繁转简"; msgModeNameEN = "T2S"; break;
        case "S2T":
            msgModeNameTC = "簡轉繁"; msgModeNameSC = "简转繁"; msgModeNameEN = "S2T"; break;
        case "S2TE":
            msgModeNameTC = "簡轉繁: 擴充版"; msgModeNameSC = "简转繁: 扩充版"; msgModeNameEN = "S2T: Expanded"; break;
        case "S2TWP":
            msgModeNameTC = "用語轉換: 大陸 ➔ 台灣"; msgModeNameSC = "用语转换: 大陆 ➔ 台湾"; msgModeNameEN = "Terminology: CN->TW"; break;
        case "TW2SP":
            msgModeNameTC = "用語轉換: 台灣 ➔ 大陸"; msgModeNameSC = "用语转换: 台湾 ➔ 大陆"; msgModeNameEN = "Terminology: TW->CN"; break;
        default:
            msgModeNameTC = "文字"; msgModeNameSC = "文字"; msgModeNameEN = "Text"; break;
    }

    let currentModeNames = {
        TC: msgModeNameTC,
        SC: msgModeNameSC,
        EN: msgModeNameEN
    };

    const MSG_NO_TEXT = _L("No text selected.", "未選取文字", "未选中文本");

    const getMsgProcessing = (p) => {
    var steps = "▁▃▅▇";
    var fullStr  = "▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇";
    var trackStr = "▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁";
    var bar = "";

    // 進度條邏輯
    if (p >= 99) {
        bar = fullStr.substring(0, 19) + "▅"; 
    } else {
        var filledCount = Math.floor(p / 5);
        var remainder = p % 5;
        var stepIdx = Math.floor((remainder / 5) * 4);
        var tipChar = steps.charAt(stepIdx);
        bar = fullStr.substring(0, filledCount) + tipChar + trackStr.substring(0, 19 - filledCount);
    }

    var pStr = (p < 10) ? "0" + p : p;
    if (p >= 99) {
        return _L(
            `⏳ Integrating data, please wait... \n${bar} ${pStr}%`, 
            `⏳ ${msgModeNameTC} 資料整合中，請稍候... \n${bar} ${pStr}%`, 
            `⏳ ${msgModeNameSC} 数据整合中，请稍候... \n${bar} ${pStr}%`
        );
    }
    return _L(
        `⏳ Processing data, please wait... \n${bar} ${pStr}%`, 
        `⏳ ${msgModeNameTC} 資料處理中，請稍候... \n${bar} ${pStr}%`, 
        `⏳ ${msgModeNameSC} 数据处理中，请稍候... \n${bar} ${pStr}%`
    );
};

    const getMsgSuccess = (count, time) => {
        let ignoreTW = isAltPressed || isShiftPressed;

        let suffixTC = "";
        let suffixSC = "";
        let suffixEN = "";

        if (!ignoreTW) {
            if (CURRENT_MODE === "S2T" || CURRENT_MODE === "S2TE") {
                suffixTC = "已套用台灣字形，";
                suffixSC = "已套用台湾字形，";
                suffixEN = "TW variants applied, ";
            } else if (CURRENT_MODE === "T2S") {
                suffixTC = "台灣字形已反轉，";
                suffixSC = "台湾字形已反转，";
                suffixEN = "TW variants reversed, ";
            }
        }

        let logicActive = ContextLogic_MODE && !isShiftPressed;
        let logicTC = logicActive ? "已套用語法邏輯，" : "";
        let logicSC = logicActive ? "已套用语法逻辑，" : "";
        let logicEN = logicActive ? "Context logic applied, " : "";

        let visionActive = effectiveVisionLogic && isVisionTriggered;
        let visionTC = visionActive ? "視界邏輯，" : "";
        let visionSC = visionActive ? "视界逻辑，" : "";
        let visionEN = visionActive ? "Vision logic applied, " : "";

        if (isSimulate) {
            return _L(
                `✅ Conversion simulated (${msgModeNameEN}, ${suffixEN}${logicEN}${visionEN}${count} ops in ${time} s).`,
                `✅ 模擬運算完成 (${msgModeNameTC}，${suffixTC}${logicTC}${visionTC}共計 ${count} 處變更，耗時 ${time} 秒，未修改原文)`,
                `✅ 模拟运算完成 (${msgModeNameSC}，${suffixSC}${logicSC}${visionSC}共计 ${count} 处变更，耗时 ${time} 秒，未修改原文)`
            );
        } else {
            return _L(
                `✅ Conversion completed (${msgModeNameEN}, ${suffixEN}${logicEN}${visionEN}${count} ops in ${time} s).`,
                `✅ 轉換完成 (${msgModeNameTC}，${suffixTC}${logicTC}${visionTC}共取代 ${count} 處，耗時 ${time} 秒)`,
                `✅ 转换完成 (${msgModeNameSC}，${suffixSC}${logicSC}${visionSC}共替换 ${count} 处，耗时 ${time} 秒)`
            );
        }
    };

    const startTime = Date.now();

    // 2. 選取處理
    let isCSVCellSel = false;

    try {
        if ((document.selection.Mode & 15) === 4) isCSVCellSel = true;
    } catch(e) {}

    let checkText = "";
    if (!isCSVCellSel && document.selection.IsEmpty) {
        try { 
            checkText = document.selection.Text; 
        } catch(e) {}

        if (checkText.length > 0) {
            isCSVCellSel = true;
        }
    }

    if (!isCSVCellSel && document.selection.IsEmpty) {
        document.selection.SelectWord();
        if (document.selection.IsEmpty) {
            alert(MSG_NO_TEXT); 
            Quit();
        }
    }

    const topY = document.selection.GetTopPointY(eePosLogical);
    const topX = document.selection.GetTopPointX(eePosLogical);
    const bottomY = document.selection.GetBottomPointY(eePosLogical);
    const bottomX = document.selection.GetBottomPointX(eePosLogical);
    let realBottomX = bottomX, realBottomY = bottomY;
    const selectedLines = bottomY - topY + 1;
    const selectedWidth = Math.abs(bottomX - topX);

    // 偵測選取長度並格式化數字
    status = _L(
        "⏳ Detecting selection size...", 
        "⏳ 正在檢測選取範圍大小...", 
        "⏳ 正在检测选取范围大小..."
    );

    let txtlen = -1;
    try { 
        txtlen = document.selection.TextLength; 
    } catch(e) {}

    const fmtN = (num) => num.toLocaleString('en-US');

    if (txtlen !== -1) {
        // A. 模擬模式攔截 (200 字元)
        if (isSimulate && txtlen > 200) {
            status = "";
                alert(_L(
                    "⚠️ Selection too large (Character count: " + fmtN(txtlen) + "). Simulation is aborted.",
                    "⚠️ 選取範圍過大 (字元數: " + fmtN(txtlen) + ")，已中止模擬模式。",
                    "⚠️ 选取范围过大 (字符数: " + fmtN(txtlen) + ")，已中止模拟模式。"
                ));
            Quit();
        }
        // B. 實際模式極限攔截 (2,000,000,000 字元)
        if (!isSimulate && txtlen > 2000000000) {
            status = "";
            alert(_L(
                "⚠️ Selection exceeds 2,000,000,000 characters. Due to architectural limits, conversion is aborted to protect memory and prevent crashes. \n\nPlease reduce the selection range and convert in segments.",
                "⚠️ 選取內容超過 2,000,000,000 字元。因架構問題，為保護系統記憶體避免當機，系統已攔截並中止轉換。\n\n建議縮小選取範圍，分段進行轉換。",
                "⚠️ 选取内容超过 2,000,000,000 字符。因架构问题，为保护系统内存避免当机，系统已拦截并中止转换。\n\n建议缩小选取范围，分段进行转换。"
            ));
            Quit();
        }
    } else {
        // C. 舊版相容模式：使用座標估算 (僅在模擬模式下攔截)
        if (isSimulate && (selectedLines > 50 || selectedWidth > 200)) {
            status = "";
                alert(_L(
                    "⚠️ Selection too large (Lines: " + fmtN(selectedLines) + ", Width: " + fmtN(selectedWidth) + "). Aborting simulation.",
                    "⚠️ 選取範圍過大 (行數: " + fmtN(selectedLines) + "，寬度: " + fmtN(selectedWidth) + ")，已中止模擬模式。",
                    "⚠️ 选取范围过大 (行数: " + fmtN(selectedLines) + "，宽度: " + fmtN(selectedWidth) + ")，已中止模拟模式。"
                ));
            Quit();
        }
    }

    let initialText = "";
    if (isSimulate) {
        try { initialText = document.selection.Text; } catch(e) {}

        if (initialText.length > 200) {
            status = "";
                alert(_L(
                    "⚠️ Selected character count is " + fmtN(initialText.length) + ", exceeding the 200-character limit.",
                    "⚠️ 選取字元數為 " + fmtN(initialText.length) + "，已超過模擬模式的 200 字元上限。",
                    "⚠️ 选取字符数为 " + fmtN(initialText.length) + "，已超过模拟模式的 200 字符上限。"
                ));
            Quit(); 
        }
    }

    if (!isCSVCellSel && selectedLines > 20000000) {
        status = "";
        alert(_L(
            "⚠️ Selected lines exceed 20,000,000 limit. Conversion aborted. Please reduce selection.",
            "⚠️ 選取總行數超過 2000 萬行，超出安全轉換限制，已中止轉換作業。\n為避免系統無回應，請減少選取範圍後再試。",
            "⚠️ 选取总行数超过 2000 万行，超出安全转换限制，已中止转换程序。\n为避免系统无回应，请减少选取范围后再试。"
        ));
        Quit();
    }

    let isFilterMode = false;
    try {
        if (document.filters && document.filters.Count > 0) {
            isFilterMode = true;
        }
    } catch (e) {}

    let selCount = 1;
    let isMultiSel = false;
    let isVerticalSel = false; 

    try {
        if ((document.selection.Mode & 15) === 3) {
            isVerticalSel = true;
            isMultiSel = true; 
        }
    } catch(e) {}

    try {
        if (typeof document.selection.Count !== "undefined" && document.selection.Count > 1) {
            selCount = document.selection.Count;
            isMultiSel = true;
        }
    } catch(e) {}

    if (!isCSVCellSel && (isFilterMode || isMultiSel) && selectedLines > 5000) {
        status = "";
        alert(_L(
            "Selection exceeds 5000 lines limit for Filter/Multi-Select mode. Please reduce selection.",
            "⚠️ 篩選或多段選取模式下，選取範圍超過 5000 行限制。\n為避免系統無回應，請減少選取範圍後再試。",
            "⚠️ 筛选或多段选取模式下，选取范围超过 5000 行限制。\n为避免系统无回应，请减少选取范围后再试。"
        ));
        Quit();
    }

    // 分流門檻：當選取長度超過 30,000,000 字且非複雜模式時，交給 BoostCVT 增壓引擎轉換處理 (需 EmEditor v26.1+)
    if ((CURRENT_MODE === "T2S" || CURRENT_MODE === "S2T") && txtlen > 30000000 && txtlen < 2000000000 && !isCSVCellSel && !isMultiSel && !isVerticalSel && !isFilterMode) {
        var scriptDir = ScriptFullName.substring(0, ScriptFullName.lastIndexOf("\\") + 1);
        var fastMacro = scriptDir + "BoostCVT.jsee";
        var fastEXE   = scriptDir + "BoostCVT.exe";
        var fastDLL = scriptDir + "BoostCVT.dll";
        // BoostCVT 加速組件為選配項目，僅在大規模文字且組件存在時啟動。使用者可視需求自由部署，只需 EXE 或 DLL 其中一種即可；使用時須經由 .jsee 腳本驅動，不支援獨立運作。
        if (shell.FileExists(fastMacro) && (shell.FileExists(fastEXE) || shell.FileExists(fastDLL))) {
            status = _L("⏳ BoostCVT Engine: Converting large file ...", "⏳ BoostCVT 增壓引擎：大型檔案轉換中...", "⏳ BoostCVT 增压引擎：大文件转换中...");

            // 備份原始剪貼簿
            var userClipBackup = clipboardData.getData("Text");

            // 將參數封裝成字串放入剪貼簿 (格式: 標籤|模式|巨集路徑|模擬|語法|視界|外部詞典)
            var configParams = [
                "BoostCVT_CONFIG_TOKEN",
                CURRENT_MODE,
                ScriptFullName,
                isSimulate ? "true" : "false",
                ContextLogic_MODE ? "true" : "false",
                VisionLogic_MODE ? "true" : "false",
                Use_ExternalDict ? "true" : "false"
            ].join("|");

            clipboardData.setData("Text", configParams);

            try {
                // 呼叫 BoostCVT 增壓引擎
                editor.ExecuteMacro(fastMacro, eeRunFile | eeMacroSyncOnly);

                // 執行完畢後，恢復剪貼簿
                clipboardData.clearData("Text", 0);
                if (userClipBackup !== null) clipboardData.setData("Text", userClipBackup);
                return; 
            } catch (e) {
                // 若增壓引擎執行失敗，仍需還原剪貼簿，並降級跑 V8 邏輯
                clipboardData.clearData("Text", 0);
                if (userClipBackup !== null) clipboardData.setData("Text", userClipBackup);
            }
        }
    }

    // 3. 動態切塊邏輯
    let chunks = [];
    if (!isCSVCellSel && !isFilterMode && !isMultiSel) {
        let numChunks = 1;

        if (txtlen > 0) {
            numChunks = Math.ceil(txtlen / 60000000);
        } else {
            if (selectedLines <= 2000) {
                    numChunks = Math.max(1, Math.ceil(selectedLines / 400));
                } else if (selectedLines <= 10000) {
                    numChunks = Math.floor(5 + (selectedLines - 2000) / 533);
                } else {
                    numChunks = Math.min(100, Math.floor(20 + (selectedLines - 10000) / 166333));
                }
        }

        let linesPerChunk = Math.ceil(selectedLines / numChunks);
        if (linesPerChunk < 1) linesPerChunk = 1;

        let currY = topY;
        while (currY <= bottomY) {
            let eY = Math.min(currY + linesPerChunk - 1, bottomY);
            chunks.push({
                topY: currY, bottomY: eY,
                isFirst: (currY === topY), isLast: (eY === bottomY)
            });
            currY = eY + 1;
        }
        chunks.reverse(); 
    }

// 4. 動態構建 Trie 引擎
    status = _L(
        `⏳ Building Trie Engine & Processing (${msgModeNameEN})...`, 
        `⏳ 建立字典樹引擎，${msgModeNameTC} 處理中...`, 
        `⏳ 建立字典树引擎，${msgModeNameSC} 处理中...`
    );

    // 🌟 連接外部詞典 (JS偵察兵 + C#備援)
    let currentPhraseData, currentCharData, currentTWVariants, currentExceptionData, currentPhraseExpandedData;
    let dictLoadedFromExe = false;

    // 🛡️ 第一層：總開關
    if (Use_ExternalDict) {
        try {
            let scriptDir = ScriptFullName.substring(0, ScriptFullName.lastIndexOf("\\") + 1);
            let fastMacro = scriptDir + "BoostCVT.jsee";
            let fastEXE = scriptDir + "BoostCVT.exe";
            let fastDLL = scriptDir + "BoostCVT.dll";

            let backupClip = clipboardData.getData("Text");

            // 🕵️ 第二層：呼叫 JS 輕量偵察兵
            let jsScoutSuccess = false;
            if (shell.FileExists(fastMacro)) {

                clipboardData.setData("Text", "BoostCVT_LOAD_DICT|" + CURRENT_MODE + "|" + ScriptFullName);
                // 執行 JS 變速箱 (化身為偵察兵)
                editor.ExecuteMacro(fastMacro, eeRunFile | eeMacroSyncOnly);

                let newClip = clipboardData.getData("Text") || "";
                if (newClip.indexOf("|||BLOCK_SEP|||") !== -1) {
                    let newData = newClip.split("|||BLOCK_SEP|||");
                    if (newData.length >= 5) {
                        currentPhraseData = newData[0];
                        currentCharData = newData[1];
                        currentTWVariants = newData[2];
                        currentPhraseExpandedData = newData[3];
                        currentExceptionData = newData[4];
                        dictLoadedFromExe = true;
                        jsScoutSuccess = true;
                    }
                } else if (newClip === "0") {
                    // 偵察兵回報：檔案日期沒有更新，直接跳過 C# 讀取
                    dictLoadedFromExe = false; 
                    jsScoutSuccess = true; 
                }
            }

            // 🚜 第三層：若 JS 偵察兵意外失效，啟用 C# 雙軌備援讀取
            if (!jsScoutSuccess && (shell.FileExists(fastEXE) || shell.FileExists(fastDLL))) {
                if (shell.FileExists(fastEXE)) {
                    // 🚀 途徑一：使用 conhost.exe 無頭模式執行 EXE
                    let dictConfig = CURRENT_MODE + "|" + ScriptFullName;
                    let strCommand = "conhost.exe";
                    let strParameter = '--headless "' + fastEXE + '" LOAD_DICT "' + dictConfig + '"';

                    shell.Run(strCommand, 0, true, strParameter);
                } else {
                    // 🛡️ 途徑二：透過 PowerShell 在記憶體中載入 DLL
                    let safeDllPath = fastDLL.replace(/\\/g, "/");
                    let dictConfig = CURRENT_MODE + "|" + ScriptFullName.replace(/\\/g, "/");
                    let strCommand = "conhost.exe";
                    let strParameter = "--headless powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& {[Reflection.Assembly]::LoadFile('" + safeDllPath + "') | Out-Null; [MyTools.TextProcessor]::Convert('LOAD_DICT', '" + dictConfig + "');}\"";

                    shell.Run(strCommand, 0, true, strParameter);
                }

                let csharpClip = clipboardData.getData("Text") || "";
                if (csharpClip.indexOf("|||BLOCK_SEP|||") !== -1) {
                    let newData = csharpClip.split("|||BLOCK_SEP|||");
                    if (newData.length >= 5) {
                        currentPhraseData = newData[0];
                        currentCharData = newData[1];
                        currentTWVariants = newData[2];
                        currentPhraseExpandedData = newData[3];
                        currentExceptionData = newData[4];
                        dictLoadedFromExe = true;
                    }
                }
            }

            // 釋放記憶體並還原剪貼簿
            clipboardData.clearData("Text", 0);
            if (backupClip !== null) clipboardData.setData("Text", backupClip);

        } catch(e) {}
    }

    // 🛡️ Fallback 機制：如果沒執行、失敗、或沒更新，退回使用全域常數
    if (!dictLoadedFromExe) {
        currentPhraseData = typeof rawPhraseData !== "undefined" ? rawPhraseData : "";
        currentCharData = typeof rawCharData !== "undefined" ? rawCharData : "";
        currentTWVariants = typeof rawTWVariants !== "undefined" ? rawTWVariants : "";
        currentPhraseExpandedData = typeof rawPhraseExpandedData !== "undefined" ? rawPhraseExpandedData : "";
        currentExceptionData = typeof rawExceptionData !== "undefined" ? rawExceptionData : "";
    }

    const variantMap = new Map();
    const finalDict = new Map();

    const exceptionSet = new Set();
    const exceptionMap = new Map();

    if (!isShiftPressed && typeof currentExceptionData !== "undefined" && currentExceptionData) {
    try {
        const linesEx = currentExceptionData.split("\n");
        for (let i = 0; i < linesEx.length; i++) {
            let line = linesEx[i];
            if (!line || line[0] === "#" || line[0] === "\r") continue;
            let tabIndex = line.indexOf("\t");
            if (tabIndex === -1) continue;
            let key = line.substring(0, tabIndex);
            let target = line.substring(tabIndex + 1).replace(/\r/g, "");
            exceptionSet.add(key);
            exceptionSet.add(target);
            exceptionMap.set(key, target);
            exceptionMap.set(target, target);
        }
    } catch(e) {}
}

    const isS2TVariant = (CURRENT_MODE === "S2T" || CURRENT_MODE === "S2TE") && !isAltPressed && !isShiftPressed;
    const isT2SVariant = (CURRENT_MODE === "T2S") && !isAltPressed && !isShiftPressed;
    const needVariants = isS2TVariant || isT2SVariant;

    if (needVariants && typeof currentTWVariants !== "undefined" && currentTWVariants) {
    try {
        const linesTW = currentTWVariants.split("\n");
        for (let i = 0; i < linesTW.length; i++) {
            let line = linesTW[i];
            if (!line || line[0] === "#" || line[0] === "\r") continue;
            let tabIndex = line.indexOf("\t");
            if (tabIndex === -1) continue;
            let k = line.substring(0, tabIndex);
            let rest = line.substring(tabIndex + 1);
            let spaceIndex = rest.indexOf(" ");
            let v = (spaceIndex === -1) 
                    ? rest.replace(/\r/g, "") 
                    : rest.substring(0, spaceIndex);

            if (isS2TVariant) {
                variantMap.set(k, v);
            } else if (isT2SVariant) {
                variantMap.set(v, k); // 反向映射：繁轉簡
            }
        }
    } catch(e) {}
}

    const applyTWVariants = (str) => {
        if (!isS2TVariant) return str; 
        let res = "";
        for (let c of str) res += variantMap.has(c) ? variantMap.get(c) : c;
        return res;
    };

    const parseMainData = (rawStr) => {
    if (!rawStr) return;
    const lines = rawStr.split("\n");
    for (let i = 0; i < lines.length; i++) {
        let line = lines[i];
        if (!line || line[0] === "#" || line[0] === "\r") continue;
        let tabIndex = line.indexOf("\t");
        if (tabIndex === -1) continue;
        let key = line.substring(0, tabIndex);
        if (effectiveContextLogic && ContextLogicAnchors.has(key)) continue;
        let rawTarget = line.substring(tabIndex + 1).replace(/\r/g, "");
        let firstTarget = rawTarget.split(" ")[0];

        let target = (exceptionMap && exceptionMap.has(key)) 
                     ? exceptionMap.get(key) 
                     : applyTWVariants(firstTarget);

        if (!finalDict.has(key)) {
            finalDict.set(key, target);
        }
    }
};

    if (!isShiftPressed) {
        if (typeof currentExceptionData !== "undefined") try { parseMainData(currentExceptionData); } catch(e){}
        if (typeof currentPhraseExpandedData !== "undefined") try { parseMainData(currentPhraseExpandedData); } catch(e){}
    }
    try { if (typeof currentPhraseData !== "undefined") parseMainData(currentPhraseData); } catch(e){}

    if (CURRENT_MODE !== "S2TWP" && CURRENT_MODE !== "TW2SP") {
        try { if (typeof currentCharData !== "undefined") parseMainData(currentCharData); } catch(e){}
    }

    if (isS2TVariant) {
        for (let [vKey, vTarget] of variantMap) {
            if (!finalDict.has(vKey)) finalDict.set(vKey, vTarget);
        }
    } else if (isT2SVariant) {
        for (let [twChar, genericChar] of variantMap) {
            if (!finalDict.has(twChar)) {
                if (finalDict.has(genericChar)) {
                    finalDict.set(twChar, finalDict.get(genericChar));
                } else {
                    finalDict.set(twChar, genericChar);
                }
            }
        }
    }

    // Trie 引擎 最佳化(V8 加速)
    status = _L(
        `⏳ Trie Engine V8 Optimization & Processing (${msgModeNameEN})...`, 
        `⏳ 字典樹引擎 V8 最佳化，${msgModeNameTC} 處理中...`, 
        `⏳ 字典树引擎 V8 优化，${msgModeNameSC} 处理中...`
    );

    class TrieNode {
        constructor() {
            this.c = new Map();
            this.v = null;
            this.o = null;
        }
    }

    const rootNodes = new Array(65536);
    for (let [key, target] of finalDict) {
        if (!key) continue;
        let firstCode = key.charCodeAt(0);
        let node = rootNodes[firstCode];
        if (!node) {
            node = new TrieNode();
            rootNodes[firstCode] = node;
        }

        for (let j = 1; j < key.length; j++) {
            let code = key.charCodeAt(j);
            let nextNode = node.c.get(code);
            if (!nextNode) {
                nextNode = new TrieNode();
                node.c.set(code, nextNode);
            }
            node = nextNode;
        }
        node.v = target;
        node.o = key;
    }

    const activeLogicArr = new Array(65536);
    let hasLogic = false;
    const currentLogicObj = effectiveContextLogic ? ContextLogic : (effectiveContextLogic_T2S ? ContextLogic_T2S : null);
    if (currentLogicObj !== null) {
        hasLogic = true;
        for (let k in currentLogicObj) {
            activeLogicArr[k] = currentLogicObj[k];
        }
    }

    const doConvert = (srcText) => {
        let textLen = srcText.length;
        let masterOut = [];
        let out = [];
        let i = 0;
        let lastMatchEnd = 0;
        let replaceCount = 0;
        const fastSkipLimit = (CURRENT_MODE === "S2TWP" || CURRENT_MODE === "TW2SP") ? 0x21 : 0x80;

        while (i < textLen) {
            let firstCode = srcText.charCodeAt(i);

            if (firstCode < fastSkipLimit) { 
                while (i < textLen && srcText.charCodeAt(i) < fastSkipLimit) i++;
                continue;
            }

            let node = rootNodes[firstCode];
            if (node === undefined) {
                i++;
                continue;
            }

            let longestMatchLen = 0;
            let longestMatchTarget = null;
            let longestMatchOriginal = null;
            let j = i;

            if (node.v !== null) {
                longestMatchLen = 1;
                longestMatchTarget = node.v;
                longestMatchOriginal = node.o;
            }

            j++;
            while (j < textLen) {
                let code = srcText.charCodeAt(j);
                node = node.c.get(code);
                if (node === undefined) break; 

                if (node.v !== null) {
                    longestMatchLen = j - i + 1;
                    longestMatchTarget = node.v;
                    longestMatchOriginal = node.o;
                }
                j++;
            }

            if (effectiveVisionLogic && longestMatchLen > 1) {
                var anchorLen = longestMatchLen;
                var foundAnchor = null;
                while (anchorLen > 1) {
                    var currentPrefix = srcText.substring(i, i + anchorLen);
                    if (VisionAnchors.has(currentPrefix)) {
                        foundAnchor = currentPrefix;
                        break; 
                    }
                    anchorLen--;
                }

                if (foundAnchor) {
                    isVisionTriggered = true;
                    if (longestMatchLen >= 4 && longestMatchLen > anchorLen) foundAnchor = null;
                }

                if (foundAnchor) {
                    var visionIdx = i + anchorLen - 1;
                    var visionNode = rootNodes[srcText.charCodeAt(visionIdx)];
                    var visionWord = "";

                    var k = visionIdx + 1;
                    while (k < textLen) {
                        visionNode = visionNode ? visionNode.c.get(srcText.charCodeAt(k)) : null;
                        var currentSub = srcText.substring(visionIdx, k + 1);
                        if ((visionNode && visionNode.v !== null) || VisionVocabs.has(currentSub)) {
                            visionWord = currentSub;
                        }
                        if (!visionNode && currentSub.length > 6) break;
                        k++;
                    }

                    if (visionWord !== "") {
                        var isVisionStable = true;
                        var deepIdx = visionIdx + visionWord.length - 1;
                        var deepNode = rootNodes[srcText.charCodeAt(deepIdx)];
                        var k2 = deepIdx + 1;

                        while (k2 < textLen) {
                            deepNode = deepNode ? deepNode.c.get(srcText.charCodeAt(k2)) : null;
                            var deepSub = srcText.substring(deepIdx, k2 + 1);
                            if ((deepNode && deepNode.v !== null) || VisionVocabs.has(deepSub)) {
                                isVisionStable = false;
                                break;
                            }
                            if (!deepNode && deepSub.length > 6) break;
                            k2++;
                        }

                        if (isVisionStable) {
                            var backupLen = anchorLen - 1;
                            var foundBackup = false;
                            while (backupLen >= 2) {
                                if (VisionAnchors.has(srcText.substring(i, i + backupLen))) {
                                    longestMatchLen = backupLen;
                                    foundBackup = true;
                                    break;
                                }
                                backupLen--;
                            }
                            if (!foundBackup) longestMatchLen = 1;

                            var finalNode = rootNodes[srcText.charCodeAt(i)];
                            for (var m = 1; m < longestMatchLen; m++) {
                                if (!finalNode) break;
                                finalNode = finalNode.c.get(srcText.charCodeAt(i + m));
                            }
                            if (finalNode && finalNode.v !== null) {
                                longestMatchTarget = finalNode.v;
                            } else {
                                longestMatchLen = 1;
                                longestMatchTarget = srcText.charAt(i);
                            }
                            longestMatchOriginal = srcText.substring(i, i + longestMatchLen);
                        }
                    }
                }
            }

            if (longestMatchLen > 0) {
                let finalTarget = longestMatchTarget;

                if (longestMatchLen === 1 && hasLogic) {
                    let hook = activeLogicArr[firstCode];
                    if (hook !== undefined) finalTarget = hook(i, srcText);
                }

                if (longestMatchOriginal !== finalTarget) {
                    if (i > lastMatchEnd) {
                        out.push(srcText.substring(lastMatchEnd, i));
                    }

                    out.push(finalTarget);
                    replaceCount++;
                    lastMatchEnd = i + longestMatchLen;

                    if (out.length > 10000) {
                        masterOut.push(out.join(""));
                        out = [];
                    }
                }
                i += longestMatchLen;
            } else { 
                i++;
            }
        }

        if (lastMatchEnd < textLen) {
            out.push(srcText.substring(lastMatchEnd, textLen));
        }

        if (out.length > 0) {
            masterOut.push(out.join(""));
        }

        return { text: masterOut.join(""), count: replaceCount };
    };

    // 5. 開始轉換
    let totalReplaced = 0;
    let isVisionTriggered = false;
    let bOrgCombine = false; 

    try { Redraw = false; } catch(e) {}
    try { 
        bOrgCombine = CombineHistory;
        CombineHistory = true; 
    } catch(e) {} 

    try {
        if (isCSVCellSel) {
            const eePosCell = 4;
            const eePosLogical = 1;
            let cTopRow, cBottomRow, cTopCol, cBottomCol;
            try {
                cTopRow = document.selection.GetTopPointY(eePosCell);
                cBottomRow = document.selection.GetBottomPointY(eePosCell);
                cTopCol = document.selection.GetTopPointX(eePosCell);
                cBottomCol = document.selection.GetBottomPointX(eePosCell);
            } catch(e) {
                status = "";
                alert(_L("❌ Error reading cell coordinates.", "❌ 無法取得儲存格座標！", "❌ 无法取得单元格坐标！"));
                Quit();
            }

            let totalCells = (cBottomRow - cTopRow + 1) * (cBottomCol - cTopCol + 1);
            let delimChar = "\t"; 
            try {
                if (document.Csv) delimChar = document.Csv.Delimiter;
            } catch(e) {}

            let quoteChar = '"';
            try { if (document.Csv) quoteChar = document.Csv.QuotationMark; } catch(e) {}

            let anchorY = document.selection.GetAnchorPointY(eePosCell);
            let anchorX = document.selection.GetAnchorPointX(eePosCell);
            let activeY = document.selection.GetActivePointY(eePosCell);
            let activeX = document.selection.GetActivePointX(eePosCell);

            document.selection.SetAnchorPoint(eePosCell, 1, cTopRow);
            document.selection.SetActivePoint(eePosCell, cBottomCol, cBottomRow, true);
            let fullText = document.selection.Text;

            document.selection.SetAnchorPoint(eePosCell, anchorX, anchorY);
            document.selection.SetActivePoint(eePosCell, activeX, activeY, true);

            // 🗺️ 階段一：CSV 安全掃描 + 繪製地圖
            let lines = fullText.split(/\r\n|\r|\n/);

            let totalR = cBottomRow - cTopRow + 1;
            if (lines.length > totalR && lines[lines.length - 1] === "") {
                lines.pop();
            }

            let blocks = [];
            let irregularCellsCount = 0;
            let isAbsoluteDefense = false;

            if (lines.length !== totalR) {
                blocks.push({ isRegular: false, topRow: cTopRow, bottomRow: cBottomRow });
                irregularCellsCount = totalCells;
                isAbsoluteDefense = true;
            } else {
                let currentType = null;
                let startRow = cTopRow;
                let requiredDelims = cBottomCol - 1;

                for (let i = 0; i < lines.length; i++) {
                    let line = lines[i];
                    let count = 0;
                    let inQuotes = false;

                    for (let j = 0; j < line.length; j++) {
                        let char = line[j];
                        if (char === '"') inQuotes = !inQuotes;
                        else if (char === delimChar && !inQuotes) count++;
                    }

                    let isRowRegular = (count >= requiredDelims);

                    if (currentType === null) {
                        currentType = isRowRegular;
                    } else if (currentType !== isRowRegular) {
                        blocks.push({ isRegular: currentType, topRow: startRow, bottomRow: cTopRow + i - 1 });
                        if (!currentType) {
                            irregularCellsCount += (cTopRow + i - 1 - startRow + 1) * (cBottomCol - cTopCol + 1);
                        }
                        currentType = isRowRegular;
                        startRow = cTopRow + i;
                    }
                }
                if (currentType !== null) {
                    blocks.push({ isRegular: currentType, topRow: startRow, bottomRow: cBottomRow });
                    if (!currentType) {
                        irregularCellsCount += (cBottomRow - startRow + 1) * (cBottomCol - cTopCol + 1);
                    }
                }
            }

            // ⚙️ 階段二：混合執行轉換
            if (irregularCellsCount > 100000) {
                status = "";
                alert(_L(
                    "⚠️ Irregular CSV parts (>100,000 cells) detected.\nConversion aborted to prevent data shifting. Please select a smaller area.\n\n💡 For full-file conversion, it is recommended to exit 'CSV Mode' and return to 'Normal Mode' to ensure data integrity and conversion efficiency.",
                    "⚠️ 偵測到不規則的 CSV 區塊超過 100,000 格限制。\n為防止轉換後發生資料推擠錯位，系統已自動攔截轉換。請縮小選取範圍。\n\n💡 若需轉換整個檔案，建議退出「CSV 模式」，回到「標準模式」執行，以確保資料完整正確與轉換效率。",
                    "⚠️ 侦测到不规则的 CSV 区块超过 100,000 格限制。\n为防止转换后发生数据推挤错位，系统已自动拦截转换。请缩小选取范围。\n\n💡 若需转换整个文件，建议退出「CSV 模式」，回到「标准模式」执行，以确保数据完整正确与转换效率。"
                ));
                Quit();
            }

            if (isAbsoluteDefense) {
                ShowTip(_L("🛡️ Complex CSV detected. Safe precise conversion...", "🛡️ 偵測到 CSV 複雜儲存格，啟動安全精確轉換...", "🛡️ 侦测到 CSV 复杂单元格，启动安全精确转换..."), 1);
                status = "Absolute Defense Mode";
            } else if (irregularCellsCount > 0) {
                ShowTip(_L("📊 CSV Hybrid mode processing...", "📊 CSV 混合模式轉換處理中...", "📊 CSV 混合模式转换处理中..."), 1);
            } else {
                ShowTip(_L("⚡ CSV Bulk mode processing...", "⚡ CSV 批次模式轉換處理中...", "⚡ CSV 批次模式转换处理中..."), 1);
            }

            try {
                Redraw = false;

                for (let b = 0; b < blocks.length; b++) {
                    let block = blocks[b];

                    if (!block.isRegular) {
                        // 【不規則區塊】Surgical Mode
                        let pendingCells = [];
                        for (let r = block.topRow; r <= block.bottomRow; r++) {

                            if (r % Math.max(1, Math.floor(totalR / 20)) === 0) {
                                let progress = Math.round(((r - cTopRow) / totalR) * 99);
                                ShowTip(getMsgProcessing(progress), 1);
                            }

                            for (let c = cTopCol; c <= cBottomCol; c++) {
                                let cellText = "";
                                try { cellText = document.GetCell(r, c, 0); } catch(e) { continue; }

                                if (cellText) {
                                    if (cellText.length > 25000000) {
                                        status = "";
                                        alert(_L("⚠️ Selection contains a giant cell. Conversion aborted.", "⚠️ 選取範圍包含超過 50MB 的巨型儲存格，已中止轉換作業。", "⚠️ 选取范围包含超过 50MB 的巨型单元格，已中止转换程序。"));
                                        Quit();
                                    }
                                    let res = doConvert(cellText);
                                    if (res.count > 0) {
                                        pendingCells.push({ r: r, c: c, text: res.text, count: res.count });
                                    }
                                }
                            }
                        }
                        for (let i = 0; i < pendingCells.length; i++) {
                            let item = pendingCells[i];
                            try {
                                if (!isSimulate) {
                                    document.SetCell(item.r, item.c, item.text, 0);
                                }
                                totalReplaced += item.count;
                            } catch(e) {}
                        }
                    } else {
                        // 【規則區塊】Bulk Mode
                        try {
                            document.selection.SetAnchorPoint(eePosCell, cTopCol, block.topRow);
                            document.selection.SetActivePoint(eePosCell, cBottomCol, block.bottomRow, true);
                            let bText = document.selection.Text;

                            if (bText && bText.length > 150000000) {
                                status = "";
                                alert(_L("⚠️ Selection contains a giant chunk (> 300MB). Conversion aborted.", "⚠️ 選取範圍包含超過 300MB 的單一巨型資料區塊，已中止轉換作業。", "⚠️ 选取范围包含超过 300MB 的单一巨型数据区块，已中止转换程序。"));
                                Quit();
                            }

                            if (bText) {

                                let hasTrailingNewline = /[\r\n]$/.test(bText);
                                let res = doConvert(bText);
                                if (res.count > 0) {
                                    let outText = res.text;

                                    let outTrailing = /[\r\n]$/.test(outText);
                                    if (hasTrailingNewline && !outTrailing) outText += "\n";
                                    else if (!hasTrailingNewline && outTrailing) outText = outText.replace(/[\r\n]$/, "");

                                    if (!isSimulate) {
                                        document.selection.Text = outText;
                                    }
                                    totalReplaced += res.count;
                                }
                            }
                        } catch(e) {}
                    }
                }
            } finally {
                Redraw = true;
                try {
                    document.selection.SetAnchorPoint(eePosCell, anchorX, anchorY);
                    document.selection.SetActivePoint(eePosCell, activeX, activeY, true);
                } catch(e) {}
                ShowTip("", eeShowTipHide);
            }

        } else if (isFilterMode) {
            let blocks = [];
            if (isVerticalSel && selCount === 1) {
                let minX = Math.min(topX, bottomX);
                let maxX = Math.max(topX, bottomX);
                for (let y = topY; y <= bottomY; y++) {
                    blocks.push({
                        ty: y, tx: minX, by: y, bx: maxX
                    });
                }
            } else if (isMultiSel) {
                for (let i = 1; i <= selCount; i++) {
                    try {
                        blocks.push({
                            ty: document.selection.GetTopPointY(eePosLogical, i),
                            tx: document.selection.GetTopPointX(eePosLogical, i),
                            by: document.selection.GetBottomPointY(eePosLogical, i),
                            bx: document.selection.GetBottomPointX(eePosLogical, i)
                        });
                    } catch(e) {}
                }
            } else {
                blocks.push({ ty: topY, tx: topX, by: bottomY, bx: bottomX });
            }

            let pendingWrites = [];
            for (let c = 0; c < blocks.length; c++) {
                let b = blocks[c];
                for (let y = b.ty; y <= b.by; y++) {
                    let lineStr = document.GetLine(y); 
                    let lineLen = lineStr.length; 
                    let startX = (y === b.ty) ? b.tx : 1;
                    let endX = (y === b.by) ? b.bx : (lineLen + 1);

                    if (startX > lineLen + 1) startX = lineLen + 1;
                    if (endX > lineLen + 1) endX = lineLen + 1;
                    if (startX >= endX) continue;

                    let textToProcess = lineStr.substring(startX - 1, endX - 1);
                    if (!textToProcess) continue;

                    if (textToProcess.length > 25000000) {
                        status = "";
                        alert(_L("⚠️ Selection contains a giant single line (> 50MB). Conversion aborted.", "⚠️ 選取範圍包含超過 50MB 的單一巨型資料行，為防止記憶體溢位，已中止轉換作業。", "⚠️ 选取范围包含超过 50MB 的单一巨型数据行，为防止内存溢出，已中止转换程序。"));
                        Quit();
                    }

                    let res = doConvert(textToProcess);
                    if (res.count > 0) pendingWrites.push({ y: y, startX: startX, endX: endX, text: res.text, count: res.count });
                }
            }

            pendingWrites.sort(function(a, b) {
                if (b.y !== a.y) return b.y - a.y;
                return b.startX - a.startX;
            });

            let totalW = pendingWrites.length;
            for (let w = 0; w < totalW; w++) {
                if (w % Math.max(1, Math.floor(totalW / 9)) === 0) {
                    ShowTip(getMsgProcessing(Math.round(((w + 1) / totalW) * 99)), 1);
                }
                let item = pendingWrites[w];
                try {
                    document.selection.SetActivePoint(eePosLogical, item.startX, item.y);
                    if (document.selection.GetActivePointY(eePosLogical) === item.y) {
                        document.selection.SetActivePoint(eePosLogical, item.endX, item.y, true);
                        // 判斷是否寫入
                        if (!isSimulate) {
                            document.selection.Text = item.text;
                        }
                        totalReplaced += item.count;
                    }
                } catch(e) {}
            }
            ShowTip("", eeShowTipHide);

        } else if (isMultiSel) {
            let multiBlocks = [];

            if (isVerticalSel && selCount === 1) {
                let minX = Math.min(topX, bottomX);
                let maxX = Math.max(topX, bottomX);
                for (let y = topY; y <= bottomY; y++) {
                    multiBlocks.push({ ty: y, tx: minX, by: y, bx: maxX });
                }
            } else {
                for (let i = 1; i <= selCount; i++) {
                    try {
                        multiBlocks.push({
                            ty: document.selection.GetTopPointY(eePosLogical, i),
                            tx: document.selection.GetTopPointX(eePosLogical, i),
                            by: document.selection.GetBottomPointY(eePosLogical, i),
                            bx: document.selection.GetBottomPointX(eePosLogical, i)
                        });
                    } catch (e) {}
                }
            }
            multiBlocks.reverse();

            let totalM = multiBlocks.length;
            for (let i = 0; i < totalM; i++) {
                if (i % Math.max(1, Math.floor(totalM / 9)) === 0) {
                    ShowTip(getMsgProcessing(Math.round(((i + 1) / totalM) * 99)), 1);
                }
                let b = multiBlocks[i];
                try {
                    document.selection.SetActivePoint(eePosLogical, b.tx, b.ty);
                    document.selection.SetActivePoint(eePosLogical, b.bx, b.by, true);
                    let srcText = document.selection.Text;
                    if (!srcText) continue;

                    if (srcText.length > 25000000) {
                        status = "";
                        alert(_L("⚠️ Selection contains a giant chunk (> 50MB). Conversion aborted.", "⚠️ 選取範圍包含超過 50MB 的單一巨型資料區塊，為防止記憶體溢位，已中止轉換作業。", "⚠️ 选取范围包含超过 50MB 的单一巨型数据区块，为防止内存溢出，已中止转换程序。"));
                        Quit();
                    }

                    let res = doConvert(srcText);
                    if (res.count > 0) {
                        // 判斷是否寫入
                        if (!isSimulate) {
                            document.selection.Text = res.text;
                        }
                        totalReplaced += res.count;
                    }
                } catch (e) { continue; }
            }
            ShowTip("", eeShowTipHide);

        } else {
            const totalChunks = chunks.length;
            // 從第一個 chunk 算出初始步長，確保不報錯且支援變速
            let v8Step = (totalChunks > 0) ? (chunks[0].bottomY - chunks[0].topY + 1) : 1;

            for (let c = 0; c < totalChunks; c++) {
                let chunk = chunks[c];
                let subTopY = chunk.topY;

                // 增加 while 以支援降檔分段
                while (subTopY <= chunk.bottomY) {
                    let progress = Math.round(((c + 1) / totalChunks) * 99);
                    ShowTip(getMsgProcessing(progress), 1);

                    // 決定本次處理的終點
                    let subBottomY = (txtlen > 0) ? Math.min(subTopY + v8Step - 1, chunk.bottomY) : chunk.bottomY;

                    // --- 定位選取區 (維持原本 isFirst/isLast 邏輯) ---
                    if (chunk.isFirst && subTopY === chunk.topY) {
                        document.selection.SetActivePoint(eePosLogical, topX, subTopY);
                    } else {
                        document.selection.SetActivePoint(eePosLogical, 1, subTopY);
                    }

                    if (chunk.isLast && subBottomY === chunk.bottomY) {
                        document.selection.SetActivePoint(eePosLogical, bottomX, subBottomY, true);
                    } else {
                        document.selection.SetActivePoint(eePosLogical, 1, subBottomY + 1, true);
                    }

                    // --- V8 變速降檔邏輯 (僅針對有 TextLength 版本) ---
                    if (txtlen > 0) {
                        let currentLen = document.selection.TextLength;
                        // 🛑 降檔：若遇到大爬坡，將 v8Step 減半並重新選取
                        while (currentLen > 80000000 && subBottomY > subTopY) {
                            v8Step = Math.floor(v8Step / 2) || 1;
                            subBottomY = subTopY + v8Step - 1;

                            if (chunk.isLast && subBottomY === chunk.bottomY) {
                                document.selection.SetActivePoint(eePosLogical, bottomX, subBottomY, true);
                            } else {
                                document.selection.SetActivePoint(eePosLogical, 1, subBottomY + 1, true);
                            }
                            currentLen = document.selection.TextLength;
                        }
                        // 🟢 升檔：路況好就嘗試翻倍，但不超過初始塊的大小 (baseStep)
                        let baseStep = chunks[0].bottomY - chunks[0].topY + 1;
                        if (currentLen < 40000000 && v8Step < baseStep) {
                            v8Step = Math.min(baseStep, v8Step * 2);
                        }
                    }

                    let srcText = "";
                    try {
                        srcText = document.selection.Text;
                    } catch (e) {
                        status = "";
                        alert(_L(`❌ Crash at chunk ${c + 1}.`, `❌ 第 ${c + 1} 區塊失敗。`, `❌ 第 ${c + 1} 区块失败。`));
                        Quit();
                    }
                    if (!srcText) {
                        if (txtlen > 0) { subTopY = subBottomY + 1; continue; }
                        else break;
                    }

                    // 🌟 50MB 單行攔截
                    if (srcText.length > 25000000 && subTopY === subBottomY) {
                        status = "";
                        alert(_L("⚠️ Selection contains a giant single line (> 50MB). Conversion aborted.", "⚠️ 選取範圍包含超過 50MB 的單一巨型資料行，為防止記憶體溢位，已中止轉換作業。", "⚠️ 选取范围包含超过 50MB 的单一巨型数据行，为防止内存溢出，已中止转换程序。"));
                        Quit();
                    }

                    let res = doConvert(srcText);
                    if (res.count > 0) {
                        try {
                            if (!isSimulate) {
                                document.selection.Text = res.text;
                                if (chunk.isLast && subBottomY === chunk.bottomY) {
                                    realBottomX = document.selection.GetActivePointX(eePosLogical);
                                    realBottomY = document.selection.GetActivePointY(eePosLogical);
                                }
                            }
                            totalReplaced += res.count;
                        } catch (e) {
                            status = "";
                            alert(_L("Memory error.", "寫入時發生記憶體問題。", "写入时发生内存問題。"));
                            Quit();
                        }
                    }

                    srcText = null; res = null;

                    // 推進座標
                    if (txtlen > 0) {
                        subTopY = subBottomY + 1;
                    } else {
                        break; 
                    }
                }
            }
            ShowTip("", eeShowTipHide);
        }

        if (!isCSVCellSel) {
            if (!isFilterMode && !isMultiSel) {
                document.selection.SetAnchorPoint(eePosLogical, topX, topY);
                document.selection.SetActivePoint(eePosLogical, realBottomX, realBottomY, true);
            } else {
                document.selection.SetActivePoint(eePosLogical, topX, topY);
            }
        }

    } finally {
        try { CombineHistory = bOrgCombine; } catch(e) {} 
        Sleep(60);
        try { Redraw = true; } catch(e) {}

        // 若為模擬模式，不執行 CSV 的介面重繪
        if (!isSimulate && totalReplaced > 0 && !isCSVCellSel && document.Csv && document.Csv.Delimiter !== "") {
            editor.ExecuteCommandByID(3967);
            editor.ExecuteCommandByID(3967);
            shell.SendKeys( "{LEFT}" ); 
            shell.SendKeys( "{RIGHT}" ); 
        }

        finalDict.clear();
    }

    // 6. 收尾與計時
    const endTime = Date.now();
    const elapsedSeconds = ((endTime - startTime) / 1000).toFixed(2);

    if (totalReplaced > 0) {
        status = getMsgSuccess(totalReplaced, elapsedSeconds); 

        // 模擬模式下：啟動比對引擎輸出至 WebBar
        if (isSimulate && initialText) {
            let macroResult = "";
            if (initialText.length <= 200) {
                macroResult = doConvert(initialText).text;
            }
            if (typeof compareWithGoogle === "function") {
                compareWithGoogle(initialText, macroResult, currentModeNames);
            }
        }
    } else {
        status = _L(
            `ℹ️ No text requiring changes was found, so no conversion was made (${elapsedSeconds} s).`, 
            `ℹ️ 內容未包含需要變更的文字，未執行 ${msgModeNameTC} 轉換 (耗時 ${elapsedSeconds} 秒)`, 
            `ℹ️ 内容未包含需要变更的文字，未执行 ${msgModeNameSC} 转换 (耗时 ${elapsedSeconds} 秒)`
        );

        if (isSimulate && initialText) {
                alert(_L(
                    `ℹ️ No text requiring changes was found, no ${msgModeNameEN} simulation was made, online translation comparison were skipped.`,
                    `ℹ️ 內容未包含需要變更的文字，未執行 ${msgModeNameTC} 模擬，已略過線上翻譯比對。`,
                    `ℹ️ 内容未包含需要变更的文字，未执行 ${msgModeNameSC} 模拟，已略过在线翻译对比。`
                ));
        }
    }
}

main();