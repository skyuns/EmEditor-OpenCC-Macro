        }
        actualNextIdx = segmentIdx;
    }

    out.push(srcText.substring(i, actualNextIdx) + "/");
    replaceCount++;
    lastMatchEnd = actualNextIdx;
    i = actualNextIdx;
    continue; 
}

                wordLen = nextIdx - i;
                let firstCode = srcText.charCodeAt(i);

                if (firstCode < fastSkipLimit) {
                    i = nextIdx;
