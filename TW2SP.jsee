                        let score = wordFreq + dictBonus + freqBonus + penalty + extraWeight + nxtScore;

                        if (score > bestScore) {
                            bestScore = score;
                            bestNext = j + 1;
                        }
                    }
                    j++;
                    if (j < textLen) {
                        currNode = currNode.c ? (currNode.c.get ? currNode.c.get(srcText.charCodeAt(j)) : currNode.c[srcText.charCodeAt(j)]) : null;
                        if (!currNode) break;
                    }
                }
                routeScore[idx] = bestScore;
                routeNext[idx] = bestNext;
