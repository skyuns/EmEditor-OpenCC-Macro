        const FREQ_BONUS_EPIC = 7.0; // 2001~3000次
        const FREQ_BONUS_ELITE = 5.0; // 1001~2000次
        const FREQ_BONUS_HIGH = 3.5; // 101~1000次
        const FREQ_BONUS_MID = 2.0; // 11~100次
        const FREQ_BONUS_LOW = 0.5; // 4~10次
        const FREQ_BONUS_FEW = 0.1; // 1~3次

        const ONE_TO_MANY_S2T = "㐹万丑个丰了于云亘仆仇仑价仿伙余佛佣俊修借僵克党冬冲凄准凌几凶出划别刮制勋千升卜占卤卷厂历厘参发只台叶叹吁吃合吊同后向周咨咸咽哄哗唇啮喂噪回团困坛坝埙复夫夸奸姜娘娴宁它家尝尸尽局岩岳巨布帘席干并幸广庵弥弦当录彩征御志念恤恶愈愿戚才扎托扣折抵拐挂挨挽据搜摆斗旋昆暗曲术朱朴杆杠杯杰松板极柜栗核梁欲毁汇沈沾泛注涂涌淀游滟漓炼烟熏玩璇症皂矩确私秋种筑签系纤绱绷胄背胜胡脏腊腌膻致舍艳芸苏苔苹范荐荡荫药获蒙蔑虫蚝蜡蝎表袅裥证谥谷赝赞跖辟迹适郁酸采里鉴针钟钥钫钻铲链锫镋镎镢镰闲雕面须饥鹇洒虱湿袜";
        const ONE_TO_MANY_T2S = "乾儘剋劃噁噹夥崙廬彷徵戰擣於瀋瀰牴畫瞭祇綵線薹藉蘋衹襬覆託諫諮譾買鉅鍊鍾鏇钁開閒阪靦韝願餘餬餱餵驄鵰麪麴麵麼麽齧";

        const isOneToManyArr = new Uint8Array(65536);
        const targetOneToManyList = (CURRENT_MODE === "S2T" || CURRENT_MODE === "S2TE") ? ONE_TO_MANY_S2T : ONE_TO_MANY_T2S;

        for (let k = 0; k < targetOneToManyList.length; k++) {
            isOneToManyArr[targetOneToManyList.charCodeAt(k)] = 1;
        }

// PhraseLogic 檢查邏輯
const checkPhraseLogic = (idx) => {
    if (typeof isSegmentDisplay !== "undefined" && isSegmentDisplay) return false;
    if (!effectiveContextLogic && !effectiveContextLogic_T2S) return false;
    let maxKeyLen = 0;
    let foundRule = null;
    let currentKey = "";
    for (let pKey in PhraseLogic) {
        let kLen = pKey.length;
        if (idx + kLen <= textLen && srcText.substring(idx, idx + kLen) === pKey) {
            if (kLen > maxKeyLen) { maxKeyLen = kLen; foundRule = PhraseLogic[pKey]; currentKey = pKey; }
        }
    }
    if (foundRule === null) return false;

    let leftStart = Math.max(0, idx - 6);
    let leftWindow = srcText.substring(leftStart, idx);
    let rightEnd = Math.min(textLen, idx + maxKeyLen + 6);
    let rightWindow = srcText.substring(idx + maxKeyLen, rightEnd);
    let partsOpen = foundRule.split("[");
    let alternatives = partsOpen[0].split(" ");
    let overTarget = alternatives[1] || alternatives[0];
    let leftTags = partsOpen[1].split("]")[0].split("|");
    let rightTags = partsOpen[2].split("]")[0].split("|");
    let isTriggered = false;

    // 向左比對
    for (let t = 0; t < leftTags.length; t++) { 
        let tag = leftTags[t];
        if (tag !== "") {
            if (tag.charAt(0) === "!") {
                if (leftWindow.indexOf(tag.substring(1)) !== -1) { return false; }
            } else {
                if (leftWindow.indexOf(tag) !== -1) { isTriggered = true; }
            }
        } 
    }

    // 向右比對
    for (let t = 0; t < rightTags.length; t++) { 
        let tag = rightTags[t];
        if (tag !== "") {
            if (tag.charAt(0) === "!") {
                if (rightWindow.indexOf(tag.substring(1)) !== -1) { return false; }
            } else {
                if (rightWindow.indexOf(tag) !== -1) { isTriggered = true; }
            }
        } 
    }
    
    if (isTriggered) {
        if (idx > lastMatchEnd) { out.push(srcText.substring(lastMatchEnd, idx)); }
        out.push(overTarget); replaceCount++; lastMatchEnd = idx + maxKeyLen;
        i = idx + maxKeyLen;
        return true;
    }
