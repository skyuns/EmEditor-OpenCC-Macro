                }

                let originalWord = srcText.substring(i, nextIdx);
                let openccTarget = null;
                let node = rootNodes[firstCode];

                if (node) {
                    if (wordLen === 1) {
                        if (hasLogic) {
                            let hook = activeLogicArr[firstCode];
                            if (hook !== undefined) {
                                let logicResult = hook(i, srcText); 
                                if (logicResult !== null) openccTarget = logicResult;
                            }
                        }
                        if (openccTarget === null && node.v !== null) {
                            openccTarget = node.v;
                        }
                    } else {
                        let currNode = node;
                        for (let k = 1; k < wordLen; k++) {
                            currNode = currNode.c ? (currNode.c.get ? currNode.c.get(srcText.charCodeAt(i + k)) : currNode.c[srcText.charCodeAt(i + k)]) : null;
                            if (!currNode) break;
                        }
                        if (currNode && currNode.v !== null) openccTarget = currNode.v;
                    }
                }

                let finalTarget = "";
                if (openccTarget !== null) {
                    finalTarget = openccTarget;
                } else {
                    let subK = 0;
                    while (subK < wordLen) {
                        let currentIdx = i + subK;
                        let code = srcText.charCodeAt(currentIdx);
                        let char = srcText.charAt(currentIdx);
                        let longestMatchLen = 0;
                        let longestMatchTarget = null;

                            let curr = rootNodes[code];
                            if (curr !== undefined && curr !== null) {
                                if (curr.v !== null) { 
                                    longestMatchLen = 1; 
                                    longestMatchTarget = curr.v; 
                                }
                                let scan = 1;
                                let temp = curr;
                                while (subK + scan < wordLen) {
                                    let nextCode = srcText.charCodeAt(currentIdx + scan);
                                    temp = temp.c ? (temp.c.get ? temp.c.get(nextCode) : temp.c[nextCode]) : null;
                                    if (!temp) break;
                                    if (temp.v !== null) {
                                        longestMatchLen = scan + 1;
                                        longestMatchTarget = temp.v;
                                    }
                                    scan++;
                                }
                            }

                        if (longestMatchLen <= 1 && hasLogic) {
