// --- [##新增] Google 翻譯與巨集比對引擎 ---
async function compareWithGoogle(origText, macroText, modeNames) {
    shell.KeepRunning = true;

    const langId = editor.LangID;
    const _L = (en, tc, sc) => {
        if (langId === 1028) return tc;
        if (langId === 2052) return sc;
        return en;
    };

    let lblSimMode = _L("✨ Simulation Comparison Mode ✨", "✨ 模擬比對模式 ✨", "✨ 模拟比对模式 ✨");
    let apiErrorMsg = _L("❌ Temporarily unable to connect", "❌ 暫時無法連線", "❌ 暂时无法连线");

    // 第一次按 Ctrl 且網頁未開啟時：初始化 WebBar
    if (!WebBar.Visible) {
        let waitDesc = _L("Please run the macro again to display the results.", "請再次執行巨集以顯示比對結果。", "请再次执行宏以显示对比结果。");
        
        var waitHtml = `<!DOCTYPE html><html><body style='font-family:Segoe UI, sans-serif; display:flex; justify-content:center; align-items:center; height:100vh; background:#f4f4f4; margin:0;'><div style='text-align:center; padding:30px; background:#fff; border-radius:10px; box-shadow:0 4px 15px rgba(0,0,0,0.1);'><h2 style='color:#0275d8; margin-top:0;'>${lblSimMode}</h2><p style='color:#555; font-size:16px; margin-bottom:0;'>${waitDesc}</p></div></body></html>`;
        var dataUrl = "data:text/html;charset=utf-8," + encodeURIComponent(waitHtml);
        
        WebBar.Open(dataUrl);
        shell.KeepRunning = false;
        return;
    }

    try {
        if (origText.length > 200) {
            let limitMsg = _L(
                "⚠️ Selection exceeds 200 characters limit (" + origText.length + " chars). Google translation comparison skipped.\n",
                "⚠️ 選取字數為 " + origText.length + " 字，超過 200 字上限，已跳過 Google 翻譯比對。\n",
                "⚠️ 选取字数为 " + origText.length + " 字，超过 200 字上限，已跳过 Google 翻译对比。\n"
            );
            openInWebBar(limitMsg);
            return;
        }

        let targetLang = (CURRENT_MODE === "T2S" || CURRENT_MODE === "TW2SP") ? "zh-CN" : "zh-TW";
        let sourceLang = (CURRENT_MODE === "T2S" || CURRENT_MODE === "TW2SP") ? "zh-TW" : "zh-CN";

        function computeDiff(oldStr, newStr) {
            var oldChars = Array.from(oldStr), newChars = Array.from(newStr);
            var m = oldChars.length, n = newChars.length;
            var dp = Array(m + 1).fill(null).map(function() { return Array(n + 1).fill(0); });
            
            for (var i = 1; i <= m; i++) {
                for (var j = 1; j <= n; j++) {
                    if (oldChars[i - 1] === newChars[j - 1]) dp[i][j] = dp[i - 1][j - 1] + 1;
                    else dp[i][j] = Math.max(dp[i - 1][j], dp[i][j - 1]);
                }
            }

            var ops = [], x = m, y = n;
            while (x > 0 || y > 0) {
                if (x > 0 && y > 0 && oldChars[x - 1] === newChars[y - 1]) {
                    ops.push({ type: 'equal', text: oldChars[x - 1] }); x--; y--;
                } else if (y > 0 && (x === 0 || dp[x][y - 1] >= dp[x - 1][y])) {
                    ops.push({ type: 'insert', text: newChars[y - 1] }); y--;
                } else {
                    ops.push({ type: 'delete', text: oldChars[x - 1] }); x--;
                }
            }
            return ops.reverse();
        }

        function trimEveryLine(text) {
            var lines = text.split('\n');
            for (var i = 0; i < lines.length; i++) {
                lines[i] = lines[i].replace(/^[ \t\u3000]+|[ \t\u3000]+$/g, '');
            }
            return lines.join('\n');
        }

        function escapeHTML(str) {
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        let googleText = "";
        try {
            const url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=${sourceLang}&tl=${targetLang}&dt=t&q=${encodeURIComponent(origText)}`;
            const response = await fetch(url);
            
            if (!response.ok) {
                googleText = apiErrorMsg;
            } else {
                const data = await response.json();
                if (data && data[0]) {
                    for (const item of data[0]) {
                        if (item[0]) googleText += item[0];
                    }
                }
            }
        } catch (e) {
            googleText = apiErrorMsg;
        }

        var normOrig = origText.replace(/\r\n/g, "\n").replace(/\r/g, "\n");
        var normMacro = macroText.replace(/\r\n/g, "\n").replace(/\r/g, "\n");
        var normGoogle = googleText.replace(/\r\n/g, "\n").replace(/\r/g, "\n");
        
        var globalTrimRegex = /^[\s\u3000]+|[\s\u3000]+$/g;
        var globalOrig = normOrig.replace(globalTrimRegex, '');
        var globalMacro = normMacro.replace(globalTrimRegex, '');
        
        var globalGoogle = (googleText === apiErrorMsg) ? apiErrorMsg : normGoogle.replace(globalTrimRegex, '');
        
        var origTrimmed = trimEveryLine(globalOrig);
        var macroTrimmed = trimEveryLine(globalMacro);
        var googleTrimmed = (googleText === apiErrorMsg) ? apiErrorMsg : trimEveryLine(globalGoogle);
        
        var strippedCount = normOrig.length - origTrimmed.length;

        var diffsOM = computeDiff(origTrimmed, macroTrimmed);
        var macroColor = new Array(macroTrimmed.length).fill('black');
        var m_idx = 0;
        
        for (var i = 0; i < diffsOM.length; i++) {
            var dOM = diffsOM[i];
            if (dOM.type === 'equal') {
                m_idx += dOM.text.length; 
            } else if (dOM.type === 'insert') {
                for (var j = 0; j < dOM.text.length; j++) {
                    macroColor[m_idx++] = 'blue'; 
                }
            }
        }

        var googleColor = new Array((googleTrimmed === apiErrorMsg) ? 0 : googleTrimmed.length).fill('black');
        var diffCount = 0, delTemp = 0, insTemp = 0;

        if (googleText !== apiErrorMsg) {
            var diffsMG = computeDiff(macroTrimmed, googleTrimmed);
            m_idx = 0;
            var g_idx = 0;

            for (var i = 0; i < diffsMG.length; i++) {
                var dMG = diffsMG[i];
                if (dMG.type === 'equal') {
                    diffCount += Math.max(delTemp, insTemp);
                    delTemp = 0; insTemp = 0;

                    for (var j = 0; j < dMG.text.length; j++) {
                        googleColor[g_idx++] = macroColor[m_idx];
                        m_idx++;
                    }
                } else if (dMG.type === 'insert') {
                    insTemp += dMG.text.length;
                    for (var j = 0; j < dMG.text.length; j++) {
                        googleColor[g_idx++] = 'red';
                    }
                } else if (dMG.type === 'delete') {
                    delTemp += dMG.text.length;
                    for (var j = 0; j < dMG.text.length; j++) {
                        macroColor[m_idx++] = 'red';
                    }
                }
            }
            diffCount += Math.max(delTemp, insTemp);
        }

        function buildColoredHTML(text, colors) {
            var html = "";
            var currentColor = null;
            var currentSpan = "";

            for (var i = 0; i < text.length; i++) {
                var char = escapeHTML(text[i]);
                var color = colors[i];

                if (color !== currentColor) {
                    if (currentColor !== null) {
                        if (currentColor === 'black') html += currentSpan;
                        else html += `<span class="c-${currentColor}">${currentSpan}</span>`;
                    }
                    currentColor = color;
                    currentSpan = char;
                } else {
                    currentSpan += char;
                }
            }
            if (currentColor !== null) {
                if (currentColor === 'black') html += currentSpan;
                else html += `<span class="c-${currentColor}">${currentSpan}</span>`;
            }
            return html;
        }

        var macroHTML = buildColoredHTML(macroTrimmed, macroColor);
        var googleHTML = (googleText === apiErrorMsg) 
            ? `<span style="color:#d9534f; font-weight:bold;">${apiErrorMsg}</span>` 
            : buildColoredHTML(googleTrimmed, googleColor);

        var strippedMsg = "";
        if (strippedCount > 0) {
            strippedMsg = _L(
                `, removed ${strippedCount} leading/trailing spaces`, 
                `，刪除頭尾空白 ${strippedCount} 個`, 
                `，删除头尾空白 ${strippedCount} 个`
            );
        }
        
        var summaryText = _L(
            `📊 Total selected: ${origText.length} chars. Macro vs Google diff: ${diffCount} chars${strippedMsg}.`,
            `📊 總共選取 ${origText.length} 字，巨集與 Google 翻譯差異 ${diffCount} 字${strippedMsg}。`,
            `📊 总共选取 ${origText.length} 字，宏与 Google 翻译差异 ${diffCount} 字${strippedMsg}。`
        );

        let lblOrig = _L("Original Text", "原文內容", "原文内容");
        let lblMacro = _L(`Macro Conversion (${modeNames.EN})`, `巨集轉換 (${modeNames.TC})`, `宏转换 (${modeNames.SC})`);
        let lblGoogle = _L("Reference Translation (Google)", "參考翻譯 (Google)", "参考翻译 (Google)");
        let pageTitle = _L("Translation Comparison", "翻譯轉換對照", "翻译转换对比");

        let footerHtml = "";
        if (typeof Simulator_MODE !== "undefined" && Simulator_MODE === false) {
            let lblFooter = _L(
                "💡 Tip: Hold Ctrl and click the Macro Button to trigger Simulation Mode.",
                "💡 提示：按住 Ctrl 鍵並點擊「巨集按鈕」即可觸發模擬比對模式。",
                "💡 提示：按住 Ctrl 键并点击「宏按钮」即可触发模拟比对模式。"
                
            );
            footerHtml = `<div class="footer-hint">${lblFooter}</div>`;
        }

        const htmlContent = `<!DOCTYPE html>
<html>
<head>
<meta charset='utf-8'>
<title>${pageTitle}</title>
<style>
  body { 
      font-family: 'Segoe UI', 'Microsoft JhengHei', sans-serif; 
      padding: 20px; 
      background-color: #f7f9fc; 
      margin: 0;
  }
  .sim-header {
      text-align: center;
      color: #0275d8;
      font-weight: bold;
      font-size: 18px;
      margin-bottom: 20px;
      border-bottom: 2px solid #0275d8;
      padding-bottom: 10px;
      letter-spacing: 2px;
  }
  .block {
      background: #fff;
      padding: 15px 20px;
      margin-bottom: 15px;
      border-radius: 8px;
      border-left: 5px solid #ccc;
      box-shadow: 0 2px 5px rgba(0,0,0,0.05);
  }
  
  .block-orig { border-left-color: #af7ac5; }
  .block-orig .label { color: #8e44ad; }
  
  .block-macro { border-left-color: #58d68d; }
  .block-macro .label { color: #27ae60; }
  
  .block-google { border-left-color: #5dade2; }
  .block-google .label { color: #2980b9; }
  
  .header-row {
      margin-bottom: 8px;
  }
  .label {
      font-size: 14px;
      letter-spacing: 1px;
      margin: 0;
  }
  
  pre { 
      font-family: inherit; 
      font-size: 16px;
      line-height: 1.6;
      white-space: pre-wrap;
      word-wrap: break-word;
      margin: 0;
      color: #333;
  }
  
  .c-blue { color: #0275d8; font-weight: bold; }
  .c-red { color: #d9534f; font-weight: bold; border-bottom:1px #f5c2c7 solid;}
  
  .summary {
      margin-top: 20px;
      font-size: 15px;
      color: #555;
      font-weight: bold;
      text-align: center;
  }
  .footer-hint {
      margin-top: 25px;
      font-size: 14px;
      color: #666;
      background: #eef2f7;
      padding: 12px;
      border-radius: 6px;
      border: 1px dashed #cbd5e0;
      text-align: center;
  }
</style>
</head>
<body>
  <div class="sim-header">${lblSimMode}</div>

  <div class="block block-orig">
    <div class="header-row">
        <div class="label">${lblOrig}</div>
    </div>
    <pre>${escapeHTML(origTrimmed)}</pre>
  </div>

  <div class="block block-macro">
    <div class="header-row">
        <div class="label">${lblMacro}</div>
    </div>
    <pre>${macroHTML}</pre>
  </div>

  <div class="block block-google">
    <div class="header-row">
        <div class="label">${lblGoogle}</div>
    </div>
    <pre>${googleHTML}</pre>
  </div>

  <div class="summary">
    ${summaryText}
  </div>

  ${footerHtml}
</body>
</html>`;

        openInWebBar(htmlContent);

    } catch (e) {
        let errTitle = _L("❌ Script error: ", "❌ 腳本錯誤: ", "❌ 脚本错误: ");
        openInWebBar(`${errTitle}${e.message}`);
    } finally {
        shell.KeepRunning = false;
    }

    function openInWebBar(htmlString) {
        if (!htmlString.startsWith("<!DOCTYPE html>")) {
            htmlString = `<!DOCTYPE html><html><body style="padding:20px;font-family:sans-serif;">${htmlString}</body></html>`;
        }
        try {
            WebBar.SetFocus();
            
            let safeHTML = htmlString;
            try {
                if (web.window.trustedTypes && web.window.trustedTypes.createPolicy) {
                    const policy = web.window.trustedTypes.createPolicy('default', { createHTML: s => s });
                    safeHTML = policy.createHTML(htmlString);
                }
            } catch(e) {}

            web.document.open();
            web.document.write(safeHTML);
            web.document.close();
        } catch(err) {
            OutputBar.Clear();
            let outErr = _L("WebBar display failed: ", "WebBar 顯示失敗: ", "WebBar 显示失败: ");
            OutputBar.writeln(outErr + err.message);
            OutputBar.Visible = true;
        }
    }
}

// --- [##核心邏輯區##] ---
function main() {
    // 0. 偵測外部是否開啟模擬模式 (智慧判定) 與 控制鍵狀態
    const isShiftPressed = (shell.GetKeyState(0x10) < 0); // 按住 Shift : 僅使用標準詞組與單字，忽略 [視界邏輯]、[語法邏輯]、[區塊 B：自訂擴充覆寫詞庫]、[區塊 D：台灣字形修正 (TWVariants.txt)]、[區塊 E：台灣字形修正例外清單]
    const isCtrlPressed = (shell.GetKeyState(0x11) < 0); // 按住 Ctrl : 使用模擬轉換模式
    const isAltPressed = (shell.GetKeyState(0x12) < 0); // 按住 Alt : 忽略 [區塊 D：台灣字形修正 (TWVariants.txt)]
    const isSimulate = (typeof Simulator_MODE !== "undefined" && Simulator_MODE === true) || isCtrlPressed;

    const isContextLogicReady = ContextLogic_MODE && !isShiftPressed;
    const effectiveContextLogic = isContextLogicReady && (CURRENT_MODE === "S2T" || CURRENT_MODE === "S2TE");
    const effectiveContextLogic_T2S = isContextLogicReady && CURRENT_MODE === "T2S";

    const isVisionLogicReady = VisionLogic_MODE && !isShiftPressed;
    const effectiveVisionLogic = isVisionLogicReady && (CURRENT_MODE === "S2T" || CURRENT_MODE === "S2TE");

    // 1. 動態模式與多國語言設定
    const langId = editor.LangID;
    const _L = (en, tc, sc) => {
        if (langId === 1028) return tc;
        if (langId === 2052) return sc;
        return en;
    };

    let msgModeNameTC = "", msgModeNameSC = "", msgModeNameEN = "";
    
    switch(CURRENT_MODE) {
        case "T2S":
            msgModeNameTC = "繁轉簡"; msgModeNameSC = "繁转简"; msgModeNameEN = "T2S"; break;
        case "S2T":
            msgModeNameTC = "簡轉繁"; msgModeNameSC = "简转繁"; msgModeNameEN = "S2T"; break;
        case "S2TE":
            msgModeNameTC = "簡轉繁: 擴充版"; msgModeNameSC = "简转繁: 扩充版"; msgModeNameEN = "S2T: Expanded"; break;
        case "S2TWP":
            msgModeNameTC = "用語轉換: 大陸 ➔ 台灣"; msgModeNameSC = "用语转换: 大陆 ➔ 台湾"; msgModeNameEN = "Terminology: CN->TW"; break;
        case "TW2SP":
            msgModeNameTC = "用語轉換: 台灣 ➔ 大陸"; msgModeNameSC = "用语转换: 台湾 ➔ 大陆"; msgModeNameEN = "Terminology: TW->CN"; break;
        default:
            msgModeNameTC = "文字"; msgModeNameSC = "文字"; msgModeNameEN = "Text"; break;
    }

    let currentModeNames = {
        TC: msgModeNameTC,
        SC: msgModeNameSC,
        EN: msgModeNameEN
    };

    const MSG_NO_TEXT = _L("No text selected.", "未選取文字", "未选中文本");

    const getMsgProcessing = (p) => {
    var steps = "▁▃▅▇";
    var fullStr  = "▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇";
    var trackStr = "▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁";
    var bar = "";

    // 進度條邏輯
    if (p >= 99) {
        bar = fullStr.substring(0, 19) + "▅"; 
    } else {
        var filledCount = Math.floor(p / 5);
        var remainder = p % 5;
        var stepIdx = Math.floor((remainder / 5) * 4);
        var tipChar = steps.charAt(stepIdx);
        bar = fullStr.substring(0, filledCount) + tipChar + trackStr.substring(0, 19 - filledCount);
    }

    var pStr = (p < 10) ? "0" + p : p;
    if (p >= 99) {
        return _L(
            `⏳ Integrating data, please wait... \n${bar} ${pStr}%`, 
            `⏳ ${msgModeNameTC} 資料整合中，請稍候... \n${bar} ${pStr}%`, 
            `⏳ ${msgModeNameSC} 数据整合中，请稍候... \n${bar} ${pStr}%`
        );
    }
    return _L(
        `⏳ Processing data, please wait... \n${bar} ${pStr}%`, 
        `⏳ ${msgModeNameTC} 資料處理中，請稍候... \n${bar} ${pStr}%`, 
        `⏳ ${msgModeNameSC} 数据处理中，请稍候... \n${bar} ${pStr}%`
    );
};

    const getMsgSuccess = (count, time) => {
        let ignoreTW = isAltPressed || isShiftPressed;

        let suffixTC = "";
        let suffixSC = "";
        let suffixEN = "";

        if (!ignoreTW) {
            if (CURRENT_MODE === "S2T" || CURRENT_MODE === "S2TE") {
                suffixTC = "已套用台灣字形，";
                suffixSC = "已套用台湾字形，";
                suffixEN = "TW variants applied, ";
            } else if (CURRENT_MODE === "T2S") {
                suffixTC = "台灣字形已反轉，";
                suffixSC = "台湾字形已反转，";
                suffixEN = "TW variants reversed, ";
            }
        }

        let logicActive = ContextLogic_MODE && !isShiftPressed;
        let logicTC = logicActive ? "已套用語法邏輯，" : "";
        let logicSC = logicActive ? "已套用语法逻辑，" : "";
        let logicEN = logicActive ? "Context logic applied, " : "";

        let visionActive = effectiveVisionLogic;
        let visionTC = visionActive ? "視界邏輯，" : "";
        let visionSC = visionActive ? "视界逻辑，" : "";
        let visionEN = visionActive ? "Vision Logic applied, " : "";

        if (isSimulate) {
            return _L(
                `✅ Conversion simulated (${msgModeNameEN}, ${suffixEN}${logicEN}${visionEN}${count} ops in ${time} s).`,
                `✅ 模擬運算完成 (${msgModeNameTC}，${suffixTC}${logicTC}${visionTC}共計 ${count} 處變更，耗時 ${time} 秒，未修改原文)`,
                `✅ 模拟运算完成 (${msgModeNameSC}，${suffixSC}${logicSC}${visionSC}共计 ${count} 处变更，耗时 ${time} 秒，未修改原文)`
            );
        } else {
            return _L(
                `✅ Conversion completed (${msgModeNameEN}, ${suffixEN}${logicEN}${visionEN}${count} ops in ${time} s).`,
                `✅ 轉換完成 (${msgModeNameTC}，${suffixTC}${logicTC}${visionTC}共取代 ${count} 處，耗時 ${time} 秒)`,
                `✅ 转换完成 (${msgModeNameSC}，${suffixSC}${logicSC}${visionSC}共替换 ${count} 处，耗时 ${time} 秒)`
            );
        }
    };

    const startTime = Date.now();

    // 2. 選取與防呆處理 (穩定版)
    let isCSVCellSel = false;

    try {
        if ((document.selection.Mode & 15) === 4) isCSVCellSel = true;
    } catch(e) {}

    let checkText = "";
    if (!isCSVCellSel && document.selection.IsEmpty) {
        try { 
            checkText = document.selection.Text; 
        } catch(e) {}
        
        if (checkText.length > 0) {
            isCSVCellSel = true;
        }
    }

    if (!isCSVCellSel && document.selection.IsEmpty) {
        document.selection.SelectWord();
        if (document.selection.IsEmpty) {
            alert(MSG_NO_TEXT); 
            Quit();
        }
    }

    const topY = document.selection.GetTopPointY(eePosLogical);
    const topX = document.selection.GetTopPointX(eePosLogical);
    const bottomY = document.selection.GetBottomPointY(eePosLogical);
    const bottomX = document.selection.GetBottomPointX(eePosLogical);
    let realBottomX = bottomX, realBottomY = bottomY;
    const selectedLines = bottomY - topY + 1;
    const selectedWidth = Math.abs(bottomX - topX);

    // --- [全域安全檢測] 偵測選取長度並格式化數字 ---
    status = _L(
        "⏳ Detecting selection size...", 
        "⏳ 正在檢測選取範圍大小...", 
        "⏳ 正在检测选取范围大小..."
    );

    let txtlen = -1;
    try { 
        txtlen = document.selection.TextLength; 
    } catch(e) {}

    const fmtN = (num) => num.toLocaleString('en-US');

    if (txtlen !== -1) {
        // A. 模擬模式攔截 (200 字元)
        if (isSimulate && txtlen > 200) {
            status = "";
                alert(_L(
                    "⚠️ Selection too large (Character count: " + fmtN(txtlen) + "). Simulation is aborted.",
                    "⚠️ 選取範圍過大 (字元數: " + fmtN(txtlen) + ")，已中止模擬模式。",
                    "⚠️ 选取范围过大 (字符数: " + fmtN(txtlen) + ")，已中止模拟模式。"
                ));
            Quit();
        }
        // B. 實際模式極限攔截 (1,500,000,000 字元)
        if (!isSimulate && txtlen > 1500000000) {
            status = "";
            alert(_L(
                "⚠️ Selection exceeds 1,500,000,000 characters. Due to architectural limits, conversion is aborted to protect memory and prevent crashes. \n\nPlease reduce the selection range and convert in segments.",
                "⚠️ 選取內容超過 1,500,000,000 字元。因架構問題，為保護系統記憶體避免當機，系統已攔截並中止轉換。\n\n建議縮小選取範圍，分段進行轉換。",
                "⚠️ 选取内容超过 1,500,000,000 字符。因架构问题，为保护系统内存避免当机，系统已拦截并中止转换。\n\n建议缩小选取范围，分段进行转换。"
            ));
            Quit();
        }
    } else {
        // C. 舊版相容模式：使用座標估算 (僅在模擬模式下攔截)
        if (isSimulate && (selectedLines > 50 || selectedWidth > 200)) {
            status = "";
                alert(_L(
                    "⚠️ Selection too large (Lines: " + fmtN(selectedLines) + ", Width: " + fmtN(selectedWidth) + "). Aborting simulation.",
                    "⚠️ 選取範圍過大 (行數: " + fmtN(selectedLines) + "，寬度: " + fmtN(selectedWidth) + ")，已中止模擬模式。",
                    "⚠️ 选取范围过大 (行数: " + fmtN(selectedLines) + "，宽度: " + fmtN(selectedWidth) + ")，已中止模拟模式。"
                ));
            Quit();
        }
    }

    let initialText = "";
    if (isSimulate) {
        try { initialText = document.selection.Text; } catch(e) {}
        
        if (initialText.length > 200) {
            status = "";
                alert(_L(
                    "⚠️ Selected character count is " + fmtN(initialText.length) + ", exceeding the 200-character limit.",
                    "⚠️ 選取字元數為 " + fmtN(initialText.length) + "，已超過模擬模式的 200 字元上限。",
                    "⚠️ 选取字符数为 " + fmtN(initialText.length) + "，已超过模拟模式的 200 字符上限。"
                ));
            Quit(); 
        }
    }

    if (!isCSVCellSel && selectedLines > 15000000) {
        status = "";
        alert(_L(
            "⚠️ Selected lines exceed 15,000,000 limit. Conversion aborted. Please reduce selection.",
            "⚠️ 選取總行數超過 1500 萬行，超出安全轉換限制。\n為避免系統無回應，請減少選取範圍後再試。",
            "⚠️ 选取总行数超过 1500 万行，超出安全转换限制。\n为避免系统无回应，请减少选取范围后再试。"
        ));
        Quit();
    }

    let isFilterMode = false;
    try {
        if (document.filters && document.filters.Count > 0) {
            isFilterMode = true;
        }
    } catch (e) {}

    let selCount = 1;
    let isMultiSel = false;
    let isVerticalSel = false; 

    try {
        if ((document.selection.Mode & 15) === 3) {
            isVerticalSel = true;
            isMultiSel = true; 
        }
    } catch(e) {}

    try {
        if (typeof document.selection.Count !== "undefined" && document.selection.Count > 1) {
            selCount = document.selection.Count;
            isMultiSel = true;
        }
    } catch(e) {}

    if (!isCSVCellSel && (isFilterMode || isMultiSel) && selectedLines > 5000) {
        status = "";
        alert(_L(
            "Selection exceeds 5000 lines limit for Filter/Multi-Select mode. Please reduce selection.",
            "⚠️ 篩選或多段選取模式下，選取範圍超過 5000 行限制。\n為避免系統無回應，請減少選取範圍後再試。",
            "⚠️ 筛选或多段选取模式下，选取范围超过 5000 行限制。\n为避免系统无回应，请减少选取范围后再试。"
        ));
        Quit();
    }

    // 3. 切塊邏輯 (動態智能切塊版)
    let chunks = [];
    if (!isCSVCellSel && !isFilterMode && !isMultiSel) {
        let numChunks = 1;

        if (txtlen > 0) {
            numChunks = Math.ceil(txtlen / 30000000);
        } else {
            if (selectedLines > 5000000) numChunks = 50;
            else if (selectedLines > 10000) numChunks = 20;
            else if (selectedLines > 2000) numChunks = 5;
        }

        let linesPerChunk = Math.ceil(selectedLines / numChunks);
        if (linesPerChunk < 1) linesPerChunk = 1;

        let currY = topY;
        while (currY <= bottomY) {
            let eY = Math.min(currY + linesPerChunk - 1, bottomY);
            chunks.push({
                topY: currY, bottomY: eY,
                isFirst: (currY === topY), isLast: (eY === bottomY)
            });
            currY = eY + 1;
        }
        chunks.reverse(); 
    }

    // 4. 動態構建 Trie 引擎
    status = _L(
        `⏳ Building Trie Engine & Processing (${msgModeNameEN})...`, 
        `⏳ 建立字典樹引擎，${msgModeNameTC} 處理中...`, 
        `⏳ 建立字典树引擎，${msgModeNameSC} 处理中...`
    );

    const variantMap = new Map();
    const finalDict = new Map();

    const exceptionSet = new Set();
    const exceptionMap = new Map();
    
    if (!isShiftPressed && typeof rawExceptionData !== "undefined" && rawExceptionData) {
    try {
        const linesEx = rawExceptionData.split("\n");
        for (let i = 0; i < linesEx.length; i++) {
            let line = linesEx[i];
            if (!line || line[0] === "#" || line[0] === "\r") continue;
            let tabIndex = line.indexOf("\t");
            if (tabIndex === -1) continue;
            let key = line.substring(0, tabIndex);
            let target = line.substring(tabIndex + 1).replace(/\r/g, "");
            exceptionSet.add(key);
            exceptionSet.add(target);
            exceptionMap.set(key, target);
            exceptionMap.set(target, target);
        }
    } catch(e) {}
}

    const isS2TVariant = (CURRENT_MODE === "S2T" || CURRENT_MODE === "S2TE") && !isAltPressed && !isShiftPressed;
    const isT2SVariant = (CURRENT_MODE === "T2S") && !isAltPressed && !isShiftPressed;
    const needVariants = isS2TVariant || isT2SVariant;
    
    if (needVariants && typeof rawTWVariants !== "undefined" && rawTWVariants) {
    try {
        const linesTW = rawTWVariants.split("\n");
        for (let i = 0; i < linesTW.length; i++) {
            let line = linesTW[i];
            if (!line || line[0] === "#" || line[0] === "\r") continue;
            let tabIndex = line.indexOf("\t");
            if (tabIndex === -1) continue;
            let k = line.substring(0, tabIndex);
            let rest = line.substring(tabIndex + 1);
            let spaceIndex = rest.indexOf(" ");
            let v = (spaceIndex === -1) 
                    ? rest.replace(/\r/g, "") 
                    : rest.substring(0, spaceIndex);

            if (isS2TVariant) {
                variantMap.set(k, v);
            } else if (isT2SVariant) {
                variantMap.set(v, k); // 反向映射：繁轉簡
            }
        }
    } catch(e) {}
}

    const applyTWVariants = (str) => {
        if (!isS2TVariant) return str; 
        let res = "";
        for (let c of str) res += variantMap.has(c) ? variantMap.get(c) : c;
        return res;
    };

    // 新增 ⚓Context Logic Anchors：處理交叉歧義與雙關陷阱
    const ContextLogicAnchors = new Set([
    "个中", "个旧",
    "了如", "了望", "了然", "了解", "明了",
    "有云", "小云",
    "借甚", "借资",
    "冲来", "冲到", "冲上", "水一冲",
    "不准", "准用",
    "几子", "小几", "方几", "凭几", "条几", "长几", "高几", "矮几", "桌几", "伏几",
    "一出",
    "别嘴", "别强", "别扭", "别气", "别着",
    "刮了", "刮去", "刮走", "刮着", "刮得",
    "制面",
    "厂部", "广部", "崖广",
    "乱发", "发色", "生发", "发卷", "额发", "金发",
    "那只", "这只", "哪只", "每只", "首只", "换只", "是只", "鸡只", "猪只", "牛只",
    "天后",
    "不复", "回复", "往复", "复合", "行复", "更复", "办复", "开复",
    "不干", "相干", "干他", "干你", "干她", "干我", "干了", "所干", "干的",
    "并成", "并为",
    "大曲",
    "此系",
    "胡同",
    "海里",
    "冷面", "白面", "片面",
    "愈合",
    "全彩",
    "卷轴", "卷上",
    "背人", "背他", "背你", "背来", "背债", "背包", "背回", "背她", "背带", "背我", "背榜", "背物", "背着", "背筐", "背篓", "背负", "背走",
    "万旗", "占万",
    "价古",
    "筑前", "筑北", "筑后", "筑西",
    ]);

    // 新增 🔭 Vision Logic Anchors: 視界邏輯定錨名單
    const VisionAnchors = new Set([
    "第一出", "第二出", "第三出", "第四出", "第五出", "第六出", "第七出", "第八出", "第九出", "第十出", "一出剧", "一出戏",
    "被发", "括发", "直发", "肤发", "断发", "上面", "下面", "下面条", "面包", "好困", "发困", "小价", "良价", "贵价", "马表", "米制",
    ]);

    // 📙 Vision Vocabs: 視界邏輯專用詞庫
    const VisionVocabs = new Set([
    "包含", "包围", "包容", "包容", "包庇", "包括", "包浆", "包涵", "包着", "包膜", "包裹", "包覆",
    "条件", "条例", "条列", "条文", "条款", "条码", "点化", "剧院", "戏院", "发寒", "发凉", "行吟",
    ]);

    const parseMainData = (rawStr) => {
    if (!rawStr) return;
    const lines = rawStr.split("\n");
    for (let i = 0; i < lines.length; i++) {
        let line = lines[i];
        if (!line || line[0] === "#" || line[0] === "\r") continue;
        let tabIndex = line.indexOf("\t");
        if (tabIndex === -1) continue;
        let key = line.substring(0, tabIndex);
        if (effectiveContextLogic && ContextLogicAnchors.has(key)) continue;
        let rawTarget = line.substring(tabIndex + 1).replace(/\r/g, "");
        let firstTarget = rawTarget.split(" ")[0];

        let target = (exceptionMap && exceptionMap.has(key)) 
                     ? exceptionMap.get(key) 
                     : applyTWVariants(firstTarget);

        if (!finalDict.has(key)) {
            finalDict.set(key, target);
        }
    }
};

    if (!isShiftPressed) {
        if (typeof rawExceptionData !== "undefined") try { parseMainData(rawExceptionData); } catch(e){}
        if (typeof rawPhraseExpandedData !== "undefined") try { parseMainData(rawPhraseExpandedData); } catch(e){}
    }
    try { parseMainData(rawPhraseData); } catch(e){}
    
    if (CURRENT_MODE !== "S2TWP" && CURRENT_MODE !== "TW2SP") {
        try { parseMainData(rawCharData); } catch(e){}
    }

    if (isS2TVariant) {
        for (let [vKey, vTarget] of variantMap) {
            if (!finalDict.has(vKey)) finalDict.set(vKey, vTarget);
        }
    } else if (isT2SVariant) {
        for (let [twChar, genericChar] of variantMap) {
            if (!finalDict.has(twChar)) {
                if (finalDict.has(genericChar)) {
                    finalDict.set(twChar, finalDict.get(genericChar));
                } else {
                    finalDict.set(twChar, genericChar);
                }
            }
        }
    }

    // Trie 引擎 最佳化(V8 加速)
    status = _L(
        `⏳ Trie Engine V8 Optimization & Processing (${msgModeNameEN})...`, 
        `⏳ 字典樹引擎 V8 最佳化，${msgModeNameTC} 處理中...`, 
        `⏳ 字典树引擎 V8 优化，${msgModeNameSC} 处理中...`
    );

    class TrieNode {
        constructor() {
            this.c = new Map();
            this.v = null;
            this.o = null;
        }
    }

    const rootNodes = new Array(65536);

    for (let [key, target] of finalDict) {
        if (!key) continue;
        let firstCode = key.charCodeAt(0);
        let node = rootNodes[firstCode];
        if (!node) {
            node = new TrieNode();
            rootNodes[firstCode] = node;
        }

        for (let j = 1; j < key.length; j++) {
            let code = key.charCodeAt(j);
            let nextNode = node.c.get(code);
            if (!nextNode) {
                nextNode = new TrieNode();
                node.c.set(code, nextNode);
            }
            node = nextNode;
        }
        node.v = target;
        node.o = key;
    }

    // === 新增簡轉繁語法邏輯 ContextLogic 引擎 ===
    const m = "0123456789０１２３４５６７８９〇一二两三四五六七八九十百千万亿几数";
    const sn2 = "|老师|老師|先生|小姐|太太|女士|医生|医师|醫生|醫師|夫人|经理|师傅|經理|師傅|主席|教授|举人|大帅|爷爷|爺爺|老先|奶奶|老太|公公|婆婆|爸爸|妈妈|哥哥|大哥|姐姐|大姐|弟弟|妹妹|姊姊|某某|";

const ContextLogic = {
    // 1. 个	個 箇
    0x4E2A: function(i,t){var p=t.charAt(i-1)||" ",n=t.charAt(i+1)||" ",nn=t.charAt(i+2)||" ";return((n==="碧"&&"石铁".indexOf(nn)!==-1)||(p==="鸡"&&n==="铁"))?"箇":"個";},
    // 2. 么	麼 么
    0x4E48: function(i,t){var p=t.charAt(i-1)||" ",n=t.charAt(i+1)||" ";if(n==="喝"&&"怎那什这".indexOf(p)===-1)return"么";return("老小".indexOf(p)!==-1||"妹弟叔姨儿鸡正二三点".indexOf(n)!==-1)?"么":"麼";},
    // 3. 了	了 瞭
    0x4E86: function(i,t){var p=t.charAt(i-1)||" ",n=t.charAt(i+1)||" ",pp=t.charAt(i-2)||" ";return(p==="明"?"说表证明显照发判查标声点注申简阐探听写分天色光摆挑禀自回伸问朱大时".indexOf(pp)===-1&&n!=="解":"望解然如若哨见".indexOf(n)!==-1&&"办理到掉完好坏死杀给付下上开走出入回起落过洗看听读写白".indexOf(p)===-1)?"瞭":"了";},
    // 4. 云	雲 云
    0x4E91: function(i,t){var p=t.charAt(i-1)||" ",n=t.charAt(i+1)||" ",n2=t.charAt(i+2)||" ";return((n==="："&&"「『".indexOf(n2)!==-1&&"赵马陈陆".indexOf(p)===-1)||"谚书句传谣词话史答对叹唱笑末旦净丑外俗农皆者常且自老师僧佛仙".indexOf(p)!==-1||"谓道尔城".indexOf(n)!==-1)?"云":"雲";},
    // 5. 余	餘 余
    0x4F59: function(i,t){var p=t.charAt(i-1)||" ",n=t.charAt(i+1)||" ",n2=t.charAt(i+2)||" ";if("姓邱嗟".indexOf(p)!==-1||sn2.indexOf("|"+n+n2+"|")!==-1||(n==="以"&&n2==="为")||"陈玠".indexOf(n)!==-1)return"余";return"餘";},
    // 6. 借	借 藉
    0x501F: function(i,t){var p=t.charAt(i-1)||" ",n=t.charAt(i+1)||" ",n2=t.charAt(i+2)||" ",n3=t.charAt(i+3)||" ";return((n==="甚"&&"麼么".indexOf(n2)===-1)||(n==="資"&&"金料".indexOf(n2)===-1))?"藉":"借";},
    // 7. 冲	衝 沖
    0x51B2: function(i,t){var p=t.charAt(i-1)||" ",n=t.charAt(i+1)||" ",n2=t.charAt(i+2)||" ",pp=t.charAt(i-2)||" ";return(n!=="击"&&("净澹融煞咖奶调杯壶瓶罐牛点马淋成岸滩向酒巧头".indexOf(n)!==-1||"气雨瀑海河水船潮汐流".indexOf(p)!==-1||"气雨瀑海河水船潮汐流马".indexOf(pp)!==-1||(n==="了"&&"个马一冲".indexOf(n2)!==-1)||(n==="干"&&n2==="净")||(p==="当"&&pp!=="应"&&n!=="第")))?"沖":"衝";},
    // 8. 准	準 准
    0x51C6: function(i,t){var p=t.charAt(i-1)||" ",n=t.charAt(i+1)||" ",n2=t.charAt(i+2)||" ",pp=t.charAt(i-2)||" ";return((p==="不"&&"哪什几么".indexOf(n)===-1&&"说拿算估瞄看猜测真并断占卜卦得射量认钟表尺秤听很级".indexOf(pp)===-1)||"隆照谁我你他她们只请".indexOf(p)!==-1||(n==="不"&&n2==="准"))?"准":"準";},
    // 9. 几	幾 几
    0x51E0: function(i,t){var p=t.charAt(i-1)||" ",n=t.charAt(i+1)||" ";return ("琴禅炕凭小方条长高桌伏矮".indexOf(p)!==-1 && "周公英呎尺厘丈辈".indexOf(n)===-1) ? "几" : "幾";},
    // 10. 出	出 齣
    0x51FA: function(i,t){var p=t.charAt(i-1)||" ",n=t.charAt(i+1)||" ",n2=t.charAt(i+2)||" ",n3=t.charAt(i+3)||" ",pp=t.charAt(i-2)||" ";return((m+"这那哪整半").indexOf(p)!==-1&&(("戏剧".indexOf(n)!==-1&&"院场".indexOf(n2)===-1)||(n==="电"&&n2==="影"&&n3!=="院")||(n==="："&&pp==="第")))?"齣":"出";},
    // 11. 别	別 彆
    0x522B: function(i,t){var n=t.charAt(i+1)||" ",n2=t.charAt(i+2)||" ",n3=t.charAt(i+3)||" ";return("强扭气着嘴".indexOf(n)!==-1&&("强扭气着嘴腰屁身肢脖头手脚动走转了死馁我你他她它人求迫笑急凉忙火硬贱臭甜多碎快馋歪坏到过伤恼愤空虚喘鼓得出咱谁巴噗怒软笨滑辩占攻盛炸呼慌迷魔捏打奸送贫严松撑忍推疯闷嘟相道意曲过欠干买卖粗短笔墨结要暴制拉脸开塞衰力边刁巧行闯摆掉冲话实重对痒取留紧亏度吞陆眼毒乖拆索渡住断脱派量昂调想手尖笑皮晁一个".indexOf(n2)===-1||(n==="着"&&n2==="一"&&"口股".indexOf(n3)!==-1)))?"彆":"別";},
    // 12. 刮	刮 颳
    0x522E: function(i,t){var p=t.charAt(i-1)||" ",n=t.charAt(i+1)||" ",n2=t.charAt(i+2)||" ";return("台颱飓阵龙".indexOf(n)!==-1||(n==="了"&&"风台".indexOf(n2)!==-1)||(n==="得"&&"大猛".indexOf(n2)!==-1))?"颳":"刮";},
    // 13. 制	制 製
    0x5236: function(i,t){var pp=t.charAt(i-2)||" ",p=t.charAt(i-1)||" ",n=t.charAt(i+1)||" ",nn=t.charAt(i+2)||" ";return((n==="面"&&"包条疙肠饼食料纱".indexOf(nn)!==-1)||(p==="国"&&"泰本英德法俄意".indexOf(pp)!==-1)||(p==="线"&&"毛铁".indexOf(pp)!==-1)||(p==="器"&&"机电陶".indexOf(pp)!==-1)||(p==="金"&&("纯合种".indexOf(pp)!==-1||"造成作物饰笔".indexOf(n)!==-1))||(p==="编"&&n==="物")||"锌毛麦粉乳奶石牙芦荟苇蔗籐柳棕桃板檀珊瑚珍珠泥塑玻布羽丝绒湾果晶毡骨髓鬃岩扎璃瓷绸胶麻煎龟".indexOf(p)!==-1||"皮碟果酱糕豆篮筐肥刀香油裘雪奶乳酪氢玻".indexOf(n)!==-1)?"製":"制";},
    // 14. 厂	廠 厂
    // 0x5382: 僅處理交叉歧義與雙關陷阱。
    // 15. 历	歷 曆
