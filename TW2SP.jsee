                            while (k2 < textLen) {
                                deepNode = deepNode ? deepNode.c.get(srcText.charCodeAt(k2)) : null;
                                var deepSub = srcText.substring(deepIdx, k2 + 1);
                                if ((deepNode && deepNode.v !== null) || VisionVocabs.has(deepSub)) {
                                    isVisionStable = false;
