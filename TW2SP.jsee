                            let sub = srcText.substring(visionIdx, vk + 1);
                            let isInTrie = false;

                            if (continuousNode) {
                                let nextCode = srcText.charCodeAt(vk);
                                continuousNode = continuousNode.c ? (continuousNode.c.get ? continuousNode.c.get(nextCode) : continuousNode.c[nextCode]) : null;
                                if (continuousNode && continuousNode.v !== null) isInTrie = true;
                            }

