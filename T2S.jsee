#language = "V8"
#title = "", 1028, "", 2052, "T2S", 1033
#tooltip = "Traditional to Simplified Chinese", 1033, "繁转简", 2052, "繁轉簡", 1028
#icon="T2S.ico"

/**
 * Project: OpenCC for EmEditor Macro v0.44
 * Author: skyuns (https://github.com/skyuns/EmEditor-OpenCC-Macro 備援: https://gitcode.com/skyuns/EmEditor-OpenCC-Macro)
 * This macro provides foundational conversion based on the OpenCC core lexicon. Note that results may vary from the official implementation.
 * Data Source: OpenCC (https://github.com/BYVoid/OpenCC)
 * License: Apache License 2.0
 * Environment: Windows 11 + EmEditor 26.2.0 (較舊版本可能存在相容性問題)
 * 轉換流程：1. 讀取詞典 -> 2. 封裝 Trie 樹 -> 3. 結巴 (Jieba) 與視界 (Vision) 計算 -> 4. 路由引導與 FMM 匹配 -> 5. 詞彙邏輯 (Phrase Logic) -> 6. 語意邏輯 (Context Logic)
 * [Disclaimer] The simulator comparison feature is a non-official API implementation provided by Gemini for personal research; users assume all risks regarding potential IP rate-limiting. Default is disabled.
 */

const CURRENT_MODE = "T2S";
const Simulator_MODE = false; // 模擬轉換模式 (true: 始終開啟; false: 需按住 Ctrl 觸發)
const ContextLogic_MODE = true; // 語法邏輯 ContextLogic 與 PhraseLogic 引擎總開關 (true: 啟動; false: 關閉)
const VisionLogic_MODE = false; // 視界邏輯 VisionLogic 引擎總開關 (true: 啟動; false: 關閉)
const Use_ExternalDict = false; // 外部詞典 (true: 啟動; false: 關閉)：是否載入較新的外部詞典檔案 ( dictionary/*.txt )
const PhraseExpandedData = true; // [區塊 B：自訂擴充覆寫詞庫] true: 載入擴充詞庫; false: 停用擴充詞庫
const CharactersExt = true; // 豆腐字擴充 (true: 使用擴充字; false: 使用標準字)

// 啟用結巴分詞須於 dictionary 資料夾放置主詞典 (jieba.dict.utf8 或 dict.txt.big，推薦使用 dict.txt.big 繁簡兼收)；hmm_model.utf8 與 user.dict.utf8 為選配。
const Use_Jieba = false; // 結巴分詞 Jieba 總開關 (true: 啟動; false: 關閉)。
const Ctrl_Action = "Use_Jieba"; // Ctrl 鍵偵測行為設定 ("Simulator_MODE" 或 "Use_Jieba")
const isSegmentDisplay = (shell.GetKeyState(0x14) & 1); // 結巴分詞顯示開關 (使用 Caps Lock 作為實體開關)
const HMM_Word_limit = 50; // HMM 模型啟動上限字數

