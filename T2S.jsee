const RawP2Hex  = "4E3D,4E38,4E41,20122,4F60,4FAE,4FBB,5002,507A,5099,50E7,50CF,349E,2063A,514D,5154,5164,5177,2051C,34B9,5167,518D,2054B,5197,51A4,4ECC,51AC,51B5,291DF,51F5,5203,34DF,523B,5246,5272,5277,3515,52C7,52C9,52E4,52FA,5305,5306,5317,5349,5351,535A,5373,537D,537F,537F,537F,20A2C,7070,53CA,53DF,20B63,53EB,53F1,5406,549E,5438,5448,5468,54A2,54F6,5510,5553,5563,5584,5584,5599,55AB,55B3,55C2,5716,5606,5717,5651,5674,5207,58EE,57CE,57F4,580D,578B,5832,5831,58AC,214E4,58F2,58F7,5906,591A,5922,5962,216A8,216EA,59EC,5A1B,5A27,59D8,5A66,36EE,36FC,5B08,5B3E,5B3E,219C8,5BC3,5BD8,5BE7,5BF3,21B18,5BFF,5C06,5F53,5C22,3781,5C60,5C6E,5CC0,5C8D,21DE4,5D43,21DE6,5D6E,5D6B,5D7C,5DE1,5DE2,382F,5DFD,5E28,5E3D,5E69,3862,22183,387C,5EB0,5EB3,5EB6,5ECA,2A392,5EFE,22331,22331,8201,5F22,5F22,38C7,232B8,261DA,5F62,5F6B,38E3,5F9A,5FCD,5FD7,5FF9,6081,393A,391C,6094,226D4,60C7,6148,614C,614E,614C,617A,618E,61B2,61A4,61AF,61DE,61F2,61F6,6210,621B,625D,62B1,62D4,6350,22B0C,633D,62FC,6368,6383,63E4,22BF1,6422,63C5,63A9,3A2E,6469,647E,649D,6477,3A6C,654F,656C,2300A,65E3,66F8,6649,3B19,6691,3B08,3AE4,5192,5195,6700,669C,80AD,43D9,6717,671B,6721,675E,6753,233C3,3B49,67FA,6785,6852,6885,2346D,688E,681F,6914,3B9D,6942,69A3,69EA,6AA8,236A3,6ADB,3C18,6B21,238A7,6B54,3C4E,6B72,6B9F,6BBA,6BBB,23A8D,21D0B,23AFA,6C4E,23CBC,6CBF,6CCD,6C67,6D16,6D3E,6D77,6D41,6D69,6D78,6D85,23D1E,6D34,6E2F,6E6E,3D33,6ECB,6EC7,23ED1,6DF9,6F6E,23F5E,23F8E,6FC6,7039,701E,701B,3D96,704A,707D,7077,70AD,20525,7145,24263,719C,243AB,7228,7235,7250,24608,7280,7295,24735,24814,737A,738B,3EAC,73A5,3EB8,3EB8,7447,745C,7471,7485,74CA,3F1B,7524,24C36,753E,24C92,7570,2219F,7610,24FA1,24FB8,25044,3FFC,4008,76F4,250F3,250F2,25119,25133,771E,771F,771F,774A,4039,778B,4046,4096,2541D,784E,788C,78CC,40E3,25626,7956,2569A,256C5,798F,79EB,412F,7A40,7A4A,7A4F,2597C,25AA7,25AA7,7AEE,4202,25BAB,7BC6,7BC9,4227,25C80,7CD2,42A0,7CE8,7CE3,7D00,25F86,7D63,4301,7DC7,7E02,7E45,4334,26228,26247,4359,262D9,7F7A,2633E,7F95,7FFA,8005,264DA,26523,8060,265A8,8070,2335F,43D5,80B2,8103,440B,813E,5AB5,267A7,267B5,23393,2339C,8201,8204,8F9E,446B,8291,828B,829D,52B3,82B1,82B3,82BD,82E6,26B3C,82E5,831D,8363,83AD,8323,83BD,83E7,8457,8353,83CA,83CC,83DC,26C36,26D6B,26CD5,452B,84F1,84F3,8516,273CA,8564,26F2C,455D,4561,26FB1,270D2,456B,8650,865C,8667,8669,86A9,8688,870E,86E2,8779,8728,876B,8786,45D7,87E1,8801,45F9,8860,8863,27667,88D7,88DE,4635,88FA,34BB,278AE,27966,46BE,46C7,8AA0,8AED,8B8A,8C55,27CA8,8CAB,8CC1,8D1B,8D77,27F2F,20804,8DCB,8DBC,8DF0,208DE,8ED4,8F38,285D2,285ED,9094,90F1,9111,2872E,911B,9238,92D7,92D8,927C,93F9,9415,28BFA,958B,4995,95B7,28D77,49E6,96C3,5DB2,9723,29145,2921A,4A6E,4A76,97E0,2940A,4AB2,29496,980B,980B,9829,295B6,98E2,4B33,9929,99A7,99C2,99FE,4BCE,29B30,9B12,9C40,9CFD,4CCE,4CED,9D67,2A0CE,4CF8,2A105,2A20E,2A291,9EBB,4D56,9EF9,9EFE,9F05,9F0F,9F16,9F3B,2A600";

const FastReplaceMap = new Map();
let FastReplaceMapReady = false;

function InitializeReplaceMap() {
    if (FastReplaceMapReady) return;

    // 解析 BMP 平面資料 (從 0xF900 開始)
    var bmpItems = RawBmpHex.split(",");
    for (var i = 0; i < bmpItems.length; i++) {
        var item = bmpItems[i];
        if (item === "0000" || !item) continue;
        var originalCodePoint = 0xF900 + i;
        var targetCodePoint = parseInt(item, 16);
        FastReplaceMap.set(originalCodePoint, targetCodePoint);
    }

    // 解析 Plane 2 平面資料 (從 0x2F800 開始)
    var p2Items = RawP2Hex.split(",");
    for (var i = 0; i < p2Items.length; i++) {
        var item = p2Items[i];
        if (item === "0000" || !item) continue;
        var originalCodePoint = 0x2F800 + i;
        var targetCodePoint = parseInt(item, 16);
        FastReplaceMap.set(originalCodePoint, targetCodePoint);
    }
    FastReplaceMapReady = true;
}

// --- [##核心邏輯區##] ---
function main() {
    // 0. 偵測模式 與 控制鍵狀態
    const isShiftPressed = (shell.GetKeyState(0x10) < 0); // 按住 Shift : 僅使用標準詞組[區塊 A] 與單字 [區塊 C]，忽略 [視界邏輯]、[語法邏輯]、[區塊 B]、[區塊 D]、[區塊 E]、[區塊 F]
    const isCtrlPressed = (shell.GetKeyState(0x11) < 0); // 按住 Ctrl : 觸發 Ctrl_Action 設定的功能
    const isAltPressed = (shell.GetKeyState(0x12) < 0); // 按住 Alt : 忽略 [區塊 D：台灣字形修正]、[區塊 F：台灣慣用詞字形修正]、[相容字形修正]

    InitializeReplaceMap();

    let isSimulate = (typeof Simulator_MODE !== "undefined" && Simulator_MODE === true);
    let isJiebaActive = (typeof Use_Jieba !== "undefined" && Use_Jieba === true);

    if (isCtrlPressed) {
        if (typeof Ctrl_Action !== "undefined" && Ctrl_Action === "Use_Jieba") {
            isJiebaActive = !isJiebaActive;
        } else {
            isSimulate = true;
        }
    }

// 模擬模式，關閉結巴分詞
    if (isSimulate) {
         isJiebaActive = false; 
    }

    const isContextLogicReady = ContextLogic_MODE && !isShiftPressed;
    const effectiveContextLogic = isContextLogicReady && (CURRENT_MODE === "S2T" || CURRENT_MODE === "S2TE");
    const effectiveContextLogic_T2S = isContextLogicReady && CURRENT_MODE === "T2S";

    const isVisionLogicReady = VisionLogic_MODE && !isShiftPressed && !isJiebaActive; // 啟動 Jieba 時停用原視界邏輯
    const effectiveVisionLogic = isVisionLogicReady && (CURRENT_MODE === "S2T" || CURRENT_MODE === "S2TE");

    // 1. 動態模式與語言設定
    const langId = editor.LangID;
    const _L = (en, tc, sc) => {
        if (langId === 1028) return tc;
        if (langId === 2052) return sc;
        return en;
    };

    let msgModeNameTC = "", msgModeNameSC = "", msgModeNameEN = "";

    switch(CURRENT_MODE) {
        case "T2S":
            msgModeNameTC = "繁轉簡"; msgModeNameSC = "繁转简"; msgModeNameEN = "T2S"; break;
        case "S2T":
            msgModeNameTC = "簡轉繁"; msgModeNameSC = "简转繁"; msgModeNameEN = "S2T"; break;
        case "S2TE":
            msgModeNameTC = "簡轉繁: 擴充版"; msgModeNameSC = "简转繁: 扩充版"; msgModeNameEN = "S2T: Expanded"; break;
        case "S2TWP":
            msgModeNameTC = "用語轉換: 大陸 ➔ 台灣"; msgModeNameSC = "用语转换: 大陆 ➔ 台湾"; msgModeNameEN = "Terminology: CN->TW"; break;
        case "TW2SP":
            msgModeNameTC = "用語轉換: 台灣 ➔ 大陸"; msgModeNameSC = "用语转换: 台湾 ➔ 大陆"; msgModeNameEN = "Terminology: TW->CN"; break;
        default:
            msgModeNameTC = "文字"; msgModeNameSC = "文本"; msgModeNameEN = "Text"; break;
    }

    let currentModeNames = {
        TC: msgModeNameTC,
        SC: msgModeNameSC,
        EN: msgModeNameEN
    };

    const MSG_NO_TEXT = _L("No text selected.", "未選取文字", "未选中文本");

    const getMsgProcessing = (p) => {
    var steps = "▁▃▅▇";
    var fullStr  = "▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇";
    var trackStr = "▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁";
    var bar = "";

    // 進度條邏輯
    if (p >= 99) {
        bar = fullStr.substring(0, 19) + "▅"; 
    } else {
        var filledCount = Math.floor(p / 5);
        var remainder = p % 5;
        var stepIdx = Math.floor((remainder / 5) * 4);
        var tipChar = steps.charAt(stepIdx);
        bar = fullStr.substring(0, filledCount) + tipChar + trackStr.substring(0, 19 - filledCount);
    }

    var pStr = (p < 10) ? "0" + p : p;
    if (p >= 99) {
        return _L(
            `⏳ Integrating data, please wait... \n${bar} ${pStr}%`, 
            `⏳ ${msgModeNameTC} 資料整合中，請稍候... \n${bar} ${pStr}%`, 
            `⏳ ${msgModeNameSC} 数据整合中，请稍候... \n${bar} ${pStr}%`
        );
    }
    return _L(
        `⏳ Processing data, please wait... \n${bar} ${pStr}%`, 
        `⏳ ${msgModeNameTC} 資料處理中，請稍候... \n${bar} ${pStr}%`, 
        `⏳ ${msgModeNameSC} 数据处理中，请稍候... \n${bar} ${pStr}%`
    );
};

    const getMsgSuccess = (count, time) => {
        let ignoreTW = isAltPressed || isShiftPressed;

        let suffixTC = "";
        let suffixSC = "";
        let suffixEN = "";

        if (!ignoreTW) {
            if (CURRENT_MODE === "S2T" || CURRENT_MODE === "S2TE") {
                suffixTC = "已套用台灣字形，";
                suffixSC = "已套用台湾字形，";
                suffixEN = "TW variants applied, ";
            } else if (CURRENT_MODE === "T2S") {
                suffixTC = "台灣字形已反轉，";
                suffixSC = "台湾字形已反转，";
                suffixEN = "TW variants reversed, ";
            }
        }

        let logicActive = ContextLogic_MODE && !isShiftPressed;
        let logicTC = logicActive ? "已套用語法邏輯，" : "";
        let logicSC = logicActive ? "已套用语法逻辑，" : "";
        let logicEN = logicActive ? "Context logic applied, " : "";

        let visionActive = effectiveVisionLogic && isVisionTriggered;
        let visionTC = visionActive ? "視界邏輯，" : "";
        let visionSC = visionActive ? "视界逻辑，" : "";
        let visionEN = visionActive ? "Vision logic applied, " : "";

        let jiebaTC = isJiebaActive ? "結巴分詞，" : "";
        let jiebaSC = isJiebaActive ? "结巴分词，" : "";
        let jiebaEN = isJiebaActive ? "Jieba applied, " : "";

        if (isSimulate) {
            return _L(
                `✅ Conversion simulated (${msgModeNameEN}, ${suffixEN}${jiebaEN}${logicEN}${visionEN}${count} ops in ${time} s).`,
                `✅ 模擬運算完成 (${msgModeNameTC}，${suffixTC}${jiebaTC}${logicTC}${visionTC}共計 ${count} 處變更，耗時 ${time} 秒，未修改原文)`,
                `✅ 模拟运算完成 (${msgModeNameSC}，${suffixSC}${jiebaSC}${logicSC}${visionSC}共计 ${count} 处变更，耗时 ${time} 秒，未修改原文)`
            );
        } else {
            return _L(
                `✅ Conversion completed (${msgModeNameEN}, ${suffixEN}${jiebaEN}${logicEN}${visionEN}${count} ops in ${time} s).`,
                `✅ 轉換完成 (${msgModeNameTC}，${suffixTC}${jiebaTC}${logicTC}${visionTC}共取代 ${count} 處，耗時 ${time} 秒)`,
                `✅ 转换完成 (${msgModeNameSC}，${suffixSC}${jiebaSC}${logicSC}${visionSC}共替换 ${count} 处，耗时 ${time} 秒)`
            );
        }
    };

    // WebBar 相容性檢查
    if (!isSimulate && WebBar.Visible) {
        var title = _L(
            "WebBar is active and incompatible with standard conversion mode.",
            "偵測到內建網頁瀏覽器 (WebBar) 開啟，與標準轉換模式不相容。",
            "侦测到内置网页浏览器 (WebBar) 打开，与标准转换模式不兼容。"
        );
        var body = _L(
            "[OK]: Close WebBar and please restart the macro.\n[Cancel]: Close this window only.",
            "「確定」：關閉 WebBar，並請重新執行巨集。\n「取消」：僅關閉此視窗。",
            "“确定”：关闭 WebBar，并请重新运行宏。\n“取消”：仅关闭此窗口。"
        );
        if (confirm(title, body)) {
            WebBar.Visible = false;
        }
        Quit(); 
    }

    var original_scrollX = scrollX;
    var original_scrollY = scrollY;

    const startTime = Date.now();

    // 2. 選取處理
    let isCSVCellSel = false;

    try {
        if ((document.selection.Mode & 15) === 4) isCSVCellSel = true;
    } catch(e) {}

    let checkText = "";
    if (!isCSVCellSel && document.selection.IsEmpty) {
        try { 
            checkText = document.selection.Text; 
        } catch(e) {}

        if (checkText.length > 0) {
            isCSVCellSel = true;
        }
    }

    if (!isCSVCellSel && document.selection.IsEmpty) {
        document.selection.SelectWord();
        if (document.selection.IsEmpty) {
            alert(MSG_NO_TEXT); 
            Quit();
        }
    }

    const topY = document.selection.GetTopPointY(eePosLogical);
    const topX = document.selection.GetTopPointX(eePosLogical);
    const bottomY = document.selection.GetBottomPointY(eePosLogical);
    const bottomX = document.selection.GetBottomPointX(eePosLogical);
    let realBottomX = bottomX, realBottomY = bottomY;
    const selectedLines = bottomY - topY + 1;
    const selectedWidth = Math.abs(bottomX - topX);

    // 偵測選取長度並格式化數字
    status = _L(
        "⏳ Detecting selection size...", 
        "⏳ 正在檢測選取範圍大小...", 
        "⏳ 正在检测选取范围大小..."
    );

    let txtlen = -1;
    try { 
        txtlen = document.selection.TextLength; 
    } catch(e) {}

    const fmtN = (num) => num.toLocaleString('en-US');

    if (txtlen !== -1) {
        // A. 模擬模式限制 (200 字元)
        if (isSimulate && txtlen > 200) {
            status = "";
                alert(_L(
                    "⚠️ Selection too large (Character count: " + fmtN(txtlen) + "). Simulation is aborted.",
                    "⚠️ 選取範圍過大 (字元數: " + fmtN(txtlen) + ")，已中止模擬模式。",
                    "⚠️ 选取范围过大 (字符数: " + fmtN(txtlen) + ")，已中止模拟模式。"
                ));
            Quit();
        }
        // B. 實際模式限制 (2,100,000,000 字元)
        if (!isSimulate && txtlen > 2100000000) {
            status = "";
            alert(_L(
                "⚠️ Selection exceeds 2,100,000,000 characters. Due to architectural limits, conversion is aborted to protect memory and prevent crashes. \n\nPlease reduce the selection range and convert in segments.",
                "⚠️ 選取內容超過 2,100,000,000 字元。因架構問題，為保護系統記憶體避免當機，系統已攔截並中止轉換。\n\n建議縮小選取範圍，分段進行轉換。",
                "⚠️ 选取内容超过 2,100,000,000 字符。因架构问题，为保护系统内存避免当机，系统已拦截并中止转换。\n\n建议缩小选取范围，分段进行转换。"
            ));
            Quit();
        }
    } else {
        // C. 舊版相容模式限制：使用座標估算 (模擬模式)
        if (isSimulate && (selectedLines > 50 || selectedWidth > 200)) {
            status = "";
                alert(_L(
                    "⚠️ Selection too large (Lines: " + fmtN(selectedLines) + ", Width: " + fmtN(selectedWidth) + "). Aborting simulation.",
                    "⚠️ 選取範圍過大 (行數: " + fmtN(selectedLines) + "，寬度: " + fmtN(selectedWidth) + ")，已中止模擬模式。",
                    "⚠️ 选取范围过大 (行数: " + fmtN(selectedLines) + "，宽度: " + fmtN(selectedWidth) + ")，已中止模拟模式。"
                ));
            Quit();
        }
    }

    let initialText = "";
    if (isSimulate) {
        try { initialText = document.selection.Text; } catch(e) {}

        if (initialText.length > 200) {
            status = "";
                alert(_L(
                    "⚠️ Selected character count is " + fmtN(initialText.length) + ", exceeding the 200-character limit.",
                    "⚠️ 選取字元數為 " + fmtN(initialText.length) + "，已超過模擬模式的 200 字元上限。",
                    "⚠️ 选取字符数为 " + fmtN(initialText.length) + "，已超过模拟模式的 200 字符上限。"
                ));
            Quit(); 
        }
    }

    if (!isCSVCellSel && selectedLines > 22000000) {
        status = "";
        alert(_L(
            "⚠️ Selected lines exceed 22,000,000 limit. Conversion aborted. Please reduce selection.",
            "⚠️ 選取總行數超過 2200 萬行，超出安全轉換限制，已中止轉換作業。\n為避免系統無回應，請減少選取範圍後再試。",
            "⚠️ 选取总行数超过 2200 万行，超出安全转换限制，已中止转换程序。\n为避免系统无回应，请减少选取范围后再试。"
        ));
        Quit();
    }

    let isFilterMode = false;
    try {
        if (document.filters && document.filters.Count > 0) {
            isFilterMode = true;
        }
    } catch (e) {}

    let selCount = 1;
    let isMultiSel = false;
    let isVerticalSel = false; 

    try {
        if ((document.selection.Mode & 15) === 3) {
            isVerticalSel = true;
            isMultiSel = true; 
        }
    } catch(e) {}

    try {
        if (typeof document.selection.Count !== "undefined" && document.selection.Count > 1) {
            selCount = document.selection.Count;
            isMultiSel = true;
        }
    } catch(e) {}

if (!isCSVCellSel && (isFilterMode || isMultiSel) && selectedLines > 60000) {
        status = "";
        alert(_L(
            "Selection exceeds 60000 lines limit for Filter/Multi-Select mode. Please reduce selection.",
            "⚠️ 篩選或多段選取模式下，選取範圍超過 60000 行限制。\n為避免系統無回應，請減少選取範圍後再試。",
            "⚠️ 筛选或多段选取模式下，选取范围超过 60000 行限制。\n为避免系统无回应，请减少选取范围后再试。"
        ));
        Quit();
    }

    // 分流門檻：結巴分詞選取超過 4,500,000 字、一般模式超過 9,000,000 字且非複雜模式時，交給 BoostCVT 處理 (需 EmEditor v26.1+)
    let csharpThreshold = isJiebaActive ? 4500000 : 9000000;
    if (txtlen > csharpThreshold && txtlen < 2100000000 && !isCSVCellSel && !isMultiSel && !isVerticalSel && !isFilterMode) {
        var scriptDir = ScriptFullName.substring(0, ScriptFullName.lastIndexOf("\\") + 1);
        var fastMacro = scriptDir + "BoostCVT.jsee";
        var fastEXE   = scriptDir + "BoostCVT.exe";
        var fastDLL = scriptDir + "BoostCVT.dll";

        if (shell.FileExists(fastMacro) && (shell.FileExists(fastEXE) || shell.FileExists(fastDLL))) {

            var userClipBackup = clipboardData.getData("Text", 0);

            // 將參數封裝成字串放入剪貼簿 (格式: 標籤|模式|巨集路徑|模擬|語法|視界|外部詞典|Jieba開關|HMM上限|擴充詞開關|豆腐字擴充開關)
            var configParams = [
                "BoostCVT_CONFIG_TOKEN",
                CURRENT_MODE,
                ScriptFullName,
                isSimulate ? "true" : "false",
                ContextLogic_MODE ? "true" : "false",
                effectiveVisionLogic ? "true" : "false",
                Use_ExternalDict ? "true" : "false",
                isJiebaActive ? "true" : "false",
                typeof HMM_Word_limit !== "undefined" ? HMM_Word_limit : 50,
                PhraseExpandedData ? "true" : "false",
                (typeof CharactersExt !== "undefined" && CharactersExt) ? "true" : "false"
            ].join("|");

            clipboardData.setData("Text", configParams);

            try {
                // 呼叫 BoostCVT 增壓引擎
                editor.ExecuteMacro(fastMacro, eeRunFile | eeMacroSyncOnly);

                // 執行完畢後，恢復剪貼簿
                clipboardData.clearData("Text", 0);
                if (userClipBackup !== null) clipboardData.setData("Text", userClipBackup);
                return; 
            } catch (e) {
                // 若增壓引擎執行失敗，仍需還原剪貼簿，並降級跑 V8 邏輯
                clipboardData.clearData("Text", 0);
                if (userClipBackup !== null) clipboardData.setData("Text", userClipBackup);
            }
        }
    }

    // V8 備援模式超長虛擬行預先攔截
    if (!isCSVCellSel &&
        !isFilterMode &&
        !isMultiSel &&
        !isVerticalSel &&
        selectedLines > 0 &&
        txtlen / selectedLines > 25000000) {
        status = "";
        alert(_L(
            "⚠️ The average virtual-line length exceeds the 25,000,000-character safety limit for V8 fallback mode. Conversion was aborted to prevent incomplete conversion caused by virtual-line reflow.",
            "⚠️ 選取範圍的平均虛擬行長度超過 V8 備援模式 25,000,000 字元安全限制。為避免 EmEditor 虛擬行重新排列造成漏轉或部分轉換，已在轉換前中止作業。",
            "⚠️ 选取范围的平均虚拟行长度超过 V8 备用模式 25,000,000 字符安全限制。为避免 EmEditor 虚拟行重新排列造成漏转或部分转换，已在转换前中止操作。"
        ));
        Quit();
    }

    // 3. 動態切塊邏輯
    let chunks = [];
    if (!isCSVCellSel && !isFilterMode && !isMultiSel) {
        let numChunks = 1;
        // 根據結巴狀態，調整切分門檻
        var chunkSize = isJiebaActive ? 40000000 : 60000000;
        if (txtlen > 0) {
            numChunks = Math.ceil(txtlen / chunkSize);
        } else {
            if (selectedLines <= 2000) {
                    numChunks = Math.max(1, Math.ceil(selectedLines / 400));
                } else if (selectedLines <= 10000) {
                    numChunks = Math.floor(5 + (selectedLines - 2000) / 533);
                } else {
                    numChunks = Math.min(100, Math.floor(20 + (selectedLines - 10000) / 166333));
                }
        }

        let linesPerChunk = Math.ceil(selectedLines / numChunks);
        if (linesPerChunk < 1) linesPerChunk = 1;

        let currY = topY;
        while (currY <= bottomY) {
            let eY = Math.min(currY + linesPerChunk - 1, bottomY);
            chunks.push({
                topY: currY, bottomY: eY,
                isFirst: (currY === topY), isLast: (eY === bottomY)
            });
            currY = eY + 1;
        }
        chunks.reverse(); 
    }

// 4. 動態構建 Trie 引擎
    status = _L(
        `⏳ Building Trie Engine & Processing (${msgModeNameEN})...`, 
        `⏳ 建立字典樹引擎，${msgModeNameTC} 處理中...`, 
        `⏳ 建立字典树引擎，${msgModeNameSC} 处理中...`
    );

// 連接外部詞典 (根據模式切換：Jieba 為 C# 優先，其餘為 JS 優先)
    let currentPhraseData, currentCharData, currentTWVariants, currentExceptionData, currentPhraseExpandedData, currentJiebaData, currentUserDictData, currentHmmData, currentTWVariantsPhrases;
    let dictLoadedFromExe = false;

    if (Use_ExternalDict || isJiebaActive) {
        try {
            let scriptDir = ScriptFullName.substring(0, ScriptFullName.lastIndexOf("\\") + 1);
            let fastMacro = scriptDir + "BoostCVT.jsee";
            let fastEXE = scriptDir + "BoostCVT.exe";
            let fastDLL = scriptDir + "BoostCVT.dll";
            let backupClip = clipboardData.getData("Text", 0);

            // 定義內部映射函式
            const mapDictData = (clipStr) => {
                if (!clipStr || clipStr.indexOf("|||BLOCK_SEP|||") === -1) return false;
                let newData = clipStr.split("|||BLOCK_SEP|||");
                if (newData.length < 5) return false;
                currentPhraseData = newData[0] || currentPhraseData;
                currentCharData = newData[1] || currentCharData;
                currentTWVariants = newData[2] || currentTWVariants;
                currentPhraseExpandedData = newData[3] || currentPhraseExpandedData;
                currentExceptionData = newData[4] || currentExceptionData;
                if (newData.length >= 6) currentJiebaData = newData[5]; 
                if (newData.length >= 7) currentUserDictData = newData[6];
                if (newData.length >= 8) currentHmmData = newData[7];
                if (newData.length >= 9) currentTWVariantsPhrases = newData[8];
                return true;
            };

            // 🕵️ 核心分流邏輯
            let loadSuccess = false;
            // 取得豆腐字旗標狀態
            var extFlag = (typeof CharactersExt !== "undefined" && CharactersExt) ? "1" : "0";

            if (isJiebaActive) {
                // A. 結巴模式：C# (EXE/DLL) 優先
                if (shell.FileExists(fastEXE) || shell.FileExists(fastDLL)) {
                    let dictConfig = CURRENT_MODE + "|" + ScriptFullName + "|1|" + (PhraseExpandedData ? "1" : "0") + "|" + extFlag; 
                    if (shell.FileExists(fastEXE)) {
                        shell.Run("conhost.exe", 0, true, '--headless "' + fastEXE + '" LOAD_DICT "' + dictConfig + '"');
                    } else {
                        shell.Run("conhost.exe", 0, true, "--headless powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& {[Reflection.Assembly]::LoadFile('" + fastDLL.replace(/\\/g, "/") + "') | Out-Null; [MyTools.TextProcessor]::Convert('LOAD_DICT', '" + dictConfig.replace(/\\/g, "/") + "');}\"");
                    }
                    loadSuccess = mapDictData(clipboardData.getData("Text"));
                    if (loadSuccess) dictLoadedFromExe = true;
                }
                // 若 C# 失敗，則 JS 備援
                if (!loadSuccess && shell.FileExists(fastMacro)) {
                    clipboardData.setData("Text", "BoostCVT_LOAD_DICT|" + CURRENT_MODE + "|" + ScriptFullName + "|1|" + (PhraseExpandedData ? "1" : "0") + "|" + extFlag);
                    editor.ExecuteMacro(fastMacro, eeRunFile | eeMacroSyncOnly);
                    loadSuccess = (clipboardData.getData("Text") === "0") ? true : mapDictData(clipboardData.getData("Text"));
                }
            } 
            else {
                // B. 一般外部辭典：JS (BoostCVT.jsee) 優先
                if (shell.FileExists(fastMacro)) {
                    clipboardData.setData("Text", "BoostCVT_LOAD_DICT|" + CURRENT_MODE + "|" + ScriptFullName + "|0|" + (PhraseExpandedData ? "1" : "0") + "|" + extFlag);
                    editor.ExecuteMacro(fastMacro, eeRunFile | eeMacroSyncOnly);
                    let jsRes = clipboardData.getData("Text");
                    if (jsRes === "0") { loadSuccess = true; } 
                    else { loadSuccess = mapDictData(jsRes); }
                }
                // 若 JS 失敗，則 C# 備援
                if (!loadSuccess && (shell.FileExists(fastEXE) || shell.FileExists(fastDLL))) {
                    let dictConfig = CURRENT_MODE + "|" + ScriptFullName + "|0|" + (PhraseExpandedData ? "1" : "0") + "|" + extFlag;
                    if (shell.FileExists(fastEXE)) {
                        shell.Run("conhost.exe", 0, true, '--headless "' + fastEXE + '" LOAD_DICT "' + dictConfig + '"');
                    } else {
                        shell.Run("conhost.exe", 0, true, "--headless powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& {[Reflection.Assembly]::LoadFile('" + fastDLL.replace(/\\/g, "/") + "') | Out-Null; [MyTools.TextProcessor]::Convert('LOAD_DICT', '" + dictConfig.replace(/\\/g, "/") + "');}\"");
                    }
                    loadSuccess = mapDictData(clipboardData.getData("Text"));
                    if (loadSuccess) dictLoadedFromExe = true;
                }
            }

            // 釋放記憶體並還原剪貼簿
            clipboardData.clearData("Text", 0);
            if (backupClip !== null) clipboardData.setData("Text", backupClip);

        } catch(e) {}
    }

    // 🛡️ 詞典合併與 Fallback 機制：優先使用外部讀取的資料，否則退回使用內建常數
    currentPhraseData = currentPhraseData || (typeof rawPhraseData !== "undefined" ? rawPhraseData : "");
    currentCharData = currentCharData || (typeof rawCharData !== "undefined" ? rawCharData : "");
    currentTWVariants = currentTWVariants || (typeof rawTWVariants !== "undefined" ? rawTWVariants : "");
    currentPhraseExpandedData = currentPhraseExpandedData || (typeof rawPhraseExpandedData !== "undefined" ? rawPhraseExpandedData : "");
    currentExceptionData = currentExceptionData || (typeof rawExceptionData !== "undefined" ? rawExceptionData : "");
    currentTWVariantsPhrases = currentTWVariantsPhrases || (typeof rawTWVariantsPhrases !== "undefined" ? rawTWVariantsPhrases : "");

    if (typeof PhraseExpandedData !== "undefined" && !PhraseExpandedData) currentPhraseExpandedData = "";

    // 若開啟結巴功能但未讀取到詞典，則關閉旗標
    if (isJiebaActive && !currentJiebaData) isJiebaActive = false;

    const variantMap = new Map();
    const finalDict = new Map();

    const exceptionSet = new Set();
    const exceptionMap = new Map();

    const reverseCharMap = new Map();
    const twPhrasesMap = new Map();

    if (!isShiftPressed && typeof currentExceptionData !== "undefined" && currentExceptionData) {
    try {
        const linesEx = currentExceptionData.split("\n");
        for (let i = 0; i < linesEx.length; i++) {
            let line = linesEx[i];
            if (!line || line[0] === "#" || line[0] === "\r") continue;
            let tabIndex = line.indexOf("\t");
            if (tabIndex === -1) continue;
            let key = line.substring(0, tabIndex);
            let target = line.substring(tabIndex + 1).replace(/\r/g, "");
            exceptionSet.add(key);
            exceptionSet.add(target);
            exceptionMap.set(key, target);
            exceptionMap.set(target, target);
        }
    } catch(e) {}
}

    const isS2TVariant = (CURRENT_MODE === "S2T" || CURRENT_MODE === "S2TE") && !isAltPressed && !isShiftPressed;
    const isT2SVariant = (CURRENT_MODE === "T2S") && !isAltPressed && !isShiftPressed;
    const needVariants = isS2TVariant || isT2SVariant;

    if (needVariants && typeof currentTWVariants !== "undefined" && currentTWVariants) {
    try {
        const linesTW = currentTWVariants.split("\n");
        for (let i = 0; i < linesTW.length; i++) {
            let line = linesTW[i];
            if (!line || line[0] === "#" || line[0] === "\r") continue;
            let tabIndex = line.indexOf("\t");
            if (tabIndex === -1) continue;
            let k = line.substring(0, tabIndex);
            let rest = line.substring(tabIndex + 1);
            let spaceIndex = rest.indexOf(" ");
            let v = (spaceIndex === -1) 
                    ? rest.replace(/\r/g, "") 
                    : rest.substring(0, spaceIndex);

            if (isS2TVariant) {
                variantMap.set(k, v);
            } else if (isT2SVariant) {
                variantMap.set(v, k); // 反向映射：繁轉簡
            }
        }
    } catch(e) {}
}

    if (needVariants && typeof currentTWVariantsPhrases !== "undefined" && currentTWVariantsPhrases) {
        try {
            const linesTWP = currentTWVariantsPhrases.split("\n");
            for (let i = 0; i < linesTWP.length; i++) {
                let line = linesTWP[i];
                if (!line || line[0] === "#" || line[0] === "\r") continue;
                let tabIndex = line.indexOf("\t");
                if (tabIndex === -1) continue;
                let key = line.substring(0, tabIndex).trim();
                let rest = line.substring(tabIndex + 1);
                let val = rest.split(" ")[0].replace(/\r/g, "").trim();
                if (key.length > 0 && val.length > 0) {
                    twPhrasesMap.set(key, val);
                }
            }
        } catch(e) {}
    }

    const applyTWVariants = (str) => {
        if (!isS2TVariant) return str; 
        let res = "";
        for (let c of str) res += variantMap.has(c) ? variantMap.get(c) : c;
        return res;
    };

    const parseMainData = (rawStr, isCharDict = false) => {
        if (!rawStr) return;
        const lines = rawStr.split("\n");
        let lastLineWasTofuRisk = false; 

        for (let i = 0; i < lines.length; i++) {
            let line = lines[i];
            if (!line || line[0] === "\r") continue;

            // 偵測豆腐字註解
            if (line.indexOf("# @tofu-risk:") !== -1) {
                lastLineWasTofuRisk = true;
                continue;
            }

            // 如果是普通註解則跳過
            if (line[0] === "#") {
                lastLineWasTofuRisk = false;
                continue;
            }

            let tabIndex = line.indexOf("\t");
            if (tabIndex === -1) {
                lastLineWasTofuRisk = false;
                continue;
            }

            let key = line.substring(0, tabIndex);
            if (effectiveContextLogic && ContextLogicAnchors.has(key)) {
                lastLineWasTofuRisk = false;
                continue;
            }

            let rawTarget = line.substring(tabIndex + 1).replace(/\r/g, "");

            // 邏輯介入：滿足 CharactersExt 且前一行是 @tofu-risk
            if (typeof CharactersExt !== "undefined" && CharactersExt === true && lastLineWasTofuRisk) {
                let values = rawTarget.split(" ");
                // 如果第一個字跟 key 相同，就切片取後面的擴充字
                if (values.length > 0 && values[0] === key) {
                    values = values.slice(1);
                }
                rawTarget = values.join(" ");
            }

            lastLineWasTofuRisk = false;

            if (!rawTarget.strip ? !rawTarget.trim() : !rawTarget) continue;

            let spaceIdx = rawTarget.indexOf(" ");
            let firstTarget = (spaceIdx === -1) ? rawTarget : rawTarget.substring(0, spaceIdx);

            let target = (exceptionMap && exceptionMap.has(key)) 
                         ? exceptionMap.get(key) 
                         : (twPhrasesMap.has(firstTarget) ? twPhrasesMap.get(firstTarget) : applyTWVariants(firstTarget));

            if (!finalDict.has(key)) {
                finalDict.set(key, target);
            }

            if (isCharDict && key.length === 1 && rawTarget.length > 0) {
                let tVals = rawTarget.split(" ");
                for (let v = 0; v < tVals.length; v++) {
                    if (tVals[v].length > 0) {
                        let tChar = tVals[v].charAt(0);
                        if (!reverseCharMap.has(tChar)) {
                            reverseCharMap.set(tChar, key);
                        }
                    }
                }
            }
        }
    };

    if (!isShiftPressed) {
        if (typeof currentExceptionData !== "undefined") try { parseMainData(currentExceptionData); } catch(e){}
        if (typeof currentPhraseExpandedData !== "undefined") try { parseMainData(currentPhraseExpandedData); } catch(e){}
    }
    try { if (typeof currentPhraseData !== "undefined") parseMainData(currentPhraseData); } catch(e){}

    if (CURRENT_MODE !== "S2TWP" && CURRENT_MODE !== "TW2SP") {
        try { if (typeof currentCharData !== "undefined") parseMainData(currentCharData, true); } catch(e){}
    }

    if ((CURRENT_MODE === "S2T" || CURRENT_MODE === "S2TE") && twPhrasesMap.size > 0 && reverseCharMap.size > 0) {
        for (let [twKey, twVal] of twPhrasesMap) {
            let scKey = "";
            for (let i = 0; i < twKey.length; i++) {
                let tcChar = twKey[i];
                // 原字形精確反查
                if (reverseCharMap.has(tcChar)) {
                    scKey += reverseCharMap.get(tcChar);
                } else {
                    // 嘗試降維再查
                    let normChar = variantMap.has(tcChar) ? variantMap.get(tcChar) : tcChar;
                    scKey += reverseCharMap.has(normChar) ? reverseCharMap.get(normChar) : tcChar;
                }
            }
            if (!finalDict.has(scKey)) {
                finalDict.set(scKey, twVal);
            }
        }
    }

    if (isS2TVariant) {
        for (let [vKey, vTarget] of variantMap) {
            if (!finalDict.has(vKey)) finalDict.set(vKey, vTarget);
        }
    } else if (isT2SVariant) {
        for (let [twChar, genericChar] of variantMap) {
            if (!finalDict.has(twChar)) {
                if (finalDict.has(genericChar)) {
                    finalDict.set(twChar, finalDict.get(genericChar));
                } else {
                    finalDict.set(twChar, genericChar);
                }
            }
        }
    }

    let logicDataObj = typeof ContextLogicData !== "undefined" ? ContextLogicData : null;
    if (logicDataObj && (effectiveContextLogic || effectiveContextLogic_T2S)) {
        for (let k in logicDataObj) {
            let code = k.startsWith("0x") ? parseInt(k, 16) : k.charCodeAt(0);
            let charKey = String.fromCharCode(code);
            if (!finalDict.has(charKey)) {
                finalDict.set(charKey, charKey);
            }
        }
    }

// Trie 引擎 最佳化(V8 加速)
    status = _L(
        `⏳ Trie Engine V8 Optimization & Processing (${msgModeNameEN})...`, 
        `⏳ 字典樹引擎 V8 最佳化，${msgModeNameTC} 處理中...`, 
        `⏳ 字典树引擎 V8 优化，${msgModeNameSC} 处理中...`
    );

    class TrieNode {
        constructor() {
            this.c = new Map();
            this.v = null;
            this.o = null;
            this.lf = -18.0; // Jieba 分詞對數頻率
            this.mask1 = 0;
            this.mask2 = 0;
        }
    }

    const qBuildMask = (parentNode, nextCharCode) => {
        let bitPos = nextCharCode & 63;
        if (bitPos < 32) {
            parentNode.mask1 |= (1 << bitPos);
        } else {
            parentNode.mask2 |= (1 << (bitPos - 32));
        }
    };

    const qCheckMask = (currentNode, nextCharCode) => {
        let bitPos = nextCharCode & 63;
        if (bitPos < 32) {
            return (currentNode.mask1 & (1 << bitPos)) !== 0;
        } else {
            return (currentNode.mask2 & (1 << (bitPos - 32))) !== 0;
        }
    };

    const rootNodes = new Array(65536);

// 將 PhraseLogic 的首字在 Trie 根節點標記與預編譯
if (typeof PhraseLogic !== "undefined") {
    const isS2TWPMode = (CURRENT_MODE === "S2TWP" || (typeof isS2TVariant !== "undefined" && isS2TVariant));

    for (let pKey in PhraseLogic) {
        if (pKey.length > 0) {
            let code = pKey.charCodeAt(0);
            if (!rootNodes[code]) rootNodes[code] = new TrieNode();
            rootNodes[code].hasPhrase = true;
            if (!rootNodes[code].phraseRules) rootNodes[code].phraseRules = [];

            let originStr = PhraseLogic[pKey];
            let lThres = 4;
            let currentWinSize = 6;
            let pBarrierActive = false;

            if (isS2TWPMode && typeof variantMap !== "undefined" && variantMap.size > 0) {
                let headMatch = originStr.match(/^([^\s]+)\s+([^\s\[]+)/);
                if (headMatch) {
                    let notePart = headMatch[1];
                    let targetPart = headMatch[2];
                    let washedTarget = "";
                    for (let tc of targetPart) { washedTarget += variantMap.has(tc) ? variantMap.get(tc) : tc; }
                    originStr = notePart + " " + washedTarget + originStr.substring(headMatch[0].length);
                    PhraseLogic[pKey] = originStr;
                }
            }

            let paramMatch = originStr.match(/\{([1-9])\s*,\s*([01])(?:\s*,\s*([4-9]))?\}/);
            let ruleStr = originStr;
            if (paramMatch) {
                currentWinSize = parseInt(paramMatch[1], 10);
                pBarrierActive = parseInt(paramMatch[2], 10) === 0;
                if (paramMatch[3] !== undefined) lThres = parseInt(paramMatch[3], 10);
                ruleStr = ruleStr.substring(0, paramMatch.index).trim();
            }

            if (!rootNodes[code].maxThres || lThres > rootNodes[code].maxThres) {
                rootNodes[code].maxThres = lThres;
            }

            let partsOpen = ruleStr.split("[");
            let alternatives = partsOpen[0].split(" ");
            let overTarget = alternatives[1] || alternatives[0];
            let leftTagsRaw = partsOpen[1].split("]")[0].split("|");
            let rightTagsRaw = partsOpen[2].split("]")[0].split("|");

            const parseTags = (tags) => {
                let res = [];
                for (let i = 0; i < tags.length; i++) {
                    let t = tags[i];
                    if (t !== "") {
                        let isEx = t.charAt(0) === "!";
                        let raw = isEx ? t.substring(1) : t;
                        let hasAt = raw.charAt(0) === "@";
                        if (hasAt) raw = raw.substring(1);
                        res.push({ str: raw, len: raw.length, isEx: isEx, hasAt: hasAt, empty: false });
                    } else {
                        res.push({ empty: true });
                    }
                }
                return res;
            };

            rootNodes[code].phraseRules.push({
                key: pKey,
                keyLen: pKey.length,
                winSize: currentWinSize,
                barrierActive: pBarrierActive,
                target: overTarget,
                leftTags: parseTags(leftTagsRaw),
                rightTags: parseTags(rightTagsRaw)
            });
        }
    }
}

    for (let [key, target] of finalDict) {
        if (!key) continue;
        let firstCode = key.charCodeAt(0);
        let node = rootNodes[firstCode];
        if (!node) {
            node = new TrieNode();
            rootNodes[firstCode] = node;
        }

        for (let j = 1; j < key.length; j++) {
            let code = key.charCodeAt(j);
            qBuildMask(node, code);
            let nextNode = node.c.get(code);
            if (!nextNode) {
                nextNode = new TrieNode();
                node.c.set(code, nextNode);
            }
            node = nextNode;
        }
        node.v = target;
        node.o = key;
    }

    // 載入 Jieba 詞典至 Trie 樹
    if (isJiebaActive && currentJiebaData) {
        status = _L(
            `⏳ Trie Engine V8 Optimization & Processing (${msgModeNameEN} with Jieba)...`, 
            `⏳ 字典樹引擎 V8 最佳化，${msgModeNameTC} 處理中 (使用結巴分詞)...`, 
            `⏳ 字典树引擎 V8 优化，${msgModeNameSC} 处理中 (使用结巴分词)...`
        );
        try {
            let lines = currentJiebaData.split("\n");
            const LOG_TOTAL = Math.log(34732707); // 基準總詞頻

            for (let i = 0; i < lines.length; i++) {
                let line = lines[i];
                if (!line) continue;
                let space1 = line.indexOf(" ");
                if (space1 === -1) continue;

                let word = line.substring(0, space1);
                let space2 = line.indexOf(" ", space1 + 1);
                let freqStr = (space2 === -1) ? line.substring(space1 + 1) : line.substring(space1 + 1, space2);
                let freq = parseFloat(freqStr);
                if (isNaN(freq)) continue;

                let logFreq = Math.log(freq) - LOG_TOTAL;

                let firstCode = word.charCodeAt(0);
                let node = rootNodes[firstCode];
                if (!node) {
                    node = new TrieNode();
                    rootNodes[firstCode] = node;
                }
                for (let j = 1; j < word.length; j++) {
                    let code = word.charCodeAt(j);
                    qBuildMask(node, code);
                    let nextNode = node.c.get(code);
                    if (!nextNode) {
                        nextNode = new TrieNode();
                        node.c.set(code, nextNode);
                    }
                    node = nextNode;
                }
                node.lf = logFreq;
            }

            // 載入 UserDict
            if (currentUserDictData) {
                let userLines = currentUserDictData.split("\n");
                for (let i = 0; i < userLines.length; i++) {
                    let line = userLines[i].replace(/\r/g, "");
                    if (!line || line[0] === "#") continue;
                    let parts = line.split(" ");
                    let word = parts[0];
                    if (!word) continue;
                    let freq = 5000; 
                    if (parts.length >= 2) {
                        let parsedFreq = parseFloat(parts[1]);
                        if (!isNaN(parsedFreq)) freq = parsedFreq;
                    }
                    let logFreq = Math.log(freq) - LOG_TOTAL;
                    let firstCode = word.charCodeAt(0);
                    let node = rootNodes[firstCode];
                    if (!node) {
                        node = new TrieNode();
                        rootNodes[firstCode] = node;
                    }
                    for (let j = 1; j < word.length; j++) {
                        let code = word.charCodeAt(j);
                        let nextNode = node.c.get(code);
                        if (!nextNode) {
                            nextNode = new TrieNode();
                            node.c.set(code, nextNode);
                        }
                        node = nextNode;
                    }
                    node.lf = logFreq;
                }
            }
        } catch(e) {}
    }

// 載入 HMM 模型參數 (手寫解析器) 
    const hmmStart = new Float64Array(4).fill(-3.14e100);
    const hmmTrans = new Float64Array(16).fill(-3.14e100);
    const hmmEmit = [
        new Float64Array(65536).fill(-3.14e100), // 0: B
        new Float64Array(65536).fill(-3.14e100), // 1: M
        new Float64Array(65536).fill(-3.14e100), // 2: E
        new Float64Array(65536).fill(-3.14e100)  // 3: S
    ];
    let isHmmLoaded = false;
    let hmmModel = null;

    if (isJiebaActive && currentHmmData) {
        try {
            hmmModel = { 
                start_p: {}, 
                trans_p: { B:{}, E:{}, M:{}, S:{} }, 
                emit_p: { B:{}, E:{}, M:{}, S:{} } 
            };

            let lines = currentHmmData.split(/\r?\n/);
            let states = ['B', 'E', 'M', 'S']; // 檔案的原始順序

            // 索引映射表：將檔案順序 (B=0, E=1, M=2, S=3) 轉為內部順序 (B=0, M=1, E=2, S=3)
            const f2i = { 'B': 0, 'M': 1, 'E': 2, 'S': 3 };
            const fIdx2iIdx = [0, 2, 1, 3]; // 檔案索引 1(E) 對應內部 2, 檔案索引 2(M) 對應內部 1

            for (let i = 0; i < lines.length; i++) {
                let line = lines[i].replace(/\r/g, "").trim();

                if (line === "#prob_start") {
                    let vals = lines[i+1].trim().split(/\s+/);
                    for (let j = 0; j < 4; j++) {
                        let val = parseFloat(vals[j]);
                        hmmModel.start_p[states[j]] = val;
                        // 同步至矩陣：對應 BEMS -> BMES
                        hmmStart[fIdx2iIdx[j]] = val;
                    }
                }

                if (line === "#prob_trans 4x4 matrix") {
                    for (let j = 0; j < 4; j++) {
                        let row = lines[i+1+j].trim().split(/\s+/);
                        let fromState = states[j];
                        let fromIdx = fIdx2iIdx[j];
                        for (let k = 0; k < 4; k++) {
                            let val = parseFloat(row[k]);
                            hmmModel.trans_p[fromState][states[k]] = val;
                            // 同步至矩陣：對應 (from)BEMS -> (to)BEMS 映射至內部
                            let toIdx = fIdx2iIdx[k];
                            hmmTrans[fromIdx * 4 + toIdx] = val;
                        }
                    }
                }

                if (line === "#prob_emit 4 lines") {
                    for (let j = 0; j < 4; j++) {
                        let stateChar = states[j];
                        let internalIdx = f2i[stateChar];
                        let foundIdx = -1;
                        for (let k = i; k < lines.length; k++) {
                            if (lines[k].trim() === "#" + stateChar) {
                                foundIdx = k;
                                break;
                            }
                        }
                        if (foundIdx !== -1) {
                            let dataLine = lines[foundIdx + 1];
                            let pairs = dataLine.split(",");
                            for (let p = 0; p < pairs.length; p++) {
                                let kv = pairs[p].split(":");
                                if (kv.length === 2) {
                                    let val = parseFloat(kv[1]);
                                    hmmModel.emit_p[stateChar][kv[0]] = val;

                                    let code = kv[0].charCodeAt(0);
                                    if (code < 65536) {
                                        hmmEmit[internalIdx][code] = val;
                                    }
                                }
                            }
                        }
                    }
                    isHmmLoaded = true;
                }
            }
        } catch(e) {
            hmmModel = null; // 若解析失敗，退回無 HMM 模式
            isHmmLoaded = false;
        }
    }

    const activeLogicArr = new Array(65536);
    let hasLogic = false;

    if (logicDataObj && (effectiveContextLogic || effectiveContextLogic_T2S)) {
        hasLogic = true;
        const mVal = typeof m !== "undefined" ? m : "";
        const sn2Raw = typeof sn2 !== "undefined" ? sn2 : "";

        const sn2Set = new Set();
        let sn2Words = sn2Raw.split("|");
        for (let w = 0; w < sn2Words.length; w++) {
            if (sn2Words[w].length === 2) sn2Set.add(sn2Words[w]);
        }

        for (let key in logicDataObj) {
            let anchorCode = key.startsWith("0x") ? parseInt(key, 16) : key.charCodeAt(0);
            let rulesRaw = logicDataObj[key];
            let compiledRules = [];

            // 預先解析規則字串為物件
            for (let r = 0; r < rulesRaw.length; r++) {
                let line = rulesRaw[r].trim();
                if (!line) continue;

                let arrowIdx = line.indexOf("=>");
                if (arrowIdx === -1) continue;

                let condPart = line.substring(0, arrowIdx).trim();
                let targetPart = line.substring(arrowIdx + 2).trim();

                if (condPart.startsWith("default")) {
                    compiledRules.push({ isDefault: true, target: targetPart });
                    continue;
                }

                let conds = [];
                let condParts = condPart.split(" ");
                for (let c = 0; c < condParts.length; c++) {
                    let temp = condParts[c].trim();
                    if (!temp) continue;

                    let isEx = false;
                    if (temp.charAt(0) === "!") { isEx = true; temp = temp.substring(1); }

                    let colonIdx = temp.indexOf(":");
                    if (colonIdx === -1) continue;

                    let offset = parseInt(temp.substring(0, colonIdx), 10);
                    let charSet = temp.substring(colonIdx + 1);
                    let isSn2 = false;

                    if (charSet === "@sn2") {
                        isSn2 = true;
                    } else {

                        charSet = charSet.replace(/@m/g, mVal).replace(/@s/g, " \r\n");
                    }
                    conds.push({ offset: offset, charSet: charSet, isExclude: isEx, isSn2: isSn2 });
                }
                compiledRules.push({ isDefault: false, conds: conds, target: targetPart });
            }

            activeLogicArr[anchorCode] = function(idx, text) {
                for (let r = 0; r < compiledRules.length; r++) {
                    let rule = compiledRules[r];
                    if (rule.isDefault) return rule.target;

                    let isMatch = true;
                    for (let c = 0; c < rule.conds.length; c++) {
                        let cond = rule.conds[c];
                        let targetIdx = idx + cond.offset;

                        if (cond.isSn2) {
                            let exists = false;
                            if (targetIdx >= 0 && targetIdx + 1 < text.length) {
                                let sn2Key = text.substring(targetIdx, targetIdx + 2);
                                if (sn2Set.has(sn2Key)) exists = true;
                            }
                            if (cond.isExclude) { if (exists) { isMatch = false; break; } }
                            else { if (!exists) { isMatch = false; break; } }
                        } else {
                            let testChar = (targetIdx >= 0 && targetIdx < text.length) ? text.charAt(targetIdx) : ' ';
                            let charExists = cond.charSet.indexOf(testChar) !== -1;
                            if (cond.isExclude) { if (charExists) { isMatch = false; break; } }
                            else { if (!charExists) { isMatch = false; break; } }
                        }
                    }
                    if (isMatch) return rule.target;
                }
                return null;
            };
        }
    }

// 宣告 Viterbi 專用的全域緩衝區
const HMM_MAX_WORDS = 256; 
const vitVBuf = new Float64Array(HMM_MAX_WORDS * 4);
const vitBpBuf = new Int32Array(HMM_MAX_WORDS * 4);
const vitSpBuf = new Int32Array(HMM_MAX_WORDS);

const doConvert = (srcText) => {
        let textLen = srcText.length;

        if (typeof isSegmentDisplay !== "undefined" && isSegmentDisplay && isJiebaActive) {
            if (selectedLines > 10) {
                var sLines = _L(
                    "Jieba Segment Display Mode (Caps Lock ON) is limited to 10 lines.",
                    "結巴分詞顯示模式 (Caps Lock 已啟用) 限制為 10 行以內。",
                    "结巴分词显示模式 (Caps Lock 已打开) 限制为 10 行以内。"
                );
                alert(sLines); ShowTip("", eeShowTipHide); Quit();
            }
            if (textLen > 200) {
                var sChars = _L(
                    "Jieba Segment Display Mode (Caps Lock ON) is limited to 200 characters.",
                    "結巴分詞顯示模式 (Caps Lock 已啟用) 限制為 200 字元以內。",
                    "结巴分词显示模式 (Caps Lock 已打开) 限制为 200 字符以内。"
                );
                alert(sChars); ShowTip("", eeShowTipHide); Quit();
            }
        }

        // 相容字安全查表換字閘道 - V8 快取優化版
        let compatReplaceCount = 0;
        let hasCompat = false;

        if (!isAltPressed) {
            // 極速探查：0 開銷掃描 CJK 相容區
            for (let k = 0; k < textLen; k++) {
                let c = srcText.charCodeAt(k);
                if ((c >= 0xF900 && c <= 0xFAFF) || (c >= 0xD840 && c <= 0xD87F)) {
                    hasCompat = true;
                    break;
                }
            }

            // 動態指標重組
            if (hasCompat) {
                let cleanArr = [];
                let lastIdx = 0;
                let k = 0;

                while (k < textLen) {
                    let cp = srcText.codePointAt(k);
                    let step = (cp > 0xFFFF) ? 2 : 1;

                    if (cp >= 0xF900 && FastReplaceMap.has(cp)) {
                        if (k > lastIdx) {
                            cleanArr.push(srcText.substring(lastIdx, k));
                        }

                        let rep = FastReplaceMap.get(cp);
                        cleanArr.push(String.fromCodePoint(rep));
                        compatReplaceCount++;

                        lastIdx = k + step;
                    }
                    k += step;
                }

                if (lastIdx < textLen) {
                    cleanArr.push(srcText.substring(lastIdx, textLen));
                }

                srcText = cleanArr.join("");
                textLen = srcText.length;
                cleanArr = null;
            }
        }

        let masterOut = [];
        let out = [];
        let i = 0;
        let lastMatchEnd = 0;

        // 預載變更狀態
        let replaceCount = compatReplaceCount;
        let hasReplacements = hasCompat;
        const fastSkipLimit = (CURRENT_MODE === "S2TWP" || CURRENT_MODE === "TW2SP") ? 0x21 : 0x80;

        // 配置加分與懲罰常數 (權重控制面板)
        const DICT_BONUS_2 = 3.0; // 二字詞加分
        const DICT_BONUS_3 = 7.0; // 三字詞加分
        const DICT_BONUS_4 = 17.0; // 四字詞(含以上)加分：成語保護區
        const PENALTY_ONE_TO_MANY = -7.0; // 一對多單字懲罰：提高單字成詞門檻

        // 動態加扣分常數
        const PENALTY_VISION_2    = -2.5;  // VisionAnchors 2字詞扣分
        const PENALTY_VISION_3    = -0.5;  // VisionAnchors 3字詞(含以上)扣分
        const PENALTY_CTX         = -0.5;  // ContextLogicAnchors 扣分
        const BONUS_VISION_VOCAB  = 15.0; // VisionVocabs 加分

        // 結巴詞頻分層加分 (8階，基於 N=6000萬門檻)
        const FREQ_BONUS_GODLY = 11.0; // 6001次以上
        const FREQ_BONUS_LEGENDARY = 9.0; // 3001~6000次
        const FREQ_BONUS_EPIC = 7.0; // 2001~3000次
        const FREQ_BONUS_ELITE = 5.0; // 1001~2000次
        const FREQ_BONUS_HIGH = 3.5; // 101~1000次
        const FREQ_BONUS_MID = 2.0; // 11~100次
        const FREQ_BONUS_LOW = 0.5; // 4~10次
        const FREQ_BONUS_FEW = 0.1; // 1~3次

        const ONE_TO_MANY_S2T = "㐹万丑个丰了于云亘仆仇仑价仿伙余佛佣俊修借僵克党具冢冬冲凄准凌几凶出划别刮制勋千升卜占卤卷厂历厘参发只台叶叹吁吃合吊同后向吣呆周咨咸咽哄哗唇啮喂噪回团困坐坛坝坯埙堤复夫夸夹奸姜娘娴宁它家尝尸尽局岩岳巨布帘席干并幸广庵弥弦当录彩征径御志念恤恶愈愿戚扇才扎托扣折抵拐拿挂挨挽捆捍据搜摆斗斤斫旋昆暗曲札术朱朴杆杠杯杰松板极果枪柜栗核梁棱檗欲毁汇沈沾泛注浚涂涌淀游溪滟漓澄炼烟焰熏狸玩琅璇症皂矩确硷私秋种穗筑筱签糊系累纤绱绷耇胄背胜胡脏腊腌膻致舍艳芸苏苔苹范荐荡荫药获蒙蔑藤虫蚝蜡蝎表袅裥证谥谷豆象赝赞跖辟迹适郁酸采里鉴针钟钥钫钻铲链锄锫镋镎镢镰闲雕面须饥鹇洒虱湿袜";
        const ONE_TO_MANY_T2S = "么乾仝俱像儘剋劃劄勣叚吒哩喆噁噹坏堃夥崙廬彷徵戰扞擣於昇椀椏氾沈淼澂瀋瀰牴犇甦甯畫瞭礆祇祕筦箚絜綵線耑脩菉蒐薹藉蘋衹袷襬覆託訢諫諮譾讎谿貲買迺逕邨釐鉅鍊鍾鏇鑪钁開閒阪陞靦韝頫願颺餘餬餱餵驄鵰麪麴麵麼麽齧龢";

        const isOneToManyArr = new Uint8Array(65536);
        const targetOneToManyList = (CURRENT_MODE === "S2T" || CURRENT_MODE === "S2TE") ? ONE_TO_MANY_S2T : ONE_TO_MANY_T2S;

        for (let k = 0; k < targetOneToManyList.length; k++) {
