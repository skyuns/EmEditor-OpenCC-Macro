    0x51FA: function(i,t){var p=t.charAt(i-1)||" ",n=t.charAt(i+1)||" ",n2=t.charAt(i+2)||" ",pp=t.charAt(i-2)||" ";return((m+"这那哪整半").indexOf(p)!==-1&&(("戏剧".indexOf(n)!==-1&&"院场".indexOf(n2)===-1)||(n==="电"&&n2==="影")||(n==="："&&pp==="第")))?"齣":"出";},
    // 11. 别	別 彆
    0x522B: function(i,t){var n=t.charAt(i+1)||" ",nn=t.charAt(i+2)||" ";return("强扭气着嘴".indexOf(n)!==-1&&"腰屁身肢脖头手脚动走转了死馁我你他她它人求迫笑急凉忙火硬贱臭甜多碎快馋歪坏到过伤恼愤空虚喘鼓得出咱谁巴噗怒软笨滑辩占攻盛炸呼慌迷魔捏打奸送贫严松撑忍推疯闷嘟相道意曲过欠干买卖粗短笔墨结要暴制拉脸开塞衰力边刁巧行闯摆掉冲话实重对痒取留紧亏度吞陆眼毒乖拆索渡住断脱派量昂调想手尖笑皮".indexOf(nn)===-1)?"彆":"別";},
    // 12. 刮	刮 颳
    0x522E: function(i,t){var p=t.charAt(i-1)||" ",n=t.charAt(i+1)||" ",n2=t.charAt(i+2)||" ";return("台颱飓阵龙".indexOf(n)!==-1||(n==="了"&&"风台".indexOf(n2)!==-1)||(n==="得"&&"大猛".indexOf(n2)!==-1))?"颳":"刮";},
    // 13. 制	制 製
    0x5236: function(i,t){var p=t.charAt(i-1)||" ",n=t.charAt(i+1)||" ";return("金银铜铁铝锌钢木纸棉毛麦粉乳奶石牙芦荟苇蔗藤籐柳棕桃板檀珊瑚珍珠泥塑玻布国羽丝绒线湾果晶毡器骨髓鬃岩录扎".indexOf(p)!==-1||"作物图片药衣皮鞋剂版碟单表果酱面糕豆篮筐肥刀香油裘雪奶乳酪氢氧玻".indexOf(n)!==-1)?"製":"制";},
