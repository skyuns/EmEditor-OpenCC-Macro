    // 6. 借	借 藉
    // 0x501F: 僅處理交叉歧義與雙關陷阱。
    // 7. 冲	衝 沖
    0x51B2: function(i,t){var p=t.charAt(i-1)||" ",n=t.charAt(i+1)||" ",n2=t.charAt(i+2)||" ",pp=t.charAt(i-2)||" ";return(n!=="击"&&("洗净澹融煞咖奶调杯壶瓶罐牛点马澡淋凉干成岸滩向酒巧床头压".indexOf(n)!==-1||"气雨瀑海河水船潮汐流".indexOf(p)!==-1||"气雨瀑海河水船潮汐流马".indexOf(pp)!==-1||(n==="了"&&"个马一冲".indexOf(n2)!==-1)||(n==="干"&&n2==="净")||(p==="当"&&pp!=="应"&&n!=="第")))?"沖":"衝";},
