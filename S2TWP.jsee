    0x5582: function(i,t){var p=t.charAt(i-1)||" ",n=t.charAt(i+1)||" ",n2=t.charAt(i+2)||" ";return("亲子瓶匙勺杓乳父母爸妈爷奶饭草料肉自动勤他手上午侧躺".indexOf(p)!==-1||"大幼点些以这那入人他她吃父母爸妈爷奶祖孙孩婴宝药汤进服在往到肚毒鲨狮鹰鸽兔猫猴蚂家牲血水肉鸟粮草剑招".indexOf(n)!==-1||(n==="小"&&"李王张陈刘林明吴刘赵郭蔡".indexOf(n2)===-1))?"餵":"喂";},
