    // 0x5382: 僅處理交叉歧義與雙關陷阱。
    // 15. 历	歷 曆
    0x5386: function(i,t){var p=t.charAt(i-1)||" ",n=t.charAt(i+1)||" ";return(p==="教"&&(m+"的 ").indexOf(n)!==-1||"文马兰犹佛回林".indexOf(p)!==-1&&" 的".indexOf(n)!==-1||"钟鐘".indexOf(n)!==-1)?"曆":"歷";},
    // 16. 发	發 髮
    0x53D1: function(i,t){var p=t.charAt(i-1)||" ",n=t.charAt(i+1)||" ",n2=t.charAt(i+2)||" ";return(p==="散"&&"出着香热气单".indexOf(n)!==-1||p==="生"&&"出中".indexOf(n)!==-1||p==="乱"&&("脾疯愁财货票奖薪电邮信布表".indexOf(n)!==-1||n==="色"&&n2==="情"||n==="文"&&n2==="章"||"贴".indexOf(n)!==-1)||n==="卷"&&"子宗".indexOf(n2)!==-1||n==="色"&&"幕板影显示器".indexOf(p)!==-1)?"發":("理洗修剪剃梳束扎披结染烫插整洁翦头白黑长短假毫须乱蓬松柔金银灰乌丝秀鬈卷秃脱华皓鬐鬋髶髹髺髽髾鬃鬄髦".indexOf(p)!==-1||"卡冠缏髻髲鬄鬈绺胶夹簪带箍丝型辫根梢脚际乳质妻尾带廊式指旋禁肤色菜饰".indexOf(n)!==-1)?"髮":"發";},
