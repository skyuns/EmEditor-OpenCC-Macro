    // 20. 咸	鹹 咸
    0x54B8: function(i,t){var p=t.charAt(i-1)||" ",n=t.charAt(i+1)||" ";return("荐谓仰诵睹畏叩悦惊黜竭秩平腓服恩淳命卦秦京丘康韵熙姣举执讳".indexOf(n)!==-1||("碧傅崔包陈姓官士".indexOf(p)!==-1&&"酥饼鸡鸭猪牛香甜贝泡塔巴舒豆奶面风".indexOf(n)===-1))?"咸":"鹹";},
