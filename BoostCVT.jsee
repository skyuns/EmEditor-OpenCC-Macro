#language="JScript"

// Project: OpenCC for EmEditor Macro v0.39 BoostCVT
// Author: skyuns (https://github.com/skyuns/EmEditor-OpenCC-Macro 備援: https://gitcode.com/skyuns/EmEditor-OpenCC-Macro)
// Purpose: 中介加速腳本，負責執行智慧切塊並呼叫 BoostCVT 增壓引擎，以自動變速方式進行大規模文字的多執行緒高速繁簡轉換。支援 S2T/T2S 雙向模式。
// Note: 加速組件為選配項目，僅在大規模文字且組件存在時啟動。使用者可視需求自由部署，只需 EXE 或 DLL 其中一種即可；使用時須經由 .jsee 腳本驅動，不支援獨立運作。

var wsh = new ActiveXObject("WScript.Shell");
var fso = new ActiveXObject("Scripting.FileSystemObject");
var scriptDir = fso.GetParentFolderName(ScriptFullName);
var exePath = fso.BuildPath(scriptDir, "BoostCVT.exe");
var dllPath = fso.BuildPath(scriptDir, "BoostCVT.dll");
var oldMacroPath = fso.BuildPath(scriptDir, "T2S.jsee"); // 預設路徑

var msgModeNameTC = "繁轉簡";
var msgModeNameSC = "繁转简";
var msgModeNameEN = "T2S";

// 讀取剪貼簿中的參數 (格式: BoostCVT_CONFIG_TOKEN|模式|主巨集路徑|模擬|語法|視界|外部詞典|Jieba開關|HMM上限)
var mode = "T2S";
var isCtx = "1";
var isVis = "1";
var isExtDict = "0";
var isJieba = "0";
var hmmLimit = "100";

// 偵測鍵盤狀態
var isShift = (shell.GetKeyState(0x10) < 0) ? "1" : "0";
var isAlt   = (shell.GetKeyState(0x12) < 0) ? "1" : "0";

var configData = clipboardData.getData("Text");

// 🕵️ 任務 A：輕量偵察兵 (檢查及載入詞典)
if (configData && configData.indexOf("BoostCVT_LOAD_DICT|") === 0) {
    var parts = configData.split("|");
    var dictMode = parts[1];
    var jseePath = parts[2];
    var needJieba = (parts.length > 3 && parts[3] === "1");
    var dictDir = fso.BuildPath(scriptDir, "dictionary");

    // 1. 定義映射矩陣 (與 C# 同步)
    var fPhrase = "", fChar = "", fVariant = "TWVariants.txt", fPhraseExp = "", fException = "";
    if (dictMode === "T2S") { fPhrase = "TSPhrases.txt"; fChar = "TSCharacters.txt"; fPhraseExp = "T2SrawPhraseExpandedData.txt"; fException = "T2SrawExceptionData.txt"; }
    else if (dictMode === "S2T" || dictMode === "S2TE") { 
        fPhrase = "STPhrases.txt"; fChar = "STCharacters.txt"; 
        fPhraseExp = (dictMode === "S2TE") ? "S2TErawPhraseExpandedData.txt" : "S2TrawPhraseExpandedData.txt";
        fException = "S2TrawExceptionData.txt";
    }
    else if (dictMode === "S2TWP") { fPhrase = "TWPhrases.txt"; fPhraseExp = "S2TWPrawPhraseExpandedData.txt"; fVariant = ""; }
    else if (dictMode === "TW2SP") { fPhrase = "TWPhrasesRev.txt"; fPhraseExp = "TW2SPrawPhraseExpandedData.txt"; fVariant = ""; }

    // 結巴相關檔案路徑與優先級判定
    var dictBigPath = fso.BuildPath(dictDir, "dict.txt.big");
    var targetJiebaName = fso.FileExists(dictBigPath) ? "dict.txt.big" : "jieba.dict.utf8";
    var userDictName = "user.dict.utf8";
    var hmmModelName = "hmm_model.utf8";

    // 2. 檢查日期：是否有任何 TXT 比 JSEE 新？ (加入結巴三劍客進行日期比對)
    var jseeDate = fso.FileExists(jseePath) ? fso.GetFile(jseePath).DateLastModified : new Date(0);
    var hasNew = false;
    var checkList = [fPhrase, fChar, fVariant, fPhraseExp, fException, targetJiebaName, userDictName, hmmModelName];

    for (var i = 0; i < checkList.length; i++) {
        var fName = checkList[i];
        if (fName) {
            var txtPath = fso.BuildPath(dictDir, fName);
            if (fso.FileExists(txtPath) && fso.GetFile(txtPath).DateLastModified > jseeDate) {
                hasNew = true;
                break;
            }
        }
    }

    // 讀取邏輯
    var mustReadJieba = (needJieba && (fso.FileExists(fso.BuildPath(dictDir, "jieba.dict.utf8")) || fso.FileExists(dictBigPath)));
    var mustReadUser = (needJieba && fso.FileExists(fso.BuildPath(dictDir, userDictName)));
    var mustReadHmm = (needJieba && fso.FileExists(fso.BuildPath(dictDir, hmmModelName)));

    // 3. 若有更新 或 必須讀取結巴
    if (hasNew || mustReadJieba) {
        function readTxt(name, force) {
            if (!name) return "";
            var p = fso.BuildPath(dictDir, name);
            if (!fso.FileExists(p)) return "";

            // 檔案比 JSEE 新 或 強制讀取時，才執行讀取
            var isThisFileNewer = (fso.GetFile(p).DateLastModified > jseeDate);

            if (isThisFileNewer || force) {
                try {
                    var stream = new ActiveXObject("ADODB.Stream");
                    stream.Type = 2;
                    stream.Charset = "utf-8";
                    stream.Open();
                    stream.LoadFromFile(p);
                    var txt = stream.ReadText();
                    stream.Close();
                    return txt;
                } catch(e) { return ""; }
            }
            
            // 如果檔案日期不夠新，回傳空字串，讓 V8 觸發 Fallback
            return ""; 
        }
        // 🌟 封裝 8 個區塊
        var outData = [
            readTxt(fPhrase, false), 
            readTxt(fChar, false), 
            readTxt(fVariant, false), 
            readTxt(fPhraseExp, false), 
            readTxt(fException, false), 
            // 只有 needJieba 開啟時，才允許 readTxt 去讀結巴詞典
            (needJieba ? readTxt(targetJiebaName, mustReadJieba) : ""),
            (needJieba ? readTxt(userDictName, mustReadUser) : ""),
            (needJieba ? readTxt(hmmModelName, mustReadHmm) : "")
        ];
        clipboardData.setData("Text", outData.join("|||BLOCK_SEP|||"));
    } else {
        clipboardData.setData("Text", "0");
    }
    Quit(); // 🛑 任務完成，結束腳本，不啟動引擎
}

// 🚜 任務 B：重裝變速箱 (大規模文字轉換邏輯)
if (configData && configData.indexOf("BoostCVT_CONFIG_TOKEN|") === 0) {
    var parts = configData.split("|");
    // 🌟 9 段參數：TOKEN, Mode, Path, Sim, Ctx, Vis, ExtDict, Jieba, HMMLimit
    if (parts.length >= 7) {
        mode = parts[1];
        oldMacroPath = parts[2];
        isCtx = (parts[4] === "true") ? "1" : "0";
        isVis = (parts[5] === "true") ? "1" : "0";
        isExtDict = (parts[6] === "true") ? "1" : "0";
        if (parts.length >= 9) {
            isJieba = (parts[7] === "true") ? "1" : "0";
            hmmLimit = parts[8];
        }

        switch(mode) {
            case "T2S":
                msgModeNameTC = "繁轉簡"; msgModeNameSC = "繁转简"; msgModeNameEN = "T2S"; break;
            case "S2T":
                msgModeNameTC = "簡轉繁"; msgModeNameSC = "简转繁"; msgModeNameEN = "S2T"; break;
            case "S2TE":
                msgModeNameTC = "簡轉繁: 擴充版"; msgModeNameSC = "简转繁: 扩充版"; msgModeNameEN = "S2T: Expanded"; break;
            case "S2TWP":
                msgModeNameTC = "用語轉換: 大陸 ➔ 台灣"; msgModeNameSC = "用语转换: 大陆 ➔ 台湾"; msgModeNameEN = "Terminology: CN->TW"; break;
            case "TW2SP":
                msgModeNameTC = "用語轉換: 台灣 ➔ 大陸"; msgModeNameSC = "用语转换: 台湾 ➔ 大陆"; msgModeNameEN = "Terminology: TW->CN"; break;
            default:
                msgModeNameTC = "文字"; msgModeNameSC = "文本"; msgModeNameEN = "Text"; break;
        }
    }
}

// 🌟 第一階段封裝成 8 段式旗標
var configFlags = mode + "|" + isCtx + "|" + isVis + "|" + isShift + "|" + isAlt + "|" + isExtDict + "|" + isJieba + "|" + hmmLimit;

function _L(en, tc, sc) {
    var lang = editor.LangID;
    if (lang == 1028) return tc;
    if (lang == 2052) return sc;
    return en;
}

function getMsgProcessing(p, threads) {
    var steps = "▁▃▅▇";
    var fullStr  = "▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇";
    var trackStr = "▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁";
    var bar = "";
    if (p >= 99) bar = fullStr.substring(0, 19) + "▅"; 
    else {
        var filledCount = Math.floor(p / 5);
        var remainder = p % 5;
        var stepIdx = Math.floor((remainder / 5) * 4);
        var bar = fullStr.substring(0, filledCount) + steps.charAt(stepIdx) + trackStr.substring(0, 19 - filledCount);
    }
    var pStr = (p < 10) ? "0" + p : p;
    var msg = (p >= 99) ? 
        _L("⏳ Integrating data, please wait...", "⏳ " + msgModeNameTC + " 資料整合中，請稍候...", "⏳ " + msgModeNameSC + " 数据整合中，请稍候...") :
        _L("⏳ Processing data, please wait...", "⏳ " + msgModeNameTC + " 資料處理中，請稍候...", "⏳ " + msgModeNameSC + " 数据处理中，请稍候...");

    var boostInfo = _L(
        "(" + threads + " threads, BoostCVT Engine)",
        "(" + threads + " 執行緒，BoostCVT 增壓引擎)",
        "(" + threads + " 线程，BoostCVT 增压引擎)"
    );

    return msg + "\n" + bar + " " + pStr + "%\n" + boostInfo;
}

function main() {
    var sel = document.selection;
    if (sel.IsEmpty) {
        alert(_L("No text selected.", "未選取文字", "未选中文本"));
        return;
    }

    // 1. 備份剪貼簿
    var backupClip = clipboardData.getData("Text");

    var startTime = Date.now();
    var topY = sel.GetTopPointY(eePosLogical);
    var bottomY = sel.GetBottomPointY(eePosLogical);
    var topX = sel.GetTopPointX(eePosLogical);
    var bottomX = sel.GetBottomPointX(eePosLogical);
    var txtlen = sel.TextLength;
    var selectedLines = bottomY - topY + 1;

    // 2. 切塊邏輯基準，核心變速箱 (Continuously Variable Transmission)
    var numChunks = 1;
    if (txtlen > 0) {
        // 彈性變速
        var divisor = (txtlen > 360000000) ? 180000000 :
                                (txtlen > 120000000) ? 60000000 : 30000000;
        numChunks = Math.ceil(txtlen / divisor);
    } else {
        if (selectedLines <= 2000) {
            numChunks = Math.max(1, Math.ceil(selectedLines / 400));
        } else if (selectedLines <= 10000) {
            numChunks = Math.floor(5 + (selectedLines - 2000) / 533);
        } else {
            numChunks = Math.min(100, Math.floor(20 + (selectedLines - 10000) / 166333));
        }
    }
    var linesPerChunk = Math.ceil(selectedLines / numChunks);
    if (linesPerChunk < 1) linesPerChunk = 1;

    // 動態偵測執行緒
    var envCores = shell.GetEnv("NUMBER_OF_PROCESSORS");
    var totalLogical = envCores ? parseInt(envCores, 10) : 4;
    var threadCount = Math.floor(totalLogical * 0.75);

    if (isNaN(threadCount) || threadCount < 2) threadCount = 2;
    if (threadCount > 12) threadCount = 12;

    var totalReplaced = 0;
    try { Redraw = false; } catch(e) {}
    try { var originalCombine = CombineHistory; CombineHistory = true; } catch(e) {}

    var realBottomX = bottomX;
    var realBottomY = bottomY;

    try {
        var currentOrigTopY = topY;
        var lineOffset = 0; 
        var SAFE_CHAR_LIMIT = 200000000; // 安全線：2 億字元 (約 400MB 記憶體)

        // 如果總字元數小於安全極限，則不做動態收縮檢查
        var skipLengthCheck = (txtlen > 0 && txtlen <= SAFE_CHAR_LIMIT);

        // 3. 逐塊動態收縮與轉換 (Adaptive Line Chunking) 
        var step = linesPerChunk; // 變速箱步進變數 (具備記憶功能)

        while (currentOrigTopY <= bottomY) {
            // 進度計算
            var currentOrigBottomY = Math.min(currentOrigTopY + step - 1, bottomY);
            var progress = Math.min(99, Math.round(((currentOrigBottomY - topY + 1) / selectedLines) * 99));

            var currentTopY = currentOrigTopY + lineOffset;

            // 嘗試以最大步伐 (或上一圈的記憶步伐) 往前邁進
            var currentOrigBottomY = Math.min(currentOrigTopY + step - 1, bottomY);
            var currentBottomY = currentOrigBottomY + lineOffset;

            var isFirst = (currentOrigTopY === topY);
            var isLast = (currentOrigBottomY === bottomY);

            sel.Collapse();
            // 設定起點
            if (isFirst) sel.SetAnchorPoint(eePosLogical, topX, currentTopY);
            else sel.SetAnchorPoint(eePosLogical, 1, currentTopY);

            // 設定初步終點
            if (isLast) sel.SetActivePoint(eePosLogical, bottomX, currentBottomY, true);
            else sel.SetActivePoint(eePosLogical, 1, currentBottomY + 1, true);

            var len = 0;

            // 總字元數大於安全線時，執行長度檢測與動態降檔
            if (!skipLengthCheck) {
                // 索取當前選取範圍的字元長度
                len = sel.TextLength;

                // 動態收縮核心 (Adaptive Shrinking) 
                // 🛑 降檔 (Downshift) 邏輯：如果選取範圍超過安全線，將行數砍半，直到降至安全區間內 
                while (len > SAFE_CHAR_LIMIT && currentOrigBottomY > currentOrigTopY) {
                    step = Math.floor(step / 2);
                    if (step < 1) step = 1;

                    currentOrigBottomY = currentOrigTopY + step - 1;
                    currentBottomY = currentOrigBottomY + lineOffset;
                    isLast = (currentOrigBottomY === bottomY);

                    // 重新定位終點
                    if (isLast) sel.SetActivePoint(eePosLogical, bottomX, currentBottomY, true);
                    else sel.SetActivePoint(eePosLogical, 1, currentBottomY + 1, true);

                    // 再次探測字元長度
                    len = sel.TextLength;
                }

                // 單行字元數攔截
                if (len > 100000000 && currentOrigBottomY === currentOrigTopY) {
                    status = "";
                    alert(_L("⚠️ Single line exceeds 200MB limit. Conversion aborted.", "⚠️ 單行字元數超過 200MB 極限，為避免記憶體溢位，已中止轉換作業。", "⚠️ 单行字符数超过 200MB 极限，为避免内存溢出，已中止转换程序。"));
                    Quit();
                }
            }

            if (sel.TextLength === 0) {
                // 萬一抓空，推進行數
                currentOrigTopY = currentOrigBottomY + 1;
                continue;
            }

            clipboardData.setData("Text", sel.Text);
            // 顯示進度
            ShowTip(getMsgProcessing(progress, threadCount), 1);

            // 📌 紀錄貼上前底部的 Y 座標 (用以計算精確偏移量)
            var yBeforePaste = sel.GetBottomPointY(eePosLogical);

            // 🌟 第二階段封裝：加上 Threads
            var dynamicFlags = configFlags + "|" + threadCount;

            // 宣告 runCount 來承接 C# 傳回的 Exit Code
            var runCount = 0;

            // 增壓引擎呼叫邏輯：EXE 優先，DLL 為輔
            if (fso.FileExists(exePath)) {
                var cmd = '"' + exePath + '" "' + oldMacroPath + '" "' + dynamicFlags + '"';
                runCount = wsh.Run(cmd, 0, true);
            } 
            else if (fso.FileExists(dllPath)) {
                var psCommand = "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"" +
                    "[Reflection.Assembly]::LoadFile('" + dllPath.replace(/\\/g, "/") + "') | Out-Null; " +
                    "$c = [MyTools.TextProcessor]::Convert('" + oldMacroPath.replace(/\\/g, "/") + "', '" + dynamicFlags + "'); exit $c\"";
                runCount = wsh.Run(psCommand, 0, true);
            }

            // 🛑 緊急煞車機制
            // 如果 runCount 為 -1 (或是 32-bit/64-bit 溢位)，代表引擎拒絕服務
            if (runCount === -1 || runCount === 4294967295) {
                ShowTip("", 0);

                // 丟出 Error 物件，跳出當前的 while 迴圈，直奔 main() 最後的 catch 區塊
                throw new Error(_L(
                    "BoostCVT Engine error or version mismatch. Operation aborted.",
                    "BoostCVT 回傳錯誤或版本不符，已中止轉換作業。",
                    "BoostCVT 回传错误或版本不符，已中止转换程序。"
                ));
            }

            var newText = clipboardData.getData("Text");
            if (newText !== null && runCount > 0) { 
                var sepIdx = newText.lastIndexOf("|||COUNT_SEP|||"); 

                if (sepIdx !== -1) {
                    var rawCount = newText.substring(sepIdx + 15); 
                    runCount = parseInt(rawCount, 10) || 0;
                    newText = newText.substring(0, sepIdx); 
                }

                clipboardData.clearData("Text", 0);
                sel.Text = newText;
                newText = null;

                // 📌 計算貼上後的行數差值
                var yAfterPaste = sel.GetActivePointY(eePosLogical);
                lineOffset += (yAfterPaste - yBeforePaste);

                // 檔案的最後一段，抓取結束座標供還原使用
                if (isLast) {
                    realBottomX = sel.GetActivePointX(eePosLogical);
                    realBottomY = sel.GetActivePointY(eePosLogical);
                } 

                if (!isNaN(runCount)) totalReplaced += runCount;
            } else {
                clipboardData.clearData("Text", 0);
                newText = null;
            }

            // 🟢 升檔 (Upshift)：如果路況良好（資料稀疏），嘗試將步伐翻倍恢復速度
            if (!skipLengthCheck && len > 0 && len < SAFE_CHAR_LIMIT / 2) {
                step = Math.min(linesPerChunk, step * 2);
            }

            if (typeof CollectGarbage === "function") CollectGarbage();

            // 推進到下一個動態區塊的起點
            currentOrigTopY = currentOrigBottomY + 1;
        }

// 4. 顯示完成訊息與計數
        var elapsedSeconds = ((Date.now() - startTime) / 1000).toFixed(2);
        var ignoreTW = (isAlt === "1" || isShift === "1");
        var suffixTC = "", suffixSC = "", suffixEN = "";
        if (!ignoreTW) {
            if (mode === "S2T" || mode === "S2TE") {
                suffixTC = "已套用台灣字形，"; suffixSC = "已套用台湾字形，"; suffixEN = "TW variants applied, ";
            } else if (mode === "T2S") {
                suffixTC = "台灣字形已反轉，"; suffixSC = "台湾字形已反转，"; suffixEN = "TW variants reversed, ";
            }
        }
        var logicTC = (isCtx === "1" && isShift === "0") ? "已套用語法邏輯，" : "";
        var logicSC = (isCtx === "1" && isShift === "0") ? "已套用语法逻辑，" : ""; 
        var logicEN = (isCtx === "1" && isShift === "0") ? "Context logic applied, " : "";

        var visionTC = (isVis === "1" && isShift === "0") ? "視界邏輯，" : "";
        var visionSC = (isVis === "1" && isShift === "0") ? "视界逻辑，" : "";
        var visionEN = (isVis === "1" && isShift === "0") ? "Vision logic applied, " : "";

        var jiebaTC = (typeof isJieba !== "undefined" && isJieba === "1") ? "結巴分詞，" : "";
        var jiebaSC = (typeof isJieba !== "undefined" && isJieba === "1") ? "结巴分词，" : "";
        var jiebaEN = (typeof isJieba !== "undefined" && isJieba === "1") ? "Jieba applied, " : "";

        if (totalReplaced === 0) {
            status = _L(
                "ℹ️ No text requiring changes was found, so no conversion was made (" + elapsedSeconds + " s).",
                "ℹ️ 內容未包含需要變更的文字，未執行 " + msgModeNameTC + " 轉換 (耗時 " + elapsedSeconds + " 秒)",
                "ℹ️ 内容未包含需要变更的文本，未运行 " + msgModeNameSC + " 轉換 (耗时 " + elapsedSeconds + " 秒)"
            );
        } else {
            status = "✅ BoostCVT " + _L(
                "Conversion completed (" + msgModeNameEN + ", " + suffixEN + jiebaEN + logicEN + visionEN + totalReplaced + " replacements in " + elapsedSeconds + "s, " + threadCount + " threads)",
                "轉換完成 (" + msgModeNameTC + "，" + suffixTC + jiebaTC + logicTC + visionTC + "共取代 " + totalReplaced + " 處，耗時 " + elapsedSeconds + " 秒，" + threadCount + " 執行緒)",
                "转换完成 (" + msgModeNameSC + "，" + suffixSC + jiebaSC + logicSC + visionSC + "共替换 " + totalReplaced + " 处，耗时 " + elapsedSeconds + " 秒，" + threadCount + " 线程)"
            );
        }

    } catch (e) {
        alert("Error: " + e.message + "\nNumber: " + (e.number & 0xFFFF));
    } finally {
        document.selection.SetAnchorPoint(eePosLogical, topX, topY);
        document.selection.SetActivePoint(eePosLogical, realBottomX, realBottomY, true);

        try { CombineHistory = originalCombine; } catch(e) {}
        try { Redraw = true; } catch(e) {}
        ShowTip("", 0);

        if (backupClip !== null) {
            clipboardData.setData("Text", backupClip);
        }
    }
}

main();